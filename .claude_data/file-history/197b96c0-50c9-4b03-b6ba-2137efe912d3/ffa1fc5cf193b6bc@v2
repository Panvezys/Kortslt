interface Props {
  sport?: string | null;
  surface?: string | null;
  surfaceSpeed?: string | null;
  surfaceBounce?: string | null;
}

const SURFACE_LABELS: Record<string, string> = {
  hard: "Kietas",
  clay: "Molis",
  grass: "Žolė",
  carpet: "Kilimas",
  artificial_grass: "Dirbtinė žolė",
  wood: "Medis",
  rubber: "Guma",
  concrete: "Betonas",
};

const SPEED_LABELS: Record<string, string> = {
  slow: "Lėtas",
  medium: "Vidutinis",
  fast: "Greitas",
};

const BOUNCE_LABELS: Record<string, string> = {
  low: "Žemas",
  medium: "Vidutinis",
  high: "Aukštas",
};

export function SurfaceSpecs({ sport, surface, surfaceSpeed, surfaceBounce }: Props) {
  const surfaceLabel = surface ? (SURFACE_LABELS[surface] ?? surface) : null;
  const isTennisPadel = sport === "tennis" || sport === "padel" || sport === "squash" || sport === "badminton";

  const specs: Array<{ label: string; value: string }> = [];
  if (surfaceLabel) specs.push({ label: "Danga", value: surfaceLabel });
  if (isTennisPadel && surfaceSpeed) specs.push({ label: "Greitis", value: SPEED_LABELS[surfaceSpeed] ?? surfaceSpeed });
  if (isTennisPadel && surfaceBounce) specs.push({ label: "Atšokimas", value: BOUNCE_LABELS[surfaceBounce] ?? surfaceBounce });

  if (specs.length === 0) return null;

  return (
    <div className="flex flex-wrap gap-2">
      {specs.map((s) => (
        <div
          key={s.label}
          className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border bg-muted/30 text-xs font-medium"
        >
          <span className="text-muted-foreground">{s.label}:</span>
          <span className="text-foreground font-semibold">{s.value}</span>
        </div>
      ))}
    </div>
  );
}
