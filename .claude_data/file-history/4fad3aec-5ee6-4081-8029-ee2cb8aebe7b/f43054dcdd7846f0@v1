/**
 * Replace-all sync of (sport, audiences[]) for a coach. Called from every
 * coach-upsert path so the junction table never drifts from coachesTable.sports.
 * The `sports` array on coachesTable is kept as a denormalized cache; this
 * helper rebuilds it from sportsAudiences when supplied.
 */
async function syncCoachSports(
  coachId: number,
  entries: Array<{ sport: string; audiences: string[] }>,
): Promise<void> {
  await db.transaction(async (tx) => {
    await tx.delete(coachSportsTable).where(eq(coachSportsTable.coachId, coachId));
    if (entries.length > 0) {
      await tx.insert(coachSportsTable).values(
        entries.map((e) => ({ coachId, sport: e.sport, audiences: e.audiences })),
      );
    }
  });
}

/**
 * Load the (sport, audiences) rows for a batch of coaches and return them
 * grouped by coachId. Used by formatters and the marketplace endpoint.
 */
async function loadSportsAudiences(
  coachIds: number[],
): Promise<Map<number, Array<{ sport: string; audiences: string[] }>>> {
  const map = new Map<number, Array<{ sport: string; audiences: string[] }>>();
  if (coachIds.length === 0) return map;
  const rows = await db
    .select({
      coachId: coachSportsTable.coachId,
      sport: coachSportsTable.sport,
      audiences: coachSportsTable.audiences,
    })
    .from(coachSportsTable)
    .where(inArray(coachSportsTable.coachId, coachIds));
  for (const r of rows) {
    if (!map.has(r.coachId)) map.set(r.coachId, []);
    map.get(r.coachId)!.push({ sport: r.sport, audiences: r.audiences });
  }
  return map;
}

