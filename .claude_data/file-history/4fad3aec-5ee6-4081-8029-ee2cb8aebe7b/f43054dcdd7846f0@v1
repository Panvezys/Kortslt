    .orderBy(coachPhotosTable.displayOrder, coachPhotosTable.id);
  res.json(photos);
});

// POST /coaches — create coach profile (coach role required, one per user)
router.post("/coaches", requireAuth, async (req, res): Promise<void> => {
  const userId = getCurrentUserId(req)!;

  const callerRole = await getUserRole(userId);
  if (callerRole !== "coach" && callerRole !== "admin") {
    res.status(403).json({ error: "Forbidden – coach role required" });
    return;
  }

  const parsed = CoachUpsertBody.safeParse(req.body);
  if (!parsed.success) {
    res.status(400).json({ error: "Invalid body", details: parsed.error.flatten() });
    return;
  }
  const {
    name, email, bio, photoUrl, videoUrl, sports, sportsAudiences,
    availabilityDescription, phone, isAcceptingStudents, experienceYears,
    qualifications,
    travelPolicy, courtPaymentModel, cancellationPolicy,
  } = parsed.data;

  const [existing] = await db.select().from(coachesTable).where(eq(coachesTable.userId, userId));
  if (existing) {
    res.status(409).json({ error: "Coach profile already exists for this user. Use PUT to update." });
    return;
  }

  // When sportsAudiences is supplied, derive the denormalized sports array
  // from it so the two columns stay aligned. Falls back to the explicit
  // sports list otherwise (back-compat).
  const finalSports = sportsAudiences
    ? sportsAudiences.map((e) => e.sport)
    : (sports ?? []);

  const [coach] = await db.insert(coachesTable).values({
    userId,
    name,
    email,
    bio: bio ?? null,
    photoUrl: photoUrl ?? null,
    videoUrl: videoUrl ?? null,
    // pricePerHour is recomputed by syncCoachStartingPrice the moment the
    // coach adds their first service. New coaches start at NULL → unbookable
    // (payments.ts gates on pricePerHour > 0), which is the correct posture.
    sports: finalSports,
    availabilityDescription: availabilityDescription ?? null,
    phone: phone ?? null,
    ...(isAcceptingStudents !== undefined && { isAcceptingStudents }),
    experienceYears: experienceYears ?? null,
    ...(qualifications !== undefined && { qualifications }),
    ...(travelPolicy !== undefined && { travelPolicy }),
