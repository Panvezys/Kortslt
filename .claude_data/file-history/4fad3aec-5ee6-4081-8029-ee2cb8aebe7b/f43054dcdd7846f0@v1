const router: IRouter = Router();

function formatCoach(c: typeof coachesTable.$inferSelect) {
  return {
    ...c,
    // pricePerHour is integer cents — clients divide by 100 for display.
    bio: c.bio ?? undefined,
    photoUrl: c.photoUrl ?? undefined,
    videoUrl: c.videoUrl ?? undefined,
    availabilityDescription: c.availabilityDescription ?? undefined,
    phone: c.phone ?? undefined,
    experienceYears: c.experienceYears ?? undefined,
    qualifications: c.qualifications ?? [],
    travelPolicy: c.travelPolicy,
    courtPaymentModel: c.courtPaymentModel,
    cancellationPolicy: c.cancellationPolicy,
    createdAt: c.createdAt.toISOString(),
  };
}

function formatPublicCoach(c: typeof coachesTable.$inferSelect) {
  const isPromoted = c.promotedUntil != null && c.promotedUntil.getTime() > Date.now();
  return {
    id: c.id,
    userId: c.userId,
    name: c.name,
    bio: c.bio ?? undefined,
    photoUrl: c.photoUrl ?? undefined,
    videoUrl: c.videoUrl ?? undefined,
    pricePerHour: c.pricePerHour ?? undefined,
    sports: c.sports,
    availabilityDescription: c.availabilityDescription ?? undefined,
    isAcceptingStudents: c.isAcceptingStudents,
    experienceYears: c.experienceYears ?? undefined,
    qualifications: c.qualifications ?? [],
    travelPolicy: c.travelPolicy,
    courtPaymentModel: c.courtPaymentModel,
    cancellationPolicy: c.cancellationPolicy,
    // Denormalized review aggregates — kept in sync by syncCoachAverageRating
    // on every coach_reviews insert/update/delete. `null` means "no reviews
    // yet" (UI renders a "Naujas" badge); otherwise a 1.00–5.00 numeric.
    averageRating: c.averageRating != null ? Number(c.averageRating) : null,
    reviewCount: c.reviewCount,
    isPromoted,
    createdAt: c.createdAt.toISOString(),
  };
}

// GET /coaches — marketplace list with optional filters.
//
// Query params (all optional):
//   courtId                — restrict to coaches affiliated with this court
//   sport                  — filter by primary sport (joined via coach_sports)
//   audiences              — comma-separated subset of kids|beginners|advanced|pros
//                            (matches any coach who teaches at least one)
//   travelPolicies         — comma-separated subset of any_court|affiliated_only
//   cancellationPolicies   — comma-separated subset of flexible|standard|strict
//   minPrice / maxPrice    — integer cents
//   city                   — match coaches with at least one approved court in city
//   date + startTime + endTime — require continuous availability across that window
//                                (Europe/Vilnius). All three must be supplied together.
//
// Always returns approved + accepting coaches. Each coach is enriched with
// `cities: string[]` from approved court affiliations and `sportsAudiences`
// from the junction table.
router.get("/coaches", async (req, res): Promise<void> => {
  const q = req.query;
  const courtId = q.courtId ? parseInt(q.courtId as string, 10) : null;
  const sportFilter = typeof q.sport === "string" && q.sport.trim() ? q.sport.trim() : null;
  const audiencesFilter = typeof q.audiences === "string" && q.audiences.trim()
    ? q.audiences.split(",").map((s) => s.trim()).filter(Boolean)
    : null;
  const travelFilter = typeof q.travelPolicies === "string" && q.travelPolicies.trim()
    ? q.travelPolicies.split(",").map((s) => s.trim()).filter(Boolean)
    : null;
  const cancelFilter = typeof q.cancellationPolicies === "string" && q.cancellationPolicies.trim()
    ? q.cancellationPolicies.split(",").map((s) => s.trim()).filter(Boolean)
    : null;
  const minPrice = q.minPrice ? Number(q.minPrice) : null;
  const maxPrice = q.maxPrice ? Number(q.maxPrice) : null;
  const cityFilter = typeof q.city === "string" && q.city.trim() ? q.city.trim() : null;
  const dateFilter = typeof q.date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(q.date) ? q.date : null;
  const startTime = typeof q.startTime === "string" && /^\d{2}:\d{2}$/.test(q.startTime) ? q.startTime : null;
  const endTime = typeof q.endTime === "string" && /^\d{2}:\d{2}$/.test(q.endTime) ? q.endTime : null;
  const hasAvailabilityWindow = !!(dateFilter && startTime && endTime);

  // Build base SQL filters on coachesTable.
  // The marketplace shield: every public listing requires the coach's
  // user_profile.stripeAccountStatus = 'active' so unbookable coaches never
  // surface to players. The join is enforced as INNER below; if Stripe flips
  // a coach back to pending/disabled, they disappear immediately on next read.
  const baseConditions = [
    eq(coachesTable.status, "approved"),
    eq(userProfilesTable.stripeAccountStatus, "active"),
  ];
  if (Number.isFinite(minPrice) && minPrice !== null) {
    baseConditions.push(sql`${coachesTable.pricePerHour} >= ${minPrice}`);
  }
  if (Number.isFinite(maxPrice) && maxPrice !== null) {
    baseConditions.push(sql`${coachesTable.pricePerHour} <= ${maxPrice}`);
  }
  if (travelFilter && travelFilter.length > 0) {
    baseConditions.push(inArray(coachesTable.travelPolicy, travelFilter));
  }
  if (cancelFilter && cancelFilter.length > 0) {
    baseConditions.push(inArray(coachesTable.cancellationPolicy, cancelFilter));
  }

  let coaches: Array<typeof coachesTable.$inferSelect>;
  if (courtId !== null && !isNaN(courtId)) {
    const rows = await db
      .select({ coach: coachesTable })
      .from(courtCoachesTable)
      .innerJoin(coachesTable, eq(courtCoachesTable.coachId, coachesTable.id))
      .innerJoin(userProfilesTable, eq(userProfilesTable.userId, coachesTable.userId))
      .where(and(eq(courtCoachesTable.courtId, courtId), ...baseConditions));
    coaches = rows.map((r) => r.coach);
  } else {
    const rows = await db
      .select({ coach: coachesTable })
      .from(coachesTable)
      .innerJoin(userProfilesTable, eq(userProfilesTable.userId, coachesTable.userId))
      .where(and(...baseConditions))
      .orderBy(coachesTable.createdAt);
    coaches = rows.map((r) => r.coach);
  }

  if (coaches.length === 0) { res.json([]); return; }

  // City + audience filtering needs a junction-table join. Load both in one
  // pass for the candidate set; we already have the row identities.
  const ids = coaches.map((c) => c.id);
  const [affiliationRows, sportsRows] = await Promise.all([
    db.select({
      coachId: courtCoachesTable.coachId,
      facilityId: facilitiesTable.id,
      facilityName: facilitiesTable.name,
      facilityCity: facilitiesTable.city,
      facilityLat: facilitiesTable.latitude,
      facilityLng: facilitiesTable.longitude,
      courtSport: courtsTable.type,
    })
      .from(courtCoachesTable)
      .innerJoin(courtsTable, eq(courtCoachesTable.courtId, courtsTable.id))
      .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
      .where(inArray(courtCoachesTable.coachId, ids)),
    db.select({
      coachId: coachSportsTable.coachId,
      sport: coachSportsTable.sport,
      audiences: coachSportsTable.audiences,
    })
      .from(coachSportsTable)
      .where(inArray(coachSportsTable.coachId, ids)),
  ]);

  const citiesByCoach = new Map<number, Set<string>>();
  // facilityAffiliations: one entry per (coach, facility). Multiple courts of
  // the same facility collapse into a single marker; their sports are merged.
  // Used by the marketplace map view; the list view ignores it.
  type FacilityAffiliation = {
    facilityId: number;
    facilityName: string;
    city: string | null;
    latitude: number;
    longitude: number;
    sports: string[];
  };
  const affiliationsByCoach = new Map<number, Map<number, FacilityAffiliation>>();
  for (const r of affiliationRows) {
    if (r.facilityCity) {
      if (!citiesByCoach.has(r.coachId)) citiesByCoach.set(r.coachId, new Set());
      citiesByCoach.get(r.coachId)!.add(r.facilityCity);
    }
    if (
      r.facilityId == null ||
      r.facilityLat == null ||
      r.facilityLng == null ||
      r.facilityName == null
    ) {
      continue;
    }
    let perCoach = affiliationsByCoach.get(r.coachId);
    if (!perCoach) {
      perCoach = new Map();
      affiliationsByCoach.set(r.coachId, perCoach);
    }
    const existing = perCoach.get(r.facilityId);
    if (existing) {
      if (r.courtSport && !existing.sports.includes(r.courtSport)) {
        existing.sports.push(r.courtSport);
      }
    } else {
      perCoach.set(r.facilityId, {
        facilityId: r.facilityId,
        facilityName: r.facilityName,
        city: r.facilityCity ?? null,
        latitude: r.facilityLat,
        longitude: r.facilityLng,
        sports: r.courtSport ? [r.courtSport] : [],
      });
    }
  }

  const sportsByCoach = new Map<number, Array<{ sport: string; audiences: string[] }>>();
  for (const r of sportsRows) {
    if (!sportsByCoach.has(r.coachId)) sportsByCoach.set(r.coachId, []);
    sportsByCoach.get(r.coachId)!.push({ sport: r.sport, audiences: r.audiences });
  }

  // Post-filter by sport, audiences, city. Done in app code so we can use the
  // already-loaded junction-table data; for tiny N (<100s of coaches) the cost
  // is negligible vs. building dynamic SQL with array overlap operators.
  let filtered = coaches.filter((c) => {
    const entries = sportsByCoach.get(c.id) ?? [];
    if (sportFilter) {
      const sportEntry = entries.find((e) => e.sport === sportFilter);
      if (!sportEntry) return false;
      if (audiencesFilter && audiencesFilter.length > 0) {
        const hit = audiencesFilter.some((a) => sportEntry.audiences.includes(a));
        if (!hit) return false;
      }
    } else if (audiencesFilter && audiencesFilter.length > 0) {
      // Without a sport filter, match if ANY sport the coach teaches has at
      // least one of the requested audiences.
      const anyHit = entries.some((e) => audiencesFilter.some((a) => e.audiences.includes(a)));
      if (!anyHit) return false;
    }
    if (cityFilter) {
      const cities = citiesByCoach.get(c.id);
      if (!cities || !cities.has(cityFilter)) return false;
    }
    return true;
  });

  // Availability filter: continuous coverage across the requested window.
  // Computed last so we only run per-coach queries on the post-filtered set.
  if (hasAvailabilityWindow) {
    const startUtc = vilniusToUtc(dateFilter, startTime!).getTime();
    const endUtc = vilniusToUtc(dateFilter, endTime!).getTime();
    const STEP_MS = 30 * 60_000;
    if (endUtc > startUtc && (endUtc - startUtc) % STEP_MS === 0) {
      const availability = await Promise.all(filtered.map(async (c) => {
        const slots = await getCoachAvailability(c.id, dateFilter);
        const startSet = new Set(slots.map((s) => new Date(s.start).getTime()));
        for (let t = startUtc; t < endUtc; t += STEP_MS) {
          if (!startSet.has(t)) return { coach: c, available: false };
        }
        return { coach: c, available: true };
      }));
      filtered = availability.filter((a) => a.available).map((a) => a.coach);
    }
  }

  // Stable sort: paid-promoted coaches float to the top, then the existing
  // default order (by review rating, with createdAt as a tiebreaker).
  const now = Date.now();
  const isCoachPromoted = (c: typeof coachesTable.$inferSelect): boolean =>
    c.promotedUntil != null && c.promotedUntil.getTime() > now;
  const ratingOf = (c: typeof coachesTable.$inferSelect): number =>
    c.averageRating != null ? Number(c.averageRating) : -1;
  filtered.sort((a, b) => {
    const pa = isCoachPromoted(a) ? 1 : 0;
    const pb = isCoachPromoted(b) ? 1 : 0;
    if (pa !== pb) return pb - pa;
    const ra = ratingOf(a);
    const rb = ratingOf(b);
    if (ra !== rb) return rb - ra;
    return a.createdAt.getTime() - b.createdAt.getTime();
  });

  res.json(filtered.map((c) => ({
    ...formatPublicCoach(c),
    cities: Array.from(citiesByCoach.get(c.id) ?? []),
    sportsAudiences: sportsByCoach.get(c.id) ?? [],
    facilityAffiliations: Array.from(affiliationsByCoach.get(c.id)?.values() ?? []),
  })));
});

// GET /coaches/me — get own coach profile
router.get("/coaches/me", requireAuth, async (req, res): Promise<void> => {
  const userId = (await resolveCoachUserId(req))!;
  const [coach] = await db.select().from(coachesTable).where(eq(coachesTable.userId, userId));
  if (!coach) {
    res.status(404).json({ error: "No coach profile found" });
    return;
  }
  const sa = await loadSportsAudiences([coach.id]);
  res.json({ ...formatCoach(coach), sportsAudiences: sa.get(coach.id) ?? [] });
});

// GET /coaches/by-user/:userId — minimal lookup to map a Clerk user id (as
// stored on bookings.coachId) to the coach's numeric profile id. Used by the
// post-checkout success page to link back to /coach/:id after a coach booking.
router.get("/coaches/by-user/:userId", async (req, res): Promise<void> => {
  const userId = String(req.params.userId ?? "");
  if (!userId) { res.status(400).json({ error: "Invalid userId" }); return; }
  const [coach] = await db
    .select({ id: coachesTable.id, name: coachesTable.name })
    .from(coachesTable)
    .where(and(eq(coachesTable.userId, userId), eq(coachesTable.status, "approved")));
  if (!coach) { res.status(404).json({ error: "Coach not found" }); return; }
  res.json(coach);
});

// GET /coaches/:id — get approved coach by id.
//
// Unlike the list endpoint, single-coach detail still renders for non-active
// Stripe coaches (so the coach themselves can preview their profile). Booking
// is gated client-side via `isBookable`, which is the same active-Stripe check
// the list query enforces with an INNER JOIN.
router.get("/coaches/:id", async (req, res): Promise<void> => {
  const id = parseInt(String(req.params.id), 10);
  if (isNaN(id)) { res.status(400).json({ error: "Invalid id" }); return; }
  const [row] = await db
    .select({
      coach: coachesTable,
      stripeAccountStatus: userProfilesTable.stripeAccountStatus,
    })
    .from(coachesTable)
    .leftJoin(userProfilesTable, eq(userProfilesTable.userId, coachesTable.userId))
    .where(and(eq(coachesTable.id, id), eq(coachesTable.status, "approved")));
  if (!row) { res.status(404).json({ error: "Coach not found" }); return; }
  const sa = await loadSportsAudiences([row.coach.id]);
  const isBookable = row.stripeAccountStatus === "active";
  res.json({
    ...formatPublicCoach(row.coach),
    sportsAudiences: sa.get(row.coach.id) ?? [],
    isBookable,
  });
});

// GET /coaches/:id/facilities — public list of facilities/courts a coach is approved at.
// Only publicly-visible courts (status approved/active) and verified facilities are returned.
router.get("/coaches/:id/facilities", async (req, res, next): Promise<void> => {
  // Fall through when the path collides with /coaches/me/facilities — that
  // literal route is declared later in this file and is the one we want for
  // the signed-in coach's own affiliations. Returning 400 here would break
  // the Settings → Bendra "Aikštelės partnerystės" panel.
  if (req.params.id === "me") { next(); return; }
  const id = parseInt(String(req.params.id), 10);
  if (isNaN(id)) { res.status(400).json({ error: "Invalid id" }); return; }
  const [coach] = await db.select().from(coachesTable)
    .where(and(eq(coachesTable.id, id), eq(coachesTable.status, "approved")));
  if (!coach) { res.json([]); return; }

  const rows = await db
    .select({ court: courtsTable, facility: facilitiesTable })
    .from(courtCoachesTable)
    .innerJoin(courtsTable, eq(courtCoachesTable.courtId, courtsTable.id))
    .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .where(and(
      eq(courtCoachesTable.coachId, id),
      inArray(courtsTable.status, ["approved", "active"]),
      // If court is in a facility, that facility must be verified.
      // Standalone courts (no facility) pass this check via the OR.
      or(
        isNull(courtsTable.facilityId),
        eq(facilitiesTable.verificationStatus, "active"),
      )!,
    ));

  type Group = {
    facilityId: number | null;
    facilityName: string | null;
    city: string | null;
    address: string | null;
    courts: Array<{ id: number; name: string }>;
  };
  const groups = new Map<string, Group>();
  for (const r of rows) {
    const key = r.facility?.id != null ? `f${r.facility.id}` : `c${r.court.id}`;
    if (!groups.has(key)) {
      groups.set(key, {
        facilityId: r.facility?.id ?? null,
        facilityName: r.facility?.name ?? r.court.name,
        city: r.facility?.city ?? null,
        address: r.facility?.address ?? null,
        courts: [],
      });
    }
    groups.get(key)!.courts.push({ id: r.court.id, name: r.court.name });
  }
  res.json(Array.from(groups.values()));
});

// GET /coaches/:id/gallery — public gallery photos for a coach
router.get("/coaches/:id/gallery", async (req, res): Promise<void> => {
  if (req.params.id === "me") { res.json([]); return; }
  const id = parseInt(String(req.params.id), 10);
  if (isNaN(id)) { res.status(400).json({ error: "Invalid id" }); return; }
  const photos = await db
    .select({ id: coachPhotosTable.id, url: coachPhotosTable.url, caption: coachPhotosTable.caption, displayOrder: coachPhotosTable.displayOrder })
    .from(coachPhotosTable)
