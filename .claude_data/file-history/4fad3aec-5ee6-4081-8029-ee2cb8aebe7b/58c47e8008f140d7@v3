const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const API = `${BASE}/api`;

const SPORT_OPTIONS = ["tennis", "basketball", "padel", "football", "badminton", "squash", "table_tennis", "golf", "snooker", "bowling"];
interface Coach {
  id: number;
  userId: string;
  name: string;
  email: string;
  bio?: string;
  photoUrl?: string;
  videoUrl?: string;
  pricePerHour?: number;
  sports: string[];
  availabilityDescription?: string;
  phone?: string;
  experienceYears?: number;
  qualifications?: string[];
  sportsAudiences?: Array<{ sport: string; audiences: string[] }>;
  // Server-computed Stripe-readiness flag. False when the coach's
  // user_profile.stripeAccountStatus is not 'active'; UI must disable booking
  // CTAs and surface a "payments unavailable" affordance.
  isBookable?: boolean;
  // Denormalized review aggregate. averageRating is null when no reviews yet
  // (renders "Naujas" badge); otherwise a 1.00–5.00 numeric.
  averageRating?: number | null;
  reviewCount?: number;
}

interface ReviewItem {
  id: number;
  rating: number;
  comment: string | null;
  reviewerName: string;
  coachReplyText: string | null;
  coachReplyCreatedAt: string | null;
  createdAt: string;
}

interface ReviewsResponse {
  coachId: number;
  averageRating: number | null;
  reviewCount: number;
  items: ReviewItem[];
  limit: number;
  offset: number;
  hasMore: boolean;
}

async function fetchCoach(id: string): Promise<Coach> {
  const r = await fetch(`${API}/coaches/${id}`);
  if (!r.ok) throw new Error("Coach not found");
  return r.json();
}

async function fetchMyCoach(asCoachId?: number | null): Promise<Coach | null> {
  const url = asCoachId != null ? `${API}/coaches/me?asCoach=${asCoachId}` : `${API}/coaches/me`;
  const r = await fetch(url, { credentials: "include" });
  if (r.status === 404) return null;
  if (!r.ok) throw new Error("Failed to fetch coach profile");
  return r.json();
}

interface CoachService {
  id: number;
  coachId: number;
  name: string;
  description: string | null;
  sport: string;
  courtId: number | null;
  isLocationProvidedByCoach: boolean;
  durationMin: number;
  priceCents: number;
  maxParticipants: number;
  audienceLevel: string | null;
  isActive: boolean;
  sortOrder: number;
}

const AUDIENCE_LT: Record<string, string> = {
  kids: "Vaikai",
  beginners: "Pradedantieji",
  advanced: "Pažengę",
  pros: "Profesionalai",
};

function formatDuration(min: number): string {
  if (min < 60) return `${min} min`;
  const hours = min / 60;
  if (Number.isInteger(hours)) return `${hours} val.`;
  // 1.5 → "1,5 val." in Lithuanian locale convention
  return `${hours.toString().replace(".", ",")} val.`;
}

// Format a Date as YYYY-MM-DD in local Europe/Vilnius time. We can't use
// toISOString() — that returns UTC, which is off by the local TZ offset.
function formatLocalYmd(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${dd}`;
}

interface CoachFacilityGroup {
  facilityId: number | null;
  facilityName: string | null;
  city: string | null;
  address: string | null;
  courts: Array<{ id: number; name: string }>;
}

interface CoachApplication {
  invitationId: number;
  courtId: number;
  courtName: string;
  facilityId: number | null;
  facilityName: string | null;
  status: string;
  initiatedBy: string;
  message: string | null;
  createdAt: string;
}

interface FacilityOption {
  id: number;
  name: string;
  city?: string | null;
  address?: string | null;
}

export default function CoachPage() {
  const { id } = useParams<{ id?: string }>();
  const { user, isSignedIn } = useUser();
  const { openSignIn } = useClerk();

  const [, setLocation] = useLocation();
  const { toast } = useToast();
  const { isAdmin } = useRole();
  const qc = useQueryClient();

  const isOwnProfileRoute = !id || id === "me";
  const { asCoachId, asCoachName, enter: enterViewAs, exit: exitViewAs } = useViewAsCoach();

  const { data: coach, isLoading } = useQuery<Coach | null>({
    queryKey: isOwnProfileRoute ? ["coach", "me", asCoachId] : ["coach", id],
    queryFn: isOwnProfileRoute ? () => fetchMyCoach(asCoachId) : () => fetchCoach(id!),
    enabled: isOwnProfileRoute ? !!isSignedIn : true,
    retry: false,
  });

  const isOwn = isOwnProfileRoute || (coach?.userId && user?.id === coach.userId);
  const coachId = coach?.id;

  // Public facilities the coach is approved at — visible on every profile view
  const facilitiesQ = useQuery<CoachFacilityGroup[]>({
    queryKey: ["coach-facilities", coachId],
    queryFn: () => fetch(`${API}/coaches/${coachId}/facilities`).then(r => r.json()),
    enabled: !!coachId,
  });

  // Coach services (lesson types) — visible on every profile view. Non-owners
  // get only active services from the API; owners get the full list.
  const servicesQ = useQuery<CoachService[]>({
    queryKey: ["coach-services", coachId],
    queryFn: () => fetch(`${API}/coaches/${coachId}/services`, { credentials: "include" }).then(r => r.ok ? r.json() : []),
    enabled: !!coachId,
  });

  // Public review feed, paginated. "Rodyti daugiau" appends the next page via
  // useInfiniteQuery; each page request returns hasMore so the button hides
  // when the last page lands.
  const REVIEWS_PAGE_SIZE = 10;
  const reviewsQ = useInfiniteQuery({
    queryKey: ["coach-reviews", coachId],
    initialPageParam: 1 as number,
    queryFn: async ({ pageParam }): Promise<ReviewsResponse> => {
      const r = await fetch(`${API}/coaches/${coachId}/reviews?page=${pageParam}&limit=${REVIEWS_PAGE_SIZE}`);
      if (!r.ok) {
        return {
          coachId: Number(coachId),
          averageRating: null,
          reviewCount: 0,
          items: [],
          limit: REVIEWS_PAGE_SIZE,
          offset: 0,
          hasMore: false,
        };
      }
      return r.json() as Promise<ReviewsResponse>;
    },
    getNextPageParam: (last, all) => (last.hasMore ? all.length + 1 : undefined),
    enabled: !!coachId,
  });
  const reviewPages: ReviewsResponse[] = reviewsQ.data?.pages ?? [];
  const reviewItems: ReviewItem[] = reviewPages.flatMap((p) => p.items);
  const reviewMeta: ReviewsResponse | null = reviewPages[0] ?? null;

  // Gallery photos
  type GalleryPhoto = { id: number; url: string; caption: string | null; displayOrder: number };
  const galleryQ = useQuery<GalleryPhoto[]>({
    queryKey: ["coach-gallery", coachId],
    queryFn: () => fetch(`${API}/coaches/${coachId}/gallery`).then(r => r.json()),
    enabled: !!coachId,
  });
  const [lightboxIdx, setLightboxIdx] = useState<number | null>(null);

  // Flatten the coach's approved court ids → friendly labels. Used by the
  // student-facing booking dialog for the court selector. Pulls from
  // facilitiesQ (same source the public "Treniruoja čia" panel uses).
  const approvedCourtOptions = useMemo(() => {
    const out: Array<{ id: number; label: string }> = [];
    for (const f of facilitiesQ.data ?? []) {
      for (const c of f.courts) {
        const facilityBit = f.facilityName ? ` · ${f.facilityName}` : "";
        out.push({ id: c.id, label: `${c.name}${facilityBit}` });
      }
    }
    return out;
  }, [facilitiesQ.data]);

  // ─── Booking dialog (student-facing) ─────────────────────────────────────
  // Opens when a non-owner clicks "Užsakyti" on a service card. The dialog
  // collects (courtId, date, startTime), polls /coach-bookings/quote for a
  // server-priced breakdown, then on submit calls POST /coach-bookings →
  // POST /payments/create-checkout and redirects to Stripe.
  const [bookingService, setBookingService] = useState<CoachService | null>(null);
  const [bookingCourtId, setBookingCourtId] = useState<number | null>(null);
  const [bookingDate, setBookingDate] = useState<Date | null>(null);
  const [bookingStartTime, setBookingStartTime] = useState<string | null>(null);
  const [isProcessingCheckout, setIsProcessingCheckout] = useState(false);
  const [showDatePicker, setShowDatePicker] = useState(false);

  // Reset selection whenever the dialog closes OR the user picks a different
  // service (so reopening always starts clean).
  function openBookingDialog(svc: CoachService) {
    setBookingService(svc);
    // Independent services need no court — pre-set null and skip the picker.
    setBookingCourtId(svc.isLocationProvidedByCoach ? null : (svc.courtId ?? null));
    setBookingDate(null);
    setBookingStartTime(null);
    setShowDatePicker(false);
  }
  function closeBookingDialog() {
    if (isProcessingCheckout) return;
    setBookingService(null);
    setBookingCourtId(null);
    setBookingDate(null);
    setBookingStartTime(null);
    setShowDatePicker(false);
  }

  // Available start-time pills for the picked date. Re-fetches when the
  // student picks a new date. The endpoint does NOT take courtId — for
  // floating services it only checks coach availability, so a slot can
  // still 409 on POST if the chosen court is double-booked. We rely on the
  // server's final overlap check (resolveCoachBookingWindow) to catch that.
  const bookingDateYmd = bookingDate ? formatLocalYmd(bookingDate) : null;
  const slotsQ = useQuery<{ slots: Array<{ start: string; end: string; label: string }> }>({
    queryKey: ["coach-service-slots", coachId, bookingService?.id, bookingDateYmd],
    queryFn: async () => {
      if (!coachId || !bookingService || !bookingDateYmd) {
        return { slots: [] };
      }
      const r = await fetch(
        `${API}/coaches/${coachId}/services/${bookingService.id}/slots?date=${bookingDateYmd}`,
      );
      if (!r.ok) return { slots: [] };
      return r.json();
    },
    enabled: !!coachId && !!bookingService && !!bookingDateYmd,
  });

  // Live quote — fetched only when all three inputs are settled. A failed
  // quote (409 etc.) is surfaced as a banner instead of preventing display
  // of the other steps, so the user can adjust.
  const quoteEnabled =
    !!bookingService &&
    !!bookingDateYmd &&
    !!bookingStartTime &&
    (bookingService.isLocationProvidedByCoach || !!bookingCourtId);
  const quoteQ = useQuery<{
    courtId: number | null;
    startTime: string;
    endTime: string;
    durationMin: number;
    courtCents: number;
    serviceCents: number;
    totalCents: number;
  }>({
    queryKey: [
      "coach-booking-quote",
      bookingService?.id,
      bookingCourtId,
      bookingDateYmd,
      bookingStartTime,
    ],
    queryFn: async () => {
      const qs = new URLSearchParams({
        coachServiceId: String(bookingService!.id),
        date: bookingDateYmd!,
        startTime: bookingStartTime!,
      });
      if (bookingService!.courtId == null && bookingCourtId != null) {
        qs.set("courtId", String(bookingCourtId));
      }
      return await customFetch<{
        courtId: number;
        startTime: string;
        endTime: string;
        durationMin: number;
        courtCents: number;
        serviceCents: number;
        totalCents: number;
      }>(`${API}/coach-bookings/quote?${qs.toString()}`);
    },
    enabled: quoteEnabled,
    retry: false,
  });

  // Court label lookup — used both in the RadioGroup and the summary line.
  // Falls back to the raw id if (somehow) the picked court isn't in the
  // coach's approved list anymore.
  function labelForCourt(id: number): string {
    return approvedCourtOptions.find(c => c.id === id)?.label ?? `Aikštelė #${id}`;
  }

  async function submitCoachBooking() {
    if (!bookingService || !bookingDateYmd || !bookingStartTime) return;
    if (!bookingService.isLocationProvidedByCoach && !bookingCourtId) return;
    if (!isSignedIn) {
      openSignIn();
      return;
    }
    setIsProcessingCheckout(true);
    try {
      // Step 1 — create the pending booking row.
      const payload: Record<string, unknown> = {
        coachServiceId: bookingService.id,
        date: bookingDateYmd,
        startTime: bookingStartTime,
      };
      // Only include courtId for non-independent services; the server ignores
      // it for court-bound services but requires it for floating ones.
      if (bookingCourtId != null) payload.courtId = bookingCourtId;
      const created = await customFetch<{ bookingId: number }>(`${API}/coach-bookings`, {
        method: "POST",
        body: JSON.stringify(payload),
      });

      // Step 2 — kick off Stripe checkout with the same bookingId. The
      // server reads the prices it already snapshotted onto the booking
      // (Invariant B) so we don't need to re-send anything here.
      const origin = window.location.origin + BASE;
      const successUrl = `${origin}/booking-confirmed`;
      const cancelUrl = `${origin}/coach/${coach?.id ?? id ?? ""}`;
      const checkout = await customFetch<{ url: string }>(`${API}/payments/create-checkout`, {
        method: "POST",
        body: JSON.stringify({
          bookingId: created.bookingId,
          successUrl,
          cancelUrl,
        }),
      });
      window.location.href = checkout.url;
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Nepavyko užbaigti užsakymo";
      toast({ title: "Klaida", description: msg, variant: "destructive" });
      setIsProcessingCheckout(false);
    }
  }

  if (isOwnProfileRoute && !isSignedIn) {
    return (
      <Layout>
        <div className="container mx-auto px-4 py-20 text-center text-muted-foreground">
          Prisijunkite, kad matytumėte trenerio profilį.
        </div>
      </Layout>
    );
  }

  if (isLoading) {
    return (
      <Layout>
        <div className="container mx-auto px-4 py-12 max-w-2xl space-y-6">
          <Skeleton className="h-40 w-full rounded-2xl" />
          <Skeleton className="h-60 w-full rounded-2xl" />
        </div>
      </Layout>
    );
  }

  if (!coach && !isOwnProfileRoute) {
    return (
      <Layout>
        <div className="container mx-auto px-4 py-20 text-center">
          <h1 className="text-2xl font-bold mb-3">Treneris nerastas</h1>
          <Link href="/coaches">
            <Button variant="outline" className="mt-4">Grįžti į sąrašą</Button>
          </Link>
        </div>
      </Layout>
    );
  }

  // /coach/me is now a pure read-only storefront preview. All editing lives
  // under the coach dashboard (/coach/dashboard and its sidebar tabs).
  const displayCoach = coach;

  return (
    <Layout>
      {isOwnProfileRoute && asCoachName && (
        <div
          role="status"
          className="flex items-center gap-3 px-4 py-2 bg-amber-100 dark:bg-amber-900/40 border-b border-amber-300 dark:border-amber-700 text-amber-900 dark:text-amber-100"
        >
          <span className="text-sm flex-1 min-w-0 truncate">
            Žiūrite kaip treneris: <strong>{asCoachName}</strong> · tik skaitymo režimas
          </span>
          <button
            type="button"
            onClick={exitViewAs}
            className="text-xs font-semibold underline hover:no-underline shrink-0"
          >
            Išeiti
          </button>
        </div>
      )}
      {isOwn && !asCoachName && (
        <div
          role="status"
          className="sticky top-16 z-30 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 px-4 py-3 bg-primary/10 border-b border-primary/30 text-foreground"
        >
          <span className="text-sm flex-1 min-w-0">
            <strong>Tai yra jūsų viešas profilis.</strong>{" "}
            <span className="text-muted-foreground">Visas valdymas perkeltas į Trenerio skydelį.</span>
          </span>
          <Button
            size="sm"
            onClick={() => setLocation("/coach/dashboard")}
            className="shrink-0 self-start sm:self-auto"
          >
            <LayoutDashboard className="w-4 h-4 mr-1.5" />
            Eiti į skydelį
          </Button>
        </div>
      )}
      <div className="container mx-auto px-4 py-12 max-w-2xl space-y-6">

        {/* Back link */}
        <BackButton to="/coaches" label="Visi treneriai" />

        {/* Header card */}
        <div className="bg-card border rounded-2xl p-6 shadow-sm">
          <div className="flex items-start justify-between gap-4">
            <div className="flex items-center gap-4">
              {displayCoach?.photoUrl ? (
                <img
                  src={displayCoach.photoUrl}
                  alt={displayCoach.name}
                  className="w-20 h-20 rounded-full object-cover border-2 border-primary/20 shrink-0"
                />
              ) : (
                <div className="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                  <User className="w-10 h-10 text-primary/60" />
                </div>
              )}
              <div>
                <h1 className="text-2xl font-bold">{displayCoach?.name ?? (isOwnProfileRoute ? "Trenerio profilis" : "")}</h1>
                {displayCoach?.email && (
                  <p className="text-sm text-muted-foreground flex items-center gap-1.5 mt-0.5">
                    <Mail className="w-3.5 h-3.5" />
                    {displayCoach.email}
                  </p>
                )}
                {displayCoach?.phone && (
                  <p className="text-sm text-muted-foreground flex items-center gap-1.5 mt-0.5">
                    <Phone className="w-3.5 h-3.5" />
                    {displayCoach.phone}
                  </p>
                )}
              </div>
            </div>
            {isAdmin && !isOwn && !isOwnProfileRoute && displayCoach && (
              <Button
                size="sm"
                variant="outline"
                onClick={() => {
                  enterViewAs(displayCoach.id, displayCoach.name);
                  setLocation("/coach/dashboard");
                }}
              >
                <User className="w-4 h-4 mr-1.5" />
                Žiūrėti kaip šis treneris
              </Button>
            )}
          </div>

          {displayCoach && (
            <div className="mt-5 space-y-4">
              {displayCoach.sports.length > 0 && (
                <div className="flex flex-wrap gap-2">
                  {displayCoach.sports.map(s => (
                    <SportPill key={s} sport={s} variant="subtle" />
                  ))}
                </div>
              )}

              {(() => {
                // Audience levels per sport. We only render sports whose
                // audience array is non-empty. Single-sport coaches get a flat
                // pill row; multi-sport coaches keep per-sport grouping so a
                // tennis-kids-only / badminton-all-levels split stays legible.
                const groups = (displayCoach.sportsAudiences ?? [])
                  .filter(s => s.audiences.length > 0);
                if (groups.length === 0) return null;
                const multiSport = groups.length > 1;
                return (
                  <div className="space-y-1.5">
                    <div className="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                      Lygis
                    </div>
                    <div className={multiSport ? "space-y-1.5" : ""}>
                      {groups.map(g => (
                        <div key={g.sport} className="flex flex-wrap items-center gap-2">
                          {multiSport && (
                            <span className="text-xs text-muted-foreground shrink-0">
                              {getSportLabel(g.sport)}:
                            </span>
                          )}
                          {g.audiences.map(a => (
                            <Badge
                              key={a}
                              variant="secondary"
                              className="text-xs font-medium"
                            >
                              {AUDIENCE_LT[a] ?? a}
                            </Badge>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })()}

              <div className="flex flex-wrap gap-4 text-sm">
                {displayCoach.pricePerHour != null && (
                  <div className="flex items-center gap-1.5 text-foreground font-semibold">
                    <Euro className="w-4 h-4 text-primary" />
                    {centsToEuroString(displayCoach.pricePerHour)}€ / val
                  </div>
                )}
                {displayCoach.availabilityDescription && (
                  <div className="flex items-center gap-1.5 text-muted-foreground">
                    <Clock className="w-4 h-4" />
                    {displayCoach.availabilityDescription}
                  </div>
                )}
                {displayCoach.experienceYears != null && displayCoach.experienceYears > 0 && (
                  <div className="flex items-center gap-1.5 text-muted-foreground">
                    <Sparkles className="w-4 h-4" />
                    Patirtis: {displayCoach.experienceYears} m.
                  </div>
                )}
              </div>

              {displayCoach.bio && (
                <p className="text-sm text-muted-foreground leading-relaxed">{displayCoach.bio}</p>
              )}

              {!isOwn && displayCoach.userId && (
                <Button
                  variant="outline"
                  className="w-full sm:w-auto"
                  onClick={() => {
                    if (!isSignedIn) {
                      openSignIn();
                      return;
                    }
                    setLocation(`/messages?u=${encodeURIComponent(displayCoach.userId)}&n=${encodeURIComponent(displayCoach.name)}`);
                  }}
                >
                  <MessageCircle className="w-4 h-4 mr-1.5" />
                  Rašyti trenerui
                </Button>
              )}

              {displayCoach.videoUrl && (
                <a
                  href={displayCoach.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="inline-flex items-center gap-2 text-sm text-primary hover:underline"
                >
                  <Video className="w-4 h-4" />
                  Peržiūrėti video
                </a>
              )}

            </div>
          )}
        </div>

        {/* Kvalifikacija — unverified MVP credentials list. Coaches edit these
            in /coach/settings. Card hides entirely when the list is empty so
            new profiles aren't littered with empty sections. */}
        {displayCoach && (displayCoach.qualifications?.length ?? 0) > 0 && (
          <div className="bg-card border rounded-2xl p-6 shadow-sm">
            <h2 className="text-base font-semibold flex items-center gap-2 mb-3">
              <Sparkles className="w-4 h-4 text-primary" />
              Kvalifikacija
            </h2>
            <ul className="list-disc pl-5 space-y-1 text-sm text-muted-foreground">
              {displayCoach.qualifications!.map((q, idx) => (
                <li key={idx} className="leading-relaxed">{q}</li>
              ))}
            </ul>
          </div>
        )}

        {/* Services — read-only "starting from" catalog. Bookable for
            students; owner sees the same list but with a CTA to the
            dashboard instead of a self-book action. */}
        {coach && (
          <div className="bg-card border rounded-2xl p-6 shadow-sm">
            <div className="flex items-start justify-between gap-3 mb-4">
              <h2 className="text-base font-semibold flex items-center gap-2">
                <Sparkles className="w-4 h-4 text-primary" />
                Paslaugos
              </h2>
            </div>

            {servicesQ.isLoading ? (
              <div className="space-y-3">
                <Skeleton className="h-24 w-full rounded-xl" />
                <Skeleton className="h-24 w-full rounded-xl" />
              </div>
            ) : (() => {
              const visibleServices = (servicesQ.data ?? []).filter(s => s.isActive);
              if (visibleServices.length === 0) {
                return (
                  <div className="text-sm text-muted-foreground py-8 text-center bg-muted/30 rounded-lg border border-dashed">
                    {isOwn
                      ? 'Dar neturite aktyvių paslaugų. Pridėkite jas Trenerio skydelyje.'
                      : "Šiuo metu treneris neturi aktyvių paslaugų."}
                  </div>
                );
              }
              return (
                <div className="space-y-3">
                  {visibleServices.map(svc => (
                    <div
                      key={svc.id}
                      className="border rounded-xl p-4 hover:border-primary/40 hover:shadow-sm transition-all bg-card"
                    >
                      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-2 flex-wrap">
                            <h3 className="font-semibold text-sm md:text-base text-foreground">
                              {svc.name}
                            </h3>
                            <SportPill sport={svc.sport} variant="subtle" size="sm" />
                            <Badge variant="secondary" className="text-[10px] gap-1 font-medium">
                              {svc.maxParticipants > 1 ? (
                                <>
                                  <Users className="w-3 h-3" />
                                  Grupinė · iki {svc.maxParticipants} asm.
                                </>
                              ) : (
                                <>
                                  <User className="w-3 h-3" />
                                  Individuali
                                </>
                              )}
                            </Badge>
                          </div>
                          <div className="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-xs text-muted-foreground">
                            <span className="inline-flex items-center gap-1">
                              <Clock className="w-3.5 h-3.5" />
                              {formatDuration(svc.durationMin)}
                            </span>
                            {svc.audienceLevel && AUDIENCE_LT[svc.audienceLevel] && (
                              <span className="inline-flex items-center gap-1">
                                <User className="w-3.5 h-3.5" />
                                {AUDIENCE_LT[svc.audienceLevel]}
                              </span>
                            )}
                          </div>
                          {svc.description && (
                            <p className="mt-2 text-xs text-muted-foreground leading-relaxed line-clamp-2">
                              {svc.description}
                            </p>
                          )}
                        </div>

                        <div className="flex items-center justify-between md:justify-end md:flex-col md:items-end gap-3 md:gap-2 shrink-0 pt-1 md:pt-0 md:min-w-[140px]">
                          <div className="text-lg md:text-xl font-bold tabular-nums text-foreground">
                            {centsToEuroString(svc.priceCents)}€
                          </div>
                          {isOwn ? null : displayCoach?.isBookable === false ? (
                            <div className="flex flex-col items-end gap-0.5">
                              <Button
                                size="sm"
                                disabled
                                className="w-auto opacity-60 cursor-not-allowed"
                                title="Mokėjimai laikinai negalimi"
                              >
                                <CalendarDays className="w-3.5 h-3.5 mr-1.5" />
                                Užsakyti
                              </Button>
                              <span className="text-[10px] text-muted-foreground">
                                Mokėjimai laikinai negalimi
                              </span>
                            </div>
                          ) : (
                            <Button
                              size="sm"
                              onClick={() => openBookingDialog(svc)}
                              className="w-auto"
                            >
                              <CalendarDays className="w-3.5 h-3.5 mr-1.5" />
                              Užsakyti
                            </Button>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })()}
          </div>
        )}

        {/* Atsiliepimai — verified-purchase reviews. Hides entirely while the
            initial fetch is pending so we don't flash an empty card; shows
            the empty state once the query lands. */}
        {displayCoach && reviewMeta && (
          <div className="bg-card border rounded-2xl p-6 shadow-sm">
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-base font-semibold flex items-center gap-2">
                <Star className="w-4 h-4 text-amber-400 fill-amber-400" />
                Atsiliepimai
              </h2>
              {reviewMeta.reviewCount > 0 && reviewMeta.averageRating != null ? (
                <div className="text-sm font-semibold tabular-nums">
                  {reviewMeta.averageRating.toFixed(1)}
                  <span className="text-muted-foreground font-normal text-xs ml-1">
                    ({reviewMeta.reviewCount})
                  </span>
                </div>
              ) : (
                <span className="text-[11px] font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary">
                  Naujas
                </span>
              )}
            </div>
            {reviewItems.length === 0 ? (
              <p className="text-sm text-muted-foreground">
                Šis treneris dar neturi atsiliepimų. Tapk pirmuoju, kuris pasidalins patirtimi.
              </p>
            ) : (
              <>
                <ul className="space-y-4">
                  {reviewItems.map((r) => (
                    <li key={r.id} className="border-t first:border-t-0 first:pt-0 pt-4">
                      <div className="flex items-center justify-between gap-2">
                        <div className="flex items-center gap-2 min-w-0">
                          <span className="text-sm font-medium truncate">{r.reviewerName}</span>
                          <span className="inline-flex items-center gap-0.5">
                            {Array.from({ length: 5 }, (_, i) => (
                              <Star
                                key={i}
                                className={`w-3.5 h-3.5 ${
                                  i < r.rating
                                    ? "fill-amber-400 text-amber-400"
                                    : "text-muted-foreground/30"
                                }`}
                              />
                            ))}
                          </span>
                        </div>
                        <span className="text-[11px] text-muted-foreground shrink-0">
                          {new Date(r.createdAt).toLocaleDateString("lt-LT", { year: "numeric", month: "short", day: "numeric" })}
                        </span>
                      </div>
                      {r.comment && (
                        <p className="text-sm text-muted-foreground mt-2 leading-relaxed whitespace-pre-line">
                          {r.comment}
                        </p>
                      )}
                      {r.coachReplyText && (
                        <div className="mt-3 ml-4 pl-3 border-l-2 border-primary/40 bg-muted/30 rounded-r-lg py-2 pr-3">
                          <div className="flex items-center justify-between gap-2 mb-1">
                            <span className="text-[11px] font-semibold text-primary">
                              Trenerio atsakymas
                            </span>
                            {r.coachReplyCreatedAt && (
                              <span className="text-[10px] text-muted-foreground">
                                {new Date(r.coachReplyCreatedAt).toLocaleDateString("lt-LT", { year: "numeric", month: "short", day: "numeric" })}
                              </span>
                            )}
                          </div>
                          <p className="text-sm text-foreground/90 leading-relaxed whitespace-pre-line">
                            {r.coachReplyText}
                          </p>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
                {reviewsQ.hasNextPage && (
                  <div className="mt-4 flex justify-center">
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => reviewsQ.fetchNextPage()}
                      disabled={reviewsQ.isFetchingNextPage}
                    >
                      {reviewsQ.isFetchingNextPage && <Loader2 className="w-3.5 h-3.5 mr-1.5 animate-spin" />}
                      Rodyti daugiau
                    </Button>
                  </div>
                )}
              </>
            )}
          </div>
        )}

        {/* Gallery — public read-only view; management lives in /coach/settings */}
        {(galleryQ.data?.length ?? 0) > 0 && (
          <div className="bg-card border rounded-2xl p-6 shadow-sm">
            <h2 className="text-base font-semibold flex items-center gap-2 mb-4">
              <Images className="w-4 h-4 text-primary" />
              Galerija
            </h2>
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {galleryQ.data!.map((photo, idx) => (
                <div key={photo.id} className="relative aspect-[4/3] rounded-xl overflow-hidden group">
                  <button
                    type="button"
                    onClick={() => setLightboxIdx(idx)}
                    className="absolute inset-0 w-full h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                  >
                    <img
                      src={photo.url}
                      alt={photo.caption ?? `Nuotrauka ${idx + 1}`}
                      className="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                    {photo.caption && (
                      <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                        <p className="text-white text-[11px] truncate">{photo.caption}</p>
                      </div>
                    )}
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Lightbox */}
        {lightboxIdx !== null && galleryQ.data && (
          <div
            className="fixed inset-0 z-[200] bg-black/90 flex items-center justify-center p-4"
            onClick={() => setLightboxIdx(null)}
          >
            <button
              type="button"
              className="absolute top-4 right-4 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
              onClick={() => setLightboxIdx(null)}
            >
              <X className="w-5 h-5" />
            </button>
            {lightboxIdx > 0 && (
              <button
                type="button"
                className="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
                onClick={e => { e.stopPropagation(); setLightboxIdx(lightboxIdx - 1); }}
              >
                <ChevronLeft className="w-6 h-6" />
              </button>
            )}
            {lightboxIdx < galleryQ.data.length - 1 && (
              <button
                type="button"
                className="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
                onClick={e => { e.stopPropagation(); setLightboxIdx(lightboxIdx + 1); }}
              >
                <ChevronRight className="w-6 h-6" />
              </button>
            )}
            <div className="max-w-4xl max-h-full flex flex-col items-center gap-3" onClick={e => e.stopPropagation()}>
              <img
                src={galleryQ.data[lightboxIdx].url}
                alt={galleryQ.data[lightboxIdx].caption ?? `Nuotrauka ${lightboxIdx + 1}`}
                className="max-h-[80vh] max-w-full rounded-xl object-contain shadow-2xl"
              />
              {galleryQ.data[lightboxIdx].caption && (
                <p className="text-white/80 text-sm text-center">{galleryQ.data[lightboxIdx].caption}</p>
              )}
              <p className="text-white/40 text-xs">{lightboxIdx + 1} / {galleryQ.data.length}</p>
            </div>
          </div>
        )}

        {/* Public facilities list — where this coach teaches */}
        {coach && (facilitiesQ.data?.length ?? 0) > 0 && (
          <div className="bg-card border rounded-2xl p-6 shadow-sm">
            <h2 className="text-base font-semibold mb-4 flex items-center gap-2">
              <Building2 className="w-4 h-4 text-primary" />
              Treniruoja čia
            </h2>
            <div className="space-y-2">
              {facilitiesQ.data!.map((f, i) => (
                <div key={i} className="flex items-start gap-3 p-3 rounded-lg bg-muted/30 border">
                  <MapPin className="w-4 h-4 text-muted-foreground mt-0.5 shrink-0" />
                  <div className="flex-1 min-w-0">
                    <div className="font-medium text-sm">{f.facilityName}</div>
                    {(f.city || f.address) && (
                      <div className="text-xs text-muted-foreground mt-0.5">
                        {[f.city, f.address].filter(Boolean).join(" · ")}
                      </div>
                    )}
                    {f.courts.length > 0 && (
                      <div className="flex flex-wrap gap-1.5 mt-2">
                        {f.courts.map(c => (
                          <Link key={c.id} href={`/court/${c.id}`}>
                            <Badge variant="outline" className="cursor-pointer hover:bg-primary/10 text-[11px]">
                              {c.name}
                            </Badge>
                          </Link>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      {/* ─── Coach service booking dialog (student-facing) ───────────────── */}
      <Dialog
        open={bookingService != null}
        onOpenChange={(o) => { if (!o) closeBookingDialog(); }}
      >
        <DialogContent className="max-w-lg max-h-[90vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle>{bookingService?.name ?? "Užsakyti paslaugą"}</DialogTitle>
            <DialogDescription>
              {bookingService && (
                <span className="inline-flex items-center gap-2 flex-wrap text-xs">
                  <span className="inline-flex items-center gap-1">
                    <Clock className="w-3 h-3" />
                    {formatDuration(bookingService.durationMin)}
                  </span>
                  <span className="inline-flex items-center gap-1">
                    <Euro className="w-3 h-3" />
                    {centsToEuroString(bookingService.priceCents)}€ paslauga
                  </span>
                </span>
              )}
            </DialogDescription>
          </DialogHeader>

          {bookingService && (
            <div className="space-y-5">
              {/* Step 1 — court selection (skipped for independent services) */}
              <section className="space-y-2">
                <h3 className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                  1. Vieta
                </h3>
                {bookingService.isLocationProvidedByCoach ? (
                  <div className="flex items-start gap-2 p-3 rounded-lg bg-primary/5 border border-primary/20 text-sm">
                    <MapPin className="w-4 h-4 text-primary mt-0.5 shrink-0" />
                    <div>
                      <div className="font-medium text-foreground">Treneris pasirūpins vieta</div>
                      <div className="text-xs text-muted-foreground mt-0.5">
                        Treniruotė vyks trenerio nurodytoje vietoje. Susisiekite su treneriu dėl tikslios adreso informacijos.
                      </div>
                    </div>
                  </div>
                ) : bookingService.courtId != null ? (
                  <div className="flex items-start gap-2 p-3 rounded-lg bg-muted/40 border text-sm">
                    <MapPin className="w-4 h-4 text-muted-foreground mt-0.5 shrink-0" />
                    <div>
                      <div className="font-medium">{labelForCourt(bookingService.courtId)}</div>
                      <div className="text-xs text-muted-foreground mt-0.5">
                        Ši paslauga vykdoma tik šioje aikštelėje.
                      </div>
                    </div>
                  </div>
                ) : approvedCourtOptions.length === 0 ? (
                  <div className="flex items-start gap-2 p-3 rounded-lg bg-destructive/5 border border-destructive/30 text-sm text-destructive">
                    <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />
                    <span>Treneris šiuo metu neturi patvirtintų aikštelių.</span>
                  </div>
                ) : (
                  <RadioGroup
                    value={bookingCourtId != null ? String(bookingCourtId) : ""}
                    onValueChange={(v) => setBookingCourtId(parseInt(v, 10))}
                    className="space-y-1.5"
                  >
                    {approvedCourtOptions.map(c => (
                      <label
                        key={c.id}
                        htmlFor={`court-${c.id}`}
                        className={`flex items-center gap-3 p-3 rounded-lg border cursor-pointer transition-colors ${
                          bookingCourtId === c.id ? "border-primary bg-primary/5" : "hover:bg-muted/40"
                        }`}
                      >
                        <RadioGroupItem id={`court-${c.id}`} value={String(c.id)} />
                        <span className="text-sm flex items-center gap-1.5 min-w-0">
                          <MapPin className="w-3.5 h-3.5 text-muted-foreground shrink-0" />
                          <span className="truncate">{c.label}</span>
                        </span>
                      </label>
                    ))}
                  </RadioGroup>
                )}
              </section>

              {/* Step 2 — date + time */}
              <section className="space-y-2">
                <h3 className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                  2. Data ir laikas
                </h3>

                {/* Date trigger — opens the inline calendar popover */}
                <Button
                  type="button"
                  variant="outline"
                  className="w-full justify-start font-normal"
                  disabled={!bookingService?.isLocationProvidedByCoach && !bookingCourtId}
                  onClick={() => setShowDatePicker(s => !s)}
                >
                  <CalendarDays className="w-4 h-4 mr-2" />
                  {bookingDate
                    ? bookingDate.toLocaleDateString("lt-LT", { weekday: "long", year: "numeric", month: "long", day: "numeric" })
                    : "Pasirinkite datą"}
                </Button>

                {showDatePicker && (
                  <div className="rounded-lg border p-3 bg-card">
                    <DateCalendar
                      selected={bookingDate ?? undefined}
                      onSelect={(d) => {
                        setBookingDate(d);
                        setBookingStartTime(null);
                        setShowDatePicker(false);
                      }}
                      onClose={() => setShowDatePicker(false)}
                      minDate={new Date()}
                    />
                  </div>
                )}

                {/* Time pills — only render once a date is picked */}
                {bookingDate && (bookingService?.isLocationProvidedByCoach || bookingCourtId) && (
                  <div className="pt-1">
                    {slotsQ.isLoading ? (
                      <div className="grid grid-cols-4 gap-1.5">
                        {Array.from({ length: 8 }).map((_, i) => (
                          <Skeleton key={i} className="h-9 rounded-md" />
                        ))}
                      </div>
                    ) : (slotsQ.data?.slots ?? []).length === 0 ? (
                      <p className="text-xs text-muted-foreground py-3 text-center bg-muted/30 rounded-md border border-dashed">
                        Šiai dienai laisvų laikų nėra. Pasirinkite kitą dieną.
                      </p>
                    ) : (
                      <div className="grid grid-cols-4 gap-1.5">
                        {slotsQ.data!.slots.map(slot => {
                          const isSelected = bookingStartTime === slot.label;
                          return (
                            <button
                              key={slot.label}
                              type="button"
                              onClick={() => setBookingStartTime(slot.label)}
                              className={`h-9 rounded-md border text-sm tabular-nums transition-colors ${
                                isSelected
                                  ? "border-primary bg-primary text-primary-foreground"
                                  : "border-border hover:border-primary/40 hover:bg-muted/50"
                              }`}
                            >
                              {slot.label}
                            </button>
                          );
                        })}
                      </div>
                    )}
                  </div>
                )}
              </section>

              {/* Step 3 — summary */}
              <section className="space-y-2">
                <h3 className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                  3. Suvestinė
                </h3>
                {!quoteEnabled ? (
                  <p className="text-xs text-muted-foreground py-3 text-center bg-muted/30 rounded-md border border-dashed">
                    {bookingService?.isLocationProvidedByCoach
                      ? "Pasirinkite datą ir laiką, kad pamatytumėte galutinę kainą."
                      : "Pasirinkite vietą, datą ir laiką, kad pamatytumėte galutinę kainą."}
                  </p>
                ) : quoteQ.isLoading ? (
                  <Skeleton className="h-24 w-full rounded-lg" />
                ) : quoteQ.isError ? (
                  <div className="flex items-start gap-2 p-3 rounded-lg bg-destructive/5 border border-destructive/30 text-sm text-destructive">
                    <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />
                    <span>{(quoteQ.error as Error)?.message ?? "Nepavyko gauti kainos"}</span>
                  </div>
                ) : quoteQ.data ? (
                  <div className="rounded-lg border bg-muted/30 p-3 space-y-1.5 text-sm">
                    {quoteQ.data.courtCents > 0 && (
                      <div className="flex justify-between">
                        <span className="text-muted-foreground inline-flex items-center gap-1.5">
                          <MapPin className="w-3.5 h-3.5" />
                          Aikštelė
                        </span>
                        <span className="tabular-nums">{centsToEuroString(quoteQ.data.courtCents)}€</span>
                      </div>
                    )}
                    <div className="flex justify-between">
                      <span className="text-muted-foreground inline-flex items-center gap-1.5">
                        <Sparkles className="w-3.5 h-3.5" />
                        Paslauga
                      </span>
                      <span className="tabular-nums">{centsToEuroString(quoteQ.data.serviceCents)}€</span>
                    </div>
                    <div className="h-px bg-border my-1" />
                    <div className="flex justify-between font-semibold text-foreground">
                      <span>Iš viso</span>
                      <span className="tabular-nums">{centsToEuroString(quoteQ.data.totalCents)}€</span>
                    </div>
                    <div className="text-xs text-muted-foreground pt-1 flex flex-wrap gap-x-3 gap-y-0.5">
                      <span>{bookingDate?.toLocaleDateString("lt-LT", { day: "numeric", month: "long" })}</span>
                      <span>{quoteQ.data.startTime}–{quoteQ.data.endTime}</span>
                      {quoteQ.data.courtId != null
                        ? <span>{labelForCourt(quoteQ.data.courtId)}</span>
                        : <span className="inline-flex items-center gap-1"><MapPin className="w-3 h-3" />Trenerio vieta</span>
                      }
                    </div>
                  </div>
                ) : null}
              </section>
            </div>
          )}

          <DialogFooter className="gap-2">
            <Button
              type="button"
              variant="outline"
              onClick={closeBookingDialog}
              disabled={isProcessingCheckout}
            >
              Atšaukti
            </Button>
            <Button
              type="button"
              onClick={submitCoachBooking}
              disabled={
                isProcessingCheckout
                || !quoteEnabled
                || quoteQ.isLoading
                || quoteQ.isError
                || !quoteQ.data
              }
            >
              {isProcessingCheckout ? (
                <><Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> Apmokama...</>
              ) : !isSignedIn ? (
                <><User className="w-4 h-4 mr-1.5" /> Prisijungti ir apmokėti</>
              ) : (
                <><CreditCard className="w-4 h-4 mr-1.5" /> Apmokėti</>
              )}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

    </Layout>
  );
}
