/** DELETE /admin/users/:id — hard-delete user from Clerk; webhook handles local DB cleanup */
router.delete("/admin/users/:id", requireAdmin, async (req, res): Promise<void> => {
  const { userId: adminUserId } = getAuth(req);
  const targetUserId = String(req.params.id);

  if (!targetUserId) {
    res.status(400).json({ error: "Nenurodytas vartotojo ID" });
    return;
  }
  if (adminUserId && adminUserId === targetUserId) {
    res.status(400).json({ error: "Negalima ištrinti savo paskyros" });
    return;
  }

  try {
    await clerkClient.users.deleteUser(targetUserId);
    res.json({ deleted: true, userId: targetUserId });
  } catch (err: unknown) {
    const anyErr = err as { errors?: { longMessage?: string }[]; message?: string };
    const msg = anyErr?.errors?.[0]?.longMessage ?? anyErr?.message ?? "Klaida trinant vartotoją";
    res.status(400).json({ error: msg });
  }
});

/** POST /admin/seed-courts — seed courts from JSON file if DB is empty */
router.post("/admin/seed-courts", requireAdmin, async (_req, res): Promise<void> => {
  try {
    const [{ value: courtCount }] = await db.select({ value: count() }).from(courtsTable);
    if (Number(courtCount) > 0) {
      res.json({ message: `Skipped — ${courtCount} courts already exist`, inserted: 0 });
      return;
    }

    const seedPath = join(__dirname, "data/courts-seed.json");
    const seedData: Array<Record<string, unknown>> = JSON.parse(readFileSync(seedPath, "utf-8"));

    // Ensure a seed facility exists to satisfy the notNull facilityId FK
    let seedFacilityId: number;
    const [existingFacility] = await db.select({ id: facilitiesTable.id }).from(facilitiesTable).limit(1);
    if (existingFacility) {
      seedFacilityId = existingFacility.id;
    } else {
      const [newFacility] = await db.insert(facilitiesTable).values({
        name: "Seed Facility",
        ownerUserId: "seed",
        address: "",
        city: "",
        verificationStatus: "pending",
      }).returning({ id: facilitiesTable.id });
      seedFacilityId = newFacility.id;
    }

    const BATCH = 50;
    let inserted = 0;
    for (let i = 0; i < seedData.length; i += BATCH) {
      const batch = seedData.slice(i, i + BATCH).map((c) => ({
        name: c.name as string,
        type: c.type as string,
        description: c.description as string | null,
        pricePerHour: String(c.price_per_hour),
        imageUrl: c.image_url as string | null,
        amenities: (Array.isArray(c.amenities) ? c.amenities : []) as string[],
        isIndoor: (c.is_indoor ?? false) as boolean,
        maxPlayers: (c.max_players ?? 4) as number,
        surface: c.surface as string | null,
        condition: (c.condition ?? "good") as string,
        rating: c.rating as number | null,
        totalBookings: (c.total_bookings ?? 0) as number,
        phone: c.phone as string | null,
        status: (c.status ?? "approved") as string,
        rejectionReason: c.rejection_reason as string | null,
        facilityId: seedFacilityId,
      }));
      await db.insert(courtsTable).values(batch).onConflictDoNothing();
      inserted += batch.length;
    }

    // Reset the sequence to avoid ID collisions with future inserts
    const maxId = Math.max(...seedData.map((c) => Number(c.id)));
    await db.execute(sql`SELECT setval(pg_get_serial_sequence('courts', 'id'), ${maxId}, true)`);

    res.json({ message: "Courts seeded successfully", inserted });
  } catch (err) {
    console.error("Seed error:", err);
    res.status(500).json({ error: "Seed failed", detail: String(err) });
  }
});

// ─── Revenue ledger (Strike 6 — Bump monetization) ────────────────────────────
// GET /admin/revenue
// Returns the running totalRevenueCents (SUM of all platform_purchases) and
// the latest 50 transactions joined with the bumped entity name + Clerk user
// profile for the buyer. Sorted by createdAt DESC.
router.get("/admin/revenue", requireAdmin, async (_req, res): Promise<void> => {
  const RECENT_LIMIT = 50;

  const [[totalRow], rows] = await Promise.all([
    db
      .select({
        total: sql<number>`coalesce(sum(${platformPurchasesTable.amountCents}), 0)`,
        count: sql<number>`count(*)`,
      })
      .from(platformPurchasesTable),
    db
      .select({
        id: platformPurchasesTable.id,
        userId: platformPurchasesTable.userId,
        amountCents: platformPurchasesTable.amountCents,
        targetType: platformPurchasesTable.targetType,
        targetId: platformPurchasesTable.targetId,
        stripeSessionId: platformPurchasesTable.stripeSessionId,
        createdAt: platformPurchasesTable.createdAt,
      })
      .from(platformPurchasesTable)
      .orderBy(desc(platformPurchasesTable.createdAt))
      .limit(RECENT_LIMIT),
  ]);

  // Resolve target names (coach/court/tournament) in parallel.
  const coachIds = rows.filter(r => r.targetType === "coach").map(r => r.targetId);
  const courtIds = rows.filter(r => r.targetType === "court").map(r => r.targetId);
  const tournamentIds = rows.filter(r => r.targetType === "tournament").map(r => r.targetId);
  const [coachNames, courtNames, tournamentNames] = await Promise.all([
    coachIds.length
      ? db.select({ id: coachesTable.id, name: coachesTable.name }).from(coachesTable).where(inArray(coachesTable.id, coachIds))
      : Promise.resolve([] as { id: number; name: string }[]),
    courtIds.length
      ? db.select({ id: courtsTable.id, name: courtsTable.name }).from(courtsTable).where(inArray(courtsTable.id, courtIds))
      : Promise.resolve([] as { id: number; name: string }[]),
    tournamentIds.length
      ? db.select({ id: tournamentsTable.id, name: tournamentsTable.name }).from(tournamentsTable).where(inArray(tournamentsTable.id, tournamentIds))
      : Promise.resolve([] as { id: number; name: string }[]),
  ]);
  const coachNameMap = new Map(coachNames.map(c => [c.id, c.name]));
  const courtNameMap = new Map(courtNames.map(c => [c.id, c.name]));
  const tournamentNameMap = new Map(tournamentNames.map(t => [t.id, t.name]));
  const targetName = (t: string, id: number): string | null => {
    if (t === "coach") return coachNameMap.get(id) ?? null;
    if (t === "court") return courtNameMap.get(id) ?? null;
    if (t === "tournament") return tournamentNameMap.get(id) ?? null;
    return null;
  };

  // Resolve buyer (Clerk) names + emails in chunks of 100.
  const buyerIds = Array.from(new Set(rows.map(r => r.userId)));
  const clerkUsers: Record<string, { name: string | null; email: string | null }> = {};
  const CHUNK = 100;
  for (let i = 0; i < buyerIds.length; i += CHUNK) {
    const chunk = buyerIds.slice(i, i + CHUNK);
    try {
      const resp = await clerkClient.users.getUserList({ userId: chunk, limit: CHUNK });
      for (const cu of resp.data) {
        const name = [cu.firstName, cu.lastName].filter(Boolean).join(" ") || null;
        clerkUsers[cu.id] = {
          name,
          email: cu.emailAddresses?.[0]?.emailAddress ?? null,
        };
      }
    } catch {
      // If a Clerk lookup fails for a chunk, those rows just return null name/email.
    }
  }

  const recentTransactions = rows.map(r => ({
    id: r.id,
    userId: r.userId,
    userName: clerkUsers[r.userId]?.name ?? null,
    userEmail: clerkUsers[r.userId]?.email ?? null,
    amountCents: r.amountCents,
    targetType: r.targetType,
    targetId: r.targetId,
    targetName: targetName(r.targetType, r.targetId),
    stripeSessionId: r.stripeSessionId,
    createdAt: r.createdAt.toISOString(),
  }));

  res.json({
    totalRevenueCents: Number(totalRow?.total ?? 0),
    totalPurchaseCount: Number(totalRow?.count ?? 0),
    recentTransactions,
  });
});

// ─── Strike 7: Admin Command Center ───────────────────────────────────────────
// GET /admin/dashboard/metrics?startDate=YYYY-MM-DD&endDate=YYYY-MM-DD
//
// Aggregates booking activity for the requested window. When either bound is
// omitted, defaults to the current calendar month in UTC.
//
// Implementation strategy: rather than pulling all bookings into Node, the
// KPI totals + per-resource occupancy are computed with single grouped SQL
// queries. The ONLY raw row fetch is the recentReservations slice (capped at
// 100). Booker PII is resolved via clerkClient.users.getUserList in chunks of
// 100, mirroring the /admin/revenue pattern.

const ISO_DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
const DASHBOARD_OPEN_HOURS_PER_DAY = 17; // 06:00–23:00 baseline used for utilization%
const RESERVATION_LIMIT = 100;

function currentMonthBounds(): { start: string; end: string } {
  const now = new Date();
  const y = now.getUTCFullYear();
  const m = now.getUTCMonth();
  const start = new Date(Date.UTC(y, m, 1));
  const end = new Date(Date.UTC(y, m + 1, 0)); // last day of month
  const fmt = (d: Date) =>
    `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
  return { start: fmt(start), end: fmt(end) };
}

function daysBetweenInclusive(startISO: string, endISO: string): number {
  const start = Date.parse(`${startISO}T00:00:00Z`);
  const end = Date.parse(`${endISO}T00:00:00Z`);
  if (!Number.isFinite(start) || !Number.isFinite(end) || end < start) return 1;
  return Math.floor((end - start) / 86_400_000) + 1;
}

function todayUtcDate(): string {
  const now = new Date();
  return `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, "0")}-${String(now.getUTCDate()).padStart(2, "0")}`;
}

router.get("/admin/dashboard/metrics", requireAdmin, async (req, res): Promise<void> => {
  const startQuery = typeof req.query.startDate === "string" && ISO_DATE_RE.test(req.query.startDate)
    ? req.query.startDate
    : null;
  const endQuery = typeof req.query.endDate === "string" && ISO_DATE_RE.test(req.query.endDate)
    ? req.query.endDate
    : null;
  const defaults = currentMonthBounds();
  const startDate = startQuery ?? defaults.start;
  const endDate = endQuery ?? defaults.end;
  if (endDate < startDate) {
    res.status(400).json({ error: "endDate must be >= startDate" });
    return;
  }

  const today = todayUtcDate();
  const dayCount = daysBetweenInclusive(startDate, endDate);
  const availableHoursPerResource = dayCount * DASHBOARD_OPEN_HOURS_PER_DAY;

  // ── KPI aggregates: 3 lightweight grouped queries in parallel ──────────────
  const [
    [todayRow],
    [revenueRow],
    [activeRow],
    courtOccRows,
    coachOccRows,
    reservationRows,
  ] = await Promise.all([
    db
      .select({ n: sql<number>`count(*)` })
      .from(bookingsTable)
      .where(eq(bookingsTable.date, today)),
    db
      .select({
        cents: sql<number>`coalesce(round(sum(${bookingsTable.totalPrice}::numeric * 100)), 0)`,
      })
      .from(bookingsTable)
      .where(and(
        eq(bookingsTable.status, "confirmed"),
        gte(bookingsTable.date, startDate),
        lte(bookingsTable.date, endDate),
      )),
    db
      .select({
        n: sql<number>`count(distinct ${bookingsTable.bookerUserId})`,
      })
      .from(bookingsTable)
      .where(and(
        gte(bookingsTable.date, startDate),
        lte(bookingsTable.date, endDate),
      )),
    // Per-court booked-minutes aggregation. We only consider revenue-bearing
    // statuses (confirmed, awaiting_players) — pending checkouts and cancellations
    // should not inflate occupancy.
    db
      .select({
        courtId: bookingsTable.courtId,
        courtName: courtsTable.name,
        bookedMinutes: sql<number>`coalesce(sum(
          extract(epoch from (
            to_timestamp(${bookingsTable.endTime}, 'HH24:MI') -
            to_timestamp(${bookingsTable.startTime}, 'HH24:MI')
          )) / 60
        ), 0)`,
      })
      .from(bookingsTable)
      .innerJoin(courtsTable, eq(courtsTable.id, bookingsTable.courtId))
      .where(and(
        inArray(bookingsTable.status, ["confirmed", "awaiting_players"]),
        gte(bookingsTable.date, startDate),
        lte(bookingsTable.date, endDate),
      ))
      .groupBy(bookingsTable.courtId, courtsTable.name),
    // Per-coach booked-minutes aggregation. Coach bookings carry bookings.coachId
    // (a Clerk userId) — we join on coaches.userId to translate to a coach row.
    db
      .select({
        coachId: coachesTable.id,
        coachName: coachesTable.name,
        bookedMinutes: sql<number>`coalesce(sum(
          extract(epoch from (
            to_timestamp(${bookingsTable.endTime}, 'HH24:MI') -
            to_timestamp(${bookingsTable.startTime}, 'HH24:MI')
          )) / 60
        ), 0)`,
      })
      .from(bookingsTable)
      .innerJoin(coachesTable, eq(coachesTable.userId, bookingsTable.coachId))
      .where(and(
        inArray(bookingsTable.status, ["confirmed", "awaiting_players"]),
        gte(bookingsTable.date, startDate),
        lte(bookingsTable.date, endDate),
      ))
      .groupBy(coachesTable.id, coachesTable.name),
    // Latest 100 reservations in the window. We capture the columns needed for
    // the ledger — we'll resolve targetName + bookerName/email post-query.
    db
      .select({
        id: bookingsTable.id,
        status: bookingsTable.status,
        date: bookingsTable.date,
        startTime: bookingsTable.startTime,
        endTime: bookingsTable.endTime,
        totalPrice: bookingsTable.totalPrice,
        courtId: bookingsTable.courtId,
        courtName: courtsTable.name,
        coachId: bookingsTable.coachId,
        coachName: coachesTable.name,
        bookerUserId: bookingsTable.bookerUserId,
        customerName: bookingsTable.customerName,
        customerEmail: bookingsTable.customerEmail,
        createdAt: bookingsTable.createdAt,
      })
      .from(bookingsTable)
      .leftJoin(courtsTable, eq(courtsTable.id, bookingsTable.courtId))
      .leftJoin(coachesTable, eq(coachesTable.userId, bookingsTable.coachId))
      .where(and(
        gte(bookingsTable.date, startDate),
        lte(bookingsTable.date, endDate),
      ))
      .orderBy(desc(bookingsTable.createdAt))
      .limit(RESERVATION_LIMIT),
  ]);

  // ── Occupancy formatter ────────────────────────────────────────────────────
  const formatOccupancy = (
    rows: Array<{ id: number; name: string; bookedMinutes: number }>,
  ) =>
    rows
      .map(r => {
        const bookedHours = Number(r.bookedMinutes) / 60;
        const utilization = availableHoursPerResource > 0
          ? Math.min(100, (bookedHours / availableHoursPerResource) * 100)
          : 0;
        return {
          id: r.id,
          name: r.name,
          bookedHours: Math.round(bookedHours * 10) / 10,
          utilizationPercentage: Math.round(utilization * 10) / 10,
        };
      })
      .sort((a, b) => b.utilizationPercentage - a.utilizationPercentage);

  const courtsOccupancy = formatOccupancy(
    courtOccRows
      .filter((r): r is typeof r & { courtId: number } => r.courtId != null)
      .map(r => ({ id: r.courtId, name: r.courtName, bookedMinutes: Number(r.bookedMinutes) })),
  );
  const coachesOccupancy = formatOccupancy(
    coachOccRows.map(r => ({ id: r.coachId, name: r.coachName, bookedMinutes: Number(r.bookedMinutes) })),
  );

  // ── Resolve booker PII via Clerk (chunks of 100) ───────────────────────────
  const bookerUserIds = Array.from(
    new Set(reservationRows.map(r => r.bookerUserId).filter((u): u is string => !!u)),
  );
  const clerkUsers: Record<string, { name: string | null; email: string | null }> = {};
  const CHUNK = 100;
  for (let i = 0; i < bookerUserIds.length; i += CHUNK) {
    const chunk = bookerUserIds.slice(i, i + CHUNK);
    try {
      const resp = await clerkClient.users.getUserList({ userId: chunk, limit: CHUNK });
      for (const cu of resp.data) {
        const name = [cu.firstName, cu.lastName].filter(Boolean).join(" ") || null;
        clerkUsers[cu.id] = {
          name,
          email: cu.emailAddresses?.[0]?.emailAddress ?? null,
        };
      }
    } catch {
      // Continue on Clerk failure — those rows just fall back to bookings.customerName/Email below.
    }
  }

  const recentReservations = reservationRows.map(r => {
    const isCoachBooking = !!r.coachId;
    const clerkInfo = r.bookerUserId ? clerkUsers[r.bookerUserId] : undefined;
    return {
      id: r.id,
      status: r.status,
      date: r.date,
      startTime: r.startTime,
      endTime: r.endTime,
      priceCents: Math.round(Number(r.totalPrice) * 100),
      targetType: (isCoachBooking ? "coach" : "court") as "coach" | "court",
      targetName: isCoachBooking ? (r.coachName ?? null) : (r.courtName ?? null),
      bookerName: clerkInfo?.name ?? r.customerName ?? null,
      bookerEmail: clerkInfo?.email ?? r.customerEmail ?? null,
    };
  });

  const payload = {
    startDate,
    endDate,
    kpis: {
      todayBookings: Number(todayRow?.n ?? 0),
      monthlyRevenueCents: Number(revenueRow?.cents ?? 0),
      activeUsers: Number(activeRow?.n ?? 0),
    },
    occupancy: {
      courts: courtsOccupancy,
      coaches: coachesOccupancy,
    },
    recentReservations,
  };

  // Final validation: shape the response through the Zod schema so any drift
  // between the SQL aggregations and the contract surfaces here, not in the UI.
  res.json(AdminDashboardMetricsResponse.parse(payload));
});

export default router;
