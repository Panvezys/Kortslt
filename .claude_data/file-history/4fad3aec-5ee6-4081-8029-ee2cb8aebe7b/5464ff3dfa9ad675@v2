import { useState, useMemo } from "react";
import { useQuery } from "@tanstack/react-query";
import { Link } from "wouter";
import { CoachLayout } from "@/components/coach-layout";
import { Skeleton } from "@/components/ui/skeleton";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { EmptyState } from "@/components/empty-state";
import { Users, MessageCircle, Mail, Search } from "lucide-react";
import { customFetch } from "@workspace/api-client-react";
import { useViewAsCoach, withCoachViewAs } from "@/lib/view-as-coach";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const API = `${BASE}/api`;

interface CoachStudent {
  key: string;
  bookerUserId: string | null;
  isGuest: boolean;
  name: string | null;
  email: string | null;
  imageUrl: string | null;
  totalLessons: number;
  lastLessonDate: string;
}

function ltPlural(n: number, singular: string, plural: string, genitive: string): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return `${n} ${singular}`;
  if (mod10 >= 2 && mod10 <= 9 && (mod100 < 10 || mod100 >= 20)) return `${n} ${plural}`;
  return `${n} ${genitive}`;
}

function initials(name: string | null, email: string | null): string {
  const source = (name?.trim() || email?.trim() || "?").trim();
  return source
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

function formatLastLesson(ymdStr: string): string {
  const [y, m, d] = ymdStr.split("-").map(Number);
  if (!y || !m || !d) return ymdStr;
  return new Date(y, m - 1, d).toLocaleDateString("lt-LT", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

export default function CoachStudents() {
  const { asCoachId } = useViewAsCoach();
  const [search, setSearch] = useState("");

  const { data: students = [], isLoading, error } = useQuery<CoachStudent[]>({
    queryKey: ["coach-students", asCoachId],
    queryFn: () => customFetch<CoachStudent[]>(withCoachViewAs(`${API}/coaches/me/students`)),
    staleTime: 60_000,
  });

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return students;
    return students.filter(s =>
      (s.name ?? "").toLowerCase().includes(q) ||
      (s.email ?? "").toLowerCase().includes(q),
    );
  }, [students, search]);

  return (
    <CoachLayout title="Mokiniai">
      <div className="px-4 md:px-6 py-6 space-y-6 max-w-4xl">
        <header className="flex flex-col gap-1">
          <h1 className="text-2xl font-semibold tracking-tight">Mokiniai</h1>
          <p className="text-sm text-muted-foreground">
            Visi su jumis dirbantys mokiniai matomi vienoje vietoje.
          </p>
        </header>

        {/* Search — only shown once data is loaded and roster is non-empty */}
        {!isLoading && !error && students.length > 0 && (
          <div className="relative">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
            <Input
              placeholder="Ieškoti pagal vardą arba el. paštą…"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              className="pl-9"
            />
          </div>
        )}

        {isLoading ? (
          <div className="rounded-2xl border bg-card divide-y">
            {Array.from({ length: 4 }).map((_, i) => (
              <div key={i} className="px-4 py-4 flex items-center gap-3">
                <Skeleton className="h-11 w-11 rounded-full" />
                <div className="flex-1 space-y-1.5">
                  <Skeleton className="h-4 w-40" />
                  <Skeleton className="h-3 w-56" />
                </div>
                <Skeleton className="h-8 w-20" />
              </div>
            ))}
          </div>
        ) : error ? (
          <div className="rounded-2xl border border-destructive/40 bg-destructive/10 px-5 py-4 text-sm text-destructive">
            Nepavyko įkelti mokinių sąrašo. Bandykite dar kartą po kelių minučių.
          </div>
        ) : students.length === 0 ? (
          <EmptyState
            icon={<Users className="h-10 w-10" />}
            title="Dar nėra mokinių"
            description="Dar neturite registruotų mokinių. Mokiniai čia pasirodys, kai atliks pirmąją rezervaciją."
          />
        ) : filtered.length === 0 ? (
          <div className="rounded-2xl border bg-card px-5 py-10 text-center text-sm text-muted-foreground">
            Nėra mokinių atitinkančių „{search}".
          </div>
        ) : (
          <>
            <p className="text-xs text-muted-foreground -mt-2">
              {filtered.length === students.length
                ? `${students.length} ${students.length === 1 ? "mokinys" : "mokiniai"}`
                : `${filtered.length} iš ${students.length}`}
            </p>
            <ul className="rounded-2xl border bg-card divide-y overflow-hidden">
              {filtered.map((s) => (
                <li
                  key={s.key}
                  className="px-4 py-4 flex items-center gap-3 hover:bg-muted/30 transition-colors"
                >
                  <Avatar className="h-11 w-11 shrink-0">
                    {s.imageUrl && <AvatarImage src={s.imageUrl} alt={s.name ?? "Mokinys"} />}
                    <AvatarFallback className="bg-primary/15 text-primary font-semibold text-xs">
                      {initials(s.name, s.email)}
                    </AvatarFallback>
                  </Avatar>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="text-sm font-semibold truncate">
                        {s.name ?? s.email ?? "Be vardo"}
                      </span>
                      {s.isGuest && (
                        <Badge variant="secondary" className="text-[10px] uppercase tracking-wide">
                          Svečias
                        </Badge>
                      )}
                    </div>
                    <div className="text-xs text-muted-foreground mt-0.5 flex items-center gap-2 flex-wrap">
                      {s.email && (
                        <span className="inline-flex items-center gap-1 min-w-0">
                          <Mail className="h-3 w-3 shrink-0" />
                          <span className="truncate">{s.email}</span>
                        </span>
                      )}
                      {s.email && <span>·</span>}
                      <span>{ltPlural(s.totalLessons, "pamoka", "pamokos", "pamokų")}</span>
                      <span>·</span>
                      <span>Paskutinė: {formatLastLesson(s.lastLessonDate)}</span>
                    </div>
                  </div>
                  {s.bookerUserId && (
                    <Button asChild size="sm" variant="outline" className="shrink-0">
                      <Link
                        href={`/messages?u=${s.bookerUserId}&n=${encodeURIComponent(s.name ?? s.email ?? "Mokinys")}`}
                      >
                        <MessageCircle className="h-4 w-4 mr-1.5" />
                        Žinutė
                      </Link>
                    </Button>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </CoachLayout>
  );
}
