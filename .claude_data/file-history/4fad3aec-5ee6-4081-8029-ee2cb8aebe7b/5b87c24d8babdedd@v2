// Cryptographically random opaque token used to authorize guest booking management.
export function generateManagementToken(): string {
  return randomBytes(32).toString("base64url");
}

// ─── Refund tier policy ──────────────────────────────────────────────────────
//
// COURT policy (`facilities.cancellationPolicy`):
//   'standard' (default)
//     >= 48h before start: 80% refund
//     >= 24h and < 48h:    50% refund
//     <  24h:              0% refund
//   'strict':  0% at any time
//
// COACH policy (`coaches.cancellationPolicy`):
//   'flexible': 100% up to 24h before start; 0% inside 24h.
//   'standard': matches the court 80/50/0 tiers above.
//   'strict':   0% at any time.
//
// All money math is done in INTEGER CENTS to avoid binary-float drift (e.g.
// 19.99 * 0.5 = 9.995). Stripe APIs accept amounts in integer cents.
//
// CRITICAL INVARIANT (Strike 3): for any cancellation, the total refunded to
// the player is computeCourtRefundCents() + computeCoachRefundCents() with NO
// further adjustment. The platform retains its full margin to cover Stripe's
// non-refundable processing fees.

export type CourtCancellationPolicy = "standard" | "strict";
export type CoachCancellationPolicy = "flexible" | "standard" | "strict";

function standardTierPercent(hours: number): number {
  if (hours >= 48) return 80;
  if (hours >= 24) return 50;
  return 0;
}

export function computeCourtRefundCents(
  courtCents: number,
  hours: number,
  policy: CourtCancellationPolicy,
): number {
  if (policy === "strict") return 0;
  const pct = standardTierPercent(hours);
  if (pct === 0) return 0;
  return Math.round((courtCents * pct) / 100);
}

export function computeCoachRefundCents(
  coachCents: number,
  hours: number,
  policy: CoachCancellationPolicy,
): number {
  if (coachCents <= 0) return 0;
  if (policy === "strict") return 0;
  if (policy === "flexible") return hours >= 24 ? coachCents : 0;
  const pct = standardTierPercent(hours);
  if (pct === 0) return 0;
  return Math.round((coachCents * pct) / 100);
}

// Backwards-compatible wrapper retained for guest-bookings, games (split), and
// diagnostic routes that don't yet split court vs. coach. New code should call
// computeCourtRefundCents directly.
export function computeRefund(
  totalPriceEur: number,
  hoursBeforeStart: number,
  policy: CourtCancellationPolicy = "standard",
) {
  const totalCents = Math.round(totalPriceEur * 100);
  const cents = computeCourtRefundCents(totalCents, hoursBeforeStart, policy);
  const pct = policy === "strict" ? 0 : standardTierPercent(hoursBeforeStart);
  return {
    refundPercent: pct,
    refundAmount: cents / 100,
    refundCents: cents,
    refundable: cents > 0,
  };
}

// Booking `date`/`startTime` are stored as Lithuanian local time strings. The
// server runs in UTC, so naively parsing `${date}T${startTime}:00` would treat
// them as UTC and give a result that is wrong by Vilnius's DST offset (2–3h).
// Compute the UTC instant for the Vilnius wall-clock time, then diff against
// `Date.now()` in absolute milliseconds.
export function vilniusLocalToUtcMs(date: string, time: string): number {
  const dateOnly = String(date).slice(0, 10);
  // Step 1: pretend the local string is UTC.
  const naiveUtcMs = Date.parse(`${dateOnly}T${time}:00Z`);
  // Step 2: ask what Europe/Vilnius wall-clock that UTC instant displays.
  const fmt = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Vilnius",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", second: "2-digit",
    hour12: false,
  });
  const parts = fmt.formatToParts(new Date(naiveUtcMs));
  const get = (t: string) => parts.find(p => p.type === t)!.value;
  let hh = get("hour");
  if (hh === "24") hh = "00";
  const vilniusAsUtcMs = Date.UTC(
    Number(get("year")), Number(get("month")) - 1, Number(get("day")),
    Number(hh), Number(get("minute")), Number(get("second")),
  );
  // Offset = how many ms Vilnius is AHEAD of UTC at that instant (+2h or +3h).
  const offsetMs = vilniusAsUtcMs - naiveUtcMs;
  // Subtract offset to get the actual UTC instant for that Vilnius wall-clock time.
  return naiveUtcMs - offsetMs;
}

export function hoursBeforeStart(date: string, startTime: string): number {
  return (vilniusLocalToUtcMs(date, startTime) - Date.now()) / (1000 * 60 * 60);
}

// Returns the number of calendar days between today (Vilnius local) and the booking date.
function daysUntilBooking(dateStr: string): number {
  const fmt = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Vilnius" });
  const todayStr = fmt.format(new Date()); // YYYY-MM-DD
  const today = Date.parse(todayStr + "T00:00:00Z");
  const target = Date.parse(String(dateStr).slice(0, 10) + "T00:00:00Z");
  return Math.round((target - today) / (1000 * 60 * 60 * 24));
}

function toMin(t: string): number {
  const [h, m] = t.split(":").map(Number);
  return h * 60 + m;
}

function slotsBetween(startTime: string, endTime: string): string[] {
  const start = toMin(startTime);
  const end = toMin(endTime);
  const result: string[] = [];
  for (let m = start; m < end; m += 30) {
    const h = Math.floor(m / 60);
    const min = m % 60;
    result.push(`${h.toString().padStart(2, "0")}:${min.toString().padStart(2, "0")}`);
  }
  return result;
}

const router: IRouter = Router();

function formatBooking(
  booking: typeof bookingsTable.$inferSelect,
  courtName?: string,
  paidSlots?: number,
  // Optional joined coach profile. Callers that LEFT JOIN coachesTable on
  // bookings.coachId = coachesTable.userId should pass { id, name } here so
  // the client doesn't N+1 fetch the coach to label the booking row.
  coach?: { id: number; name: string } | null,
  // The booker's existing review for this coach lesson, if any. Null when
  // none exists or this isn't a coach booking. Drives the player dashboard's
  // "Palikti atsiliepimą" → "Redaguoti atsiliepimą" CTA switch.
  coachReview?: { id: number; rating: number; comment: string | null } | null,
  // The booker's existing review for the court, if any. Populated regardless
  // of coach presence; the UI only surfaces the CTA for non-coach bookings
  // so players aren't asked to review a court and a coach lesson separately.
  courtReview?: { id: number; rating: number; comment: string | null } | null,
) {
  return {
    ...booking,
    totalPrice: Number(booking.totalPrice),
    refundAmount: Number(booking.refundAmount ?? 0),
    pricePerSlot: booking.pricePerSlot != null ? Number(booking.pricePerSlot) : undefined,
    totalSlots: booking.totalSlots ?? undefined,
    paidSlots: paidSlots,
    splitInviteToken: booking.splitInviteToken ?? undefined,
    rentedItems: booking.rentedItems ?? undefined,
    courtName: courtName ?? undefined,
    stripeSessionId: booking.stripeSessionId ?? undefined,
    stripePaymentIntentId: booking.stripePaymentIntentId ?? undefined,
    stripeRefundId: booking.stripeRefundId ?? undefined,
    managementToken: booking.managementToken ?? undefined,
    coach: coach ?? null,
    coachReview: coachReview ?? null,
    courtReview: courtReview ?? null,
  };
}

router.get("/bookings", requireAuth, async (req, res): Promise<void> => {
  const params = ListBookingsQueryParams.safeParse(req.query);
  if (!params.success) {
    res.status(400).json({ error: params.error.message });
    return;
  }

  const userId = getCurrentUserId(req)!;
  const role = await getUserRole(userId);

  const conditions = [];
  if (params.data.courtId != null) {
    conditions.push(eq(bookingsTable.courtId, params.data.courtId));
  }
  if (params.data.status) {
    conditions.push(eq(bookingsTable.status, params.data.status));
  }
  if (params.data.customerEmail) {
    conditions.push(eq(bookingsTable.customerEmail, params.data.customerEmail));
  }

  let query = db
    .select({
      booking: bookingsTable,
      courtName: courtsTable.name,
      // bookings.coachId stores the coach's Clerk userId (text), so we join
      // coaches.userId — not coaches.id. The select picks both: numeric coach
      // table id (used for /coach/:id deep links) and display name.
      coachInternalId: coachesTable.id,
      coachName: coachesTable.name,
      // Joins coach_reviews and reviews on bookingId — both have unique
      // constraints on bookingId so each LEFT JOIN yields ≤ 1 match. We
      // surface id/rating/comment for both so the dashboard can render the
      // review in-place and pass them into the edit dialog without refetch.
      coachReviewId: coachReviewsTable.id,
      coachReviewRating: coachReviewsTable.rating,
      coachReviewComment: coachReviewsTable.comment,
      courtReviewId: reviewsTable.id,
      courtReviewRating: reviewsTable.rating,
      courtReviewComment: reviewsTable.comment,
    })
    .from(bookingsTable)
    .leftJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(coachesTable, eq(bookingsTable.coachId, coachesTable.userId))
    .leftJoin(coachReviewsTable, eq(coachReviewsTable.bookingId, bookingsTable.id))
    .leftJoin(reviewsTable, eq(reviewsTable.bookingId, bookingsTable.id))
    .$dynamic();

  if (role === "admin") {
    if (conditions.length > 0) {
      query = query.where(and(...conditions));
    }
  } else {
    // "My bookings" — always scoped to the authenticated booker, regardless of
    // role. Owners use GET /api/owner/bookings for the facility-wide view.
    conditions.push(eq(bookingsTable.bookerUserId, userId));
    query = query.where(and(...conditions));
  }

  const rows = await query;

  // For each split booking, count paid participants (mirrors the split-status endpoint logic)
  const paidSlotsMap = new Map<number, number>();
  await Promise.all(
    rows
      .filter(r => r.booking.isSplit)
      .map(async r => {
        const [game] = await db.select({ id: gamesTable.id })
          .from(gamesTable)
          .where(eq(gamesTable.bookingId, r.booking.id));
        if (!game) { paidSlotsMap.set(r.booking.id, 0); return; }
        const participants = await db.select({ paymentStatus: gameParticipantsTable.paymentStatus })
          .from(gameParticipantsTable)
          .where(and(
            eq(gameParticipantsTable.gameId, game.id),
            eq(gameParticipantsTable.status, "joined"),
          ));
        const paid = participants.filter(p => p.paymentStatus === "paid").length;
        paidSlotsMap.set(r.booking.id, paid);
      })
  );

  res.json(ListBookingsResponse.parse(rows.map(r => formatBooking(
    r.booking,
    r.courtName ?? undefined,
    paidSlotsMap.get(r.booking.id),
    r.coachInternalId != null && r.coachName != null
      ? { id: r.coachInternalId, name: r.coachName }
      : null,
    r.coachReviewId != null && r.coachReviewRating != null
      ? { id: r.coachReviewId, rating: r.coachReviewRating, comment: r.coachReviewComment ?? null }
      : null,
    r.courtReviewId != null && r.courtReviewRating != null
      ? { id: r.courtReviewId, rating: r.courtReviewRating, comment: r.courtReviewComment ?? null }
      : null,
  ))));
});

// POST /bookings — supports both authenticated bookers and guests.
// No requireAuth: if the caller has a Clerk session, we associate the booking with their userId.
// If not, we treat it as a guest booking (bookerUserId=null) and generate a managementToken
// so the guest can later view/cancel via /api/guest/bookings/:token.
router.post("/bookings", async (req, res): Promise<void> => {
  const parsed = CreateBookingBody.safeParse(req.body);
  if (!parsed.success) {
    console.error("[bookings] validation failed:", JSON.stringify(req.body), parsed.error.flatten());
    res.status(400).json({ error: parsed.error.message, details: parsed.error.flatten() });
    return;
  }

  const recurringGroupId =
    typeof req.body?.recurringGroupId === "string" && req.body.recurringGroupId.length > 0
      ? req.body.recurringGroupId
      : null;

  if (recurringGroupId && req.body?.isSplit === true) {
    res.status(400).json({ error: "Split payment and recurring reservations are mutually exclusive", code: "SPLIT_RECURRING_CONFLICT" });
    return;
  }

  const d0 = parsed.data.date;
  const dateStr0 = `${d0.getUTCFullYear()}-${String(d0.getUTCMonth() + 1).padStart(2, "0")}-${String(d0.getUTCDate()).padStart(2, "0")}`;
  const dayOfWeek = new Date(dateStr0 + "T00:00:00").getDay();
  const reqStart = parsed.data.startTime;
  const reqEnd = parsed.data.endTime;
  const reqStartMin = toMin(reqStart);
  const reqEndMin = toMin(reqEnd);

  const [court] = await db.select().from(courtsTable).where(eq(courtsTable.id, parsed.data.courtId));
  if (!court) {
    res.status(404).json({ error: "Court not found" });
    return;
  }

  // ── Working hours validation ────────────────────────────────────────────────
  if (court.workingHours) {
    try {
      const wh = JSON.parse(court.workingHours) as Record<string, { open: string; close: string; closed: boolean }>;
      const dayConfig = wh[String(dayOfWeek)];
      if (dayConfig) {
        if (dayConfig.closed) {
          res.status(400).json({ error: "Court is closed on this day", code: "COURT_CLOSED" });
          return;
        }
        const openMin = toMin(dayConfig.open ?? "07:00");
        const closeMin = toMin(dayConfig.close ?? "22:00");
        if (reqStartMin < openMin || reqEndMin > closeMin) {
          res.status(400).json({ error: "Requested time is outside court working hours", code: "OUTSIDE_WORKING_HOURS" });
          return;
        }
      }
    } catch {
      // malformed workingHours JSON — skip validation, allow booking
    }
  }

  // ── Advance booking limit check ───────────────────────────────────────────
  if (court.facilityId) {
    const [facility] = await db
      .select({ advanceBookingEnabled: facilitiesTable.advanceBookingEnabled, advanceBookingLimit: facilitiesTable.advanceBookingLimit })
      .from(facilitiesTable)
      .where(eq(facilitiesTable.id, court.facilityId));
    if (facility?.advanceBookingEnabled && facility.advanceBookingLimit != null) {
      const days = daysUntilBooking(dateStr0);
      if (days > facility.advanceBookingLimit) {
        res.status(400).json({
          error: `Rezervaciją galima atlikti ne anksčiau kaip ${facility.advanceBookingLimit} d. iš anksto`,
          code: "ADVANCE_BOOKING_LIMIT_EXCEEDED",
        });
        return;
      }
    }
  }

  // ── Compute server-side price using full pricing waterfall ──
  const defaultSlotPrice = Number(court.pricePerHour) / 2;
  const { priceMap } = await buildDayPriceMap(parsed.data.courtId, dateStr0, defaultSlotPrice);

  const slots = slotsBetween(reqStart, reqEnd);
  let courtPrice = 0;
  for (const slotStart of slots) {
    courtPrice += priceMap.get(slotStart) ?? defaultSlotPrice;
  }

  const durationMinutes = reqEndMin - reqStartMin;
  const slotCount = Math.round(durationMinutes / 30);
  const bookerUserId = getCurrentUserId(req);

  // ── Atomically check conflicts and insert within a serialized transaction ──
  // A PostgreSQL advisory lock (per court+date) blocks any concurrent booking attempt
  // for the same court on the same day, making the read-then-write conflict check atomic.
  class BookingConflictError extends Error {
    constructor(public readonly statusCode: number, public readonly body: any) {
      super("BookingConflict");
    }
  }

  let booking: typeof bookingsTable.$inferSelect;
  try {
    booking = await db.transaction(async (tx) => {
      // Acquire exclusive advisory lock for this court+date combination.
      // Released automatically at end of transaction.
      const dateInt = parseInt(dateStr0.replace(/-/g, ""), 10);
      await tx.execute(sql`SELECT pg_advisory_xact_lock(${sql.raw(String(parsed.data.courtId))}::int, ${sql.raw(String(dateInt))}::int)`);

      // ── Conflict check (inside lock) ──
      const [conflictingBookings, conflictingBlocked] = await Promise.all([
        tx.select({ startTime: bookingsTable.startTime, endTime: bookingsTable.endTime })
          .from(bookingsTable)
          .where(and(
            eq(bookingsTable.courtId, parsed.data.courtId),
            eq(bookingsTable.date, dateStr0),
            or(
              eq(bookingsTable.status, "confirmed"),
              eq(bookingsTable.status, "blocked"),
              eq(bookingsTable.status, "awaiting_players"),
              and(
                eq(bookingsTable.status, "pending"),
                sql`${bookingsTable.createdAt} > NOW() - INTERVAL '15 minutes'`
              )
            )
          )),
        tx.select({ startTime: courtBlockedSlotsTable.startTime, endTime: courtBlockedSlotsTable.endTime })
          .from(courtBlockedSlotsTable)
          .where(and(
            eq(courtBlockedSlotsTable.courtId, parsed.data.courtId),
            eq(courtBlockedSlotsTable.date, dateStr0),
          )),
      ]);

      for (const b of conflictingBookings) {
        const bStart = toMin(b.startTime);
        const bEnd = toMin(b.endTime);
        if (reqStartMin < bEnd && reqEndMin > bStart) {
          throw new BookingConflictError(409, { error: "Requested time slot is not available", code: "SLOT_UNAVAILABLE" });
        }
      }

      for (const b of conflictingBlocked) {
        const bStart = toMin(b.startTime);
        const bEnd = toMin(b.endTime);
        if (reqStartMin < bEnd && reqEndMin > bStart) {
          throw new BookingConflictError(409, { error: "Requested time slot is blocked", code: "SLOT_BLOCKED" });
        }
      }

      // ── Equipment availability (inside lock, same consistent snapshot) ──
      let equipmentCost = 0;
      let validatedRentedItems: string | null = null;
      if (parsed.data.rentedItems) {
        try {
          const clientItems: Array<{ name: string; quantity?: number }> = JSON.parse(parsed.data.rentedItems);
          const courtEquipment: Array<{ name: string; pricePerSlot?: number; pricePerBooking?: number; stock: number }> =
            court.rentableItems ? JSON.parse(court.rentableItems) : [];

          const existingBookings = await tx
            .select({ rentedItems: bookingsTable.rentedItems, startTime: bookingsTable.startTime, endTime: bookingsTable.endTime, status: bookingsTable.status })
            .from(bookingsTable)
            .where(and(eq(bookingsTable.courtId, parsed.data.courtId), eq(bookingsTable.date, dateStr0)));
          const bookedQty: Record<string, number> = {};
          for (const b of existingBookings) {
            if (!b.rentedItems || b.status === "cancelled") continue;
            const bStart = toMin(b.startTime);
            const bEnd = toMin(b.endTime);
            if (bEnd <= reqStartMin || bStart >= reqEndMin) continue;
            const items: Array<{ name: string; quantity: number }> = JSON.parse(b.rentedItems);
            for (const item of items) {
              bookedQty[item.name] = (bookedQty[item.name] ?? 0) + item.quantity;
            }
          }

          const serverValidated: Array<{ name: string; pricePerSlot: number; quantity: number }> = [];
          for (const ci of clientItems) {
            const canonical = courtEquipment.find(e => e.name === ci.name);
            if (!canonical) continue;
            const pricePerSlot = canonical.pricePerSlot ?? canonical.pricePerBooking ?? 0;
            const qty = Math.max(1, Math.min(Math.floor(ci.quantity ?? 1), 20));
            const alreadyBooked = bookedQty[ci.name] ?? 0;
            if (alreadyBooked + qty > canonical.stock) {
              throw new BookingConflictError(409, {
                error: `Įranga "${ci.name}" nebepasiekiama: likę ${Math.max(0, canonical.stock - alreadyBooked)} vnt.`,
                code: "EQUIPMENT_UNAVAILABLE",
                item: ci.name,
                available: Math.max(0, canonical.stock - alreadyBooked),
              });
            }
            serverValidated.push({ name: canonical.name, pricePerSlot, quantity: qty });
            equipmentCost += pricePerSlot * qty * slotCount;
          }
          if (serverValidated.length > 0) validatedRentedItems = JSON.stringify(serverValidated);
        } catch (e) {
          if (e instanceof BookingConflictError) throw e;
          console.error("[bookings] equipment validation error:", e);
        }
      }

      const totalPrice = courtPrice + equipmentCost;

      // ── Insert inside the same transaction ──
      // Guests (no Clerk session) get a management_token so they can later view & cancel
      // their booking via /api/guest/bookings/:token. Authenticated users use their session.
      const managementToken = bookerUserId ? null : generateManagementToken();

      const [inserted] = await tx.insert(bookingsTable).values({
        courtId: parsed.data.courtId,
        bookerUserId: bookerUserId ?? null,
        customerName: parsed.data.customerName,
        customerEmail: parsed.data.customerEmail,
        customerPhone: parsed.data.customerPhone ?? null,
        date: dateStr0,
        startTime: parsed.data.startTime,
        endTime: parsed.data.endTime,
        totalPrice: String(totalPrice),
        rentedItems: validatedRentedItems,
        status: "pending",
        managementToken,
        recurringGroupId,
      }).returning();

      return inserted;
    });
  } catch (err) {
    if (err instanceof BookingConflictError) {
      res.status(err.statusCode).json(err.body);
      return;
    }
    throw err;
  }

  {
    const [bookingFacility] = await db.select({ ownerUserId: facilitiesTable.ownerUserId })
      .from(facilitiesTable).where(eq(facilitiesTable.id, court.facilityId));
    if (bookingFacility?.ownerUserId) {
      await sendNotification(
        bookingFacility.ownerUserId,
        "booking_created",
        `Nauja rezervacija — ${court.name}`,
        `${parsed.data.customerName} užrezervavo ${dateStr0} ${parsed.data.startTime}–${parsed.data.endTime}.`,
        "/owner",
      );
    }
  }

  res.status(201).json(GetBookingResponse.parse(formatBooking(booking, court.name)));
});

router.get("/bookings/:id", requireAuth, async (req, res): Promise<void> => {
  const params = GetBookingParams.safeParse(req.params);
  if (!params.success) {
    res.status(400).json({ error: params.error.message });
    return;
  }

  const userId = getCurrentUserId(req)!;

  const rows = await db
    .select({
      booking: bookingsTable,
      courtName: courtsTable.name,
      courtSport: courtsTable.type,
      facilityOwnerUserId: facilitiesTable.ownerUserId,
      facilityName: facilitiesTable.name,
      courtAddress: facilitiesTable.address,
      courtCity: facilitiesTable.city,
      coachInternalId: coachesTable.id,
      coachName: coachesTable.name,
      coachReviewId: coachReviewsTable.id,
      coachReviewRating: coachReviewsTable.rating,
      coachReviewComment: coachReviewsTable.comment,
      courtReviewId: reviewsTable.id,
      courtReviewRating: reviewsTable.rating,
      courtReviewComment: reviewsTable.comment,
    })
    .from(bookingsTable)
    .leftJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .leftJoin(coachesTable, eq(bookingsTable.coachId, coachesTable.userId))
    .leftJoin(coachReviewsTable, eq(coachReviewsTable.bookingId, bookingsTable.id))
    .leftJoin(reviewsTable, eq(reviewsTable.bookingId, bookingsTable.id))
    .where(eq(bookingsTable.id, params.data.id));

  if (!rows[0]) {
    res.status(404).json({ error: "Booking not found" });
    return;
  }

  const { booking, courtName, courtSport, facilityOwnerUserId, facilityName, courtAddress, courtCity, coachInternalId, coachName, coachReviewId, coachReviewRating, coachReviewComment, courtReviewId, courtReviewRating, courtReviewComment } = rows[0];
  const role = await getUserRole(userId);
  const isBooker = booking.bookerUserId === userId;
  const isCourOwner = facilityOwnerUserId === userId;

  if (role !== "admin" && !isBooker && !isCourOwner) {
    res.status(403).json({ error: "Forbidden" });
    return;
  }

  const formatted = formatBooking(
    booking,
    courtName ?? undefined,
    undefined,
    coachInternalId != null && coachName != null
      ? { id: coachInternalId, name: coachName }
      : null,
    coachReviewId != null && coachReviewRating != null
      ? { id: coachReviewId, rating: coachReviewRating, comment: coachReviewComment ?? null }
      : null,
    courtReviewId != null && courtReviewRating != null
      ? { id: courtReviewId, rating: courtReviewRating, comment: courtReviewComment ?? null }
      : null,
  );
  // managementToken is the sole credential for guest booking management — only return
  // it to the booker themselves, never to court owners or admins.
  if (!isBooker) {
    delete (formatted as any).managementToken;
  }

  res.json(GetBookingResponse.parse({
    ...formatted,
    courtSport: courtSport ?? undefined,
    facilityName: facilityName ?? undefined,
    courtAddress: courtAddress ?? undefined,
    courtCity: courtCity ?? undefined,
  }));
});

// Cancel all future unpaid bookings in a recurring group belonging to the caller.
// Must be registered before DELETE /bookings/:id to prevent route shadowing.
router.delete("/bookings/group/:groupId", requireAuth, async (req, res): Promise<void> => {
  const { groupId } = req.params;
  if (!groupId || typeof groupId !== "string") {
    res.status(400).json({ error: "Missing groupId" });
    return;
  }

  const userId = getCurrentUserId(req)!;

  const fmt = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Vilnius" });
  const todayStr = fmt.format(new Date());

  const bookingsInGroup = await db
    .select()
    .from(bookingsTable)
    .where(
      and(
        eq(bookingsTable.recurringGroupId, groupId),
        eq(bookingsTable.bookerUserId, userId),
        ne(bookingsTable.status, "cancelled"),
        gte(bookingsTable.date, todayStr),
      )
    );

  let cancelled = 0;
  let skipped = 0;

  for (const booking of bookingsInGroup) {
    const hours = hoursBeforeStart(booking.date, booking.startTime);
    if (hours <= 0) { skipped++; continue; }
    // Only cancel bookings that haven't been paid through Stripe — pending
    // (unpaid) or confirmed without a Stripe payment intent (free courts).
    if (booking.status === "pending" || (booking.status === "confirmed" && !booking.stripePaymentIntentId)) {
      await db.update(bookingsTable)
        .set({ status: "cancelled" })
        .where(eq(bookingsTable.id, booking.id));
      cancelled++;
    } else {
      skipped++;
    }
  }

  res.json({ cancelled, skipped });
});

router.delete("/bookings/:id", requireAuth, async (req, res): Promise<void> => {
  const params = CancelBookingParams.safeParse(req.params);
  if (!params.success) {
    res.status(400).json({ error: params.error.message });
    return;
  }

  const userId = getCurrentUserId(req)!;

  // Join coach so we can pull the coach's cancellationPolicy in one query.
  // The booking.coachId column stores the coach's Clerk userId (text), so the
  // join is on coaches.userId, not coaches.id.
  const rows = await db
    .select({
      booking: bookingsTable,
      courtName: courtsTable.name,
      facilityOwnerUserId: facilitiesTable.ownerUserId,
      facilityOwnerName: facilitiesTable.name,
      facilityOwnerEmail: facilitiesTable.email,
      cancellationPolicy: facilitiesTable.cancellationPolicy,
      coachCancellationPolicy: coachesTable.cancellationPolicy,
    })
    .from(bookingsTable)
    .leftJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .leftJoin(coachesTable, eq(bookingsTable.coachId, coachesTable.userId))
    .where(eq(bookingsTable.id, params.data.id));

  if (!rows[0]) {
    res.status(404).json({ error: "Booking not found" });
    return;
  }

  const {
    booking,
    facilityOwnerUserId,
    courtName,
    facilityOwnerName: ownerName,
    facilityOwnerEmail: ownerEmail,
    cancellationPolicy,
    coachCancellationPolicy,
  } = rows[0];
  const role = await getUserRole(userId);
  const isBooker = booking.bookerUserId === userId;
  const isCourtOwner = facilityOwnerUserId === userId;
  // The attached coach (when the booking represents a coaching lesson) can
  // also cancel — used by the coach dashboard's calendar.
  const isAttachedCoach = booking.coachId === userId;

  if (role !== "admin" && !isBooker && !isCourtOwner && !isAttachedCoach) {
    res.status(403).json({ error: "Forbidden" });
    return;
  }

  if (booking.status === "cancelled") {
    res.json(CancelBookingResponse.parse(formatBooking(booking)));
    return;
  }

  // Prevent cancelling a booking that has already started/ended.
  const hours = hoursBeforeStart(booking.date, booking.startTime);
  if (hours <= 0) {
    res.status(400).json({ error: "Booking has already started or ended", code: "CANCEL_TOO_LATE" });
    return;
  }

  // ─── Decoupled refund math (integer cents) ───────────────────────────────
  // courtCents = totalPrice − coach's share (which we recorded at checkout).
  // Court and coach refunds are computed against their OWN policies; the sum
  // is what the player receives. The platform retains its 5% court margin
  // (kept via refund_application_fee:false below).
  const totalCents = Math.round(Number(booking.totalPrice) * 100);
  const coachAttachedCents = booking.coachAmountCents ?? 0;
  const courtCents = totalCents - coachAttachedCents;

  const courtPolicy: CourtCancellationPolicy = cancellationPolicy === "strict" ? "strict" : "standard";
  const coachPolicy: CoachCancellationPolicy = coachCancellationPolicy === "flexible"
    ? "flexible"
    : coachCancellationPolicy === "strict"
      ? "strict"
      : "standard";

  const courtRefundCents = computeCourtRefundCents(courtCents, hours, courtPolicy);
  const coachRefundCents = booking.coachId
    ? computeCoachRefundCents(coachAttachedCents, hours, coachPolicy)
    : 0;
  const totalRefundCents = courtRefundCents + coachRefundCents;

  // ─── Acquire the cancellation lock (transient 'cancelling' status) ───────
  // Strike 3: reversals run BEFORE finalising the status. The transient
  // 'cancelling' state acts as a mutex — a parallel caller sees it and yields,
  // and a retry of a partially-failed cancellation also funnels through here.
  const claimed = await db
    .update(bookingsTable)
    .set({ status: "cancelling" })
    .where(and(
      eq(bookingsTable.id, params.data.id),
      inArray(bookingsTable.status, ["pending", "confirmed", "awaiting_players", "blocked"]),
    ))
    .returning();

  if (claimed.length === 0) {
    // Either a parallel caller has the lock, OR a previous attempt failed
    // mid-flight and left us in 'cancelling'. Re-read current state to decide.
    const [current] = await db.select().from(bookingsTable).where(eq(bookingsTable.id, params.data.id));
    if (!current) { res.status(404).json({ error: "Booking not found" }); return; }
    if (current.status === "cancelled") {
      res.json(CancelBookingResponse.parse(formatBooking(current)));
      return;
    }
    if (current.status !== "cancelling") {
      res.status(409).json({ error: `Cannot cancel from status ${current.status}` });
      return;
    }
    // status === 'cancelling' → fall through; Stripe calls are idempotent.
  }

  // ─── Production hardening (Strike 3.1) ────────────────────────────────────
  //
  // 1. UNPAID BYPASS: a booking with no captured PaymentIntent has nothing to
  //    refund. This covers status='pending' (Stripe Checkout abandoned before
  //    payment), free bookings (price 0), and mock-mode bookings used in tests.
  //    Skip Stripe entirely; the player wasn't charged so no money needs to
  //    move. Without this guard, paymentIntents.retrieve(null!) would throw.
  //
  // 2. ZERO-DOLLAR GUARD: when a policy resolves to 0%, the corresponding
  //    cents are 0. Calling stripe.transfers.createReversal({amount: 0}) or
  //    stripe.refunds.create({amount: 0}) returns an invalid_request_error
  //    that would lock the booking in 'cancelling' forever. Each Stripe leg
  //    has an explicit amount > 0 precondition.
  //
  // 3. NULL CHARGE GUARD: a PaymentIntent can legitimately have no charge
  //    (e.g. fully-discounted via a future promo flow). If we tried to
  //    reverse transfers or issue a refund against a non-existent charge,
  //    the API call would throw and lock the booking. We log and skip.

  let stripeRefundId: string | null = null;
  let actualRefundCents = 0;

  const isUnpaid =
    !booking.stripePaymentIntentId ||
    booking.stripePaymentIntentId.startsWith("mock_") ||
    booking.status === "pending";

  if (!isUnpaid && totalRefundCents > 0) {
    try {
      const stripe = await getUncachableStripeClient();
      const pi = await stripe.paymentIntents.retrieve(booking.stripePaymentIntentId!, {
        expand: ["latest_charge"],
      });
      const charge = pi.latest_charge;
      const chargeId: string | null = typeof charge === "string" ? charge : charge?.id ?? null;
      const ownerTransferId: string | null = typeof charge === "string"
        ? null
        : (charge?.transfer != null
            ? (typeof charge.transfer === "string" ? charge.transfer : charge.transfer.id)
            : null);

      if (!chargeId) {
        // PaymentIntent succeeded but no charge attached — unusual but
        // possible (100% discount, future promo flow). Nothing to reverse
        // or refund. Log loudly and treat as no-money-to-move.
        logger.warn(
          { bookingId: booking.id, paymentIntentId: booking.stripePaymentIntentId },
          "Cancellation: PaymentIntent has no latest_charge — skipping reversals + refund",
        );
      } else {
        // Owner reversal — exact integer cents, NOT proportional. Skip on
        // 0-cent leg (strict policy or inside no-refund tier).
        if (courtRefundCents > 0 && ownerTransferId) {
          await stripe.transfers.createReversal(
            ownerTransferId,
            {
              amount: courtRefundCents,
              metadata: { bookingId: String(booking.id), leg: "court" },
            },
            { idempotencyKey: `cancel-court-${booking.id}` },
          );
        }

        // Coach reversal — only fires when a transfer actually happened in
        // Strike 2 (booking.coachTransferId is the marker) AND the policy
        // computed a positive refund.
        if (coachRefundCents > 0 && booking.coachTransferId) {
          await stripe.transfers.createReversal(
            booking.coachTransferId,
            {
              amount: coachRefundCents,
              metadata: { bookingId: String(booking.id), leg: "coach" },
            },
            { idempotencyKey: `cancel-coach-${booking.id}` },
          );
        }

        // Single player refund from platform balance — the reversals above
        // have already pulled the exact amounts back to platform.
        // refund_application_fee:false retains the 5% court margin for
        // non-refundable Stripe processing fees. Skip when total is 0 (both
        // policies resolved to 0%) — Stripe would reject amount:0.
        if (totalRefundCents > 0) {
          const refund = await stripe.refunds.create(
            {
              charge: chargeId,
              amount: totalRefundCents,
              refund_application_fee: false,
              reason: "requested_by_customer",
            },
            { idempotencyKey: `cancel-refund-${booking.id}` },
          );
          stripeRefundId = refund.id;
          actualRefundCents = totalRefundCents;
        }
      }

      logger.info(
        {
          bookingId: booking.id,
          courtRefundCents,
          coachRefundCents,
          totalRefundCents,
          actualRefundCents,
          refundId: stripeRefundId,
          chargeId,
        },
        "Cancellation reversals + refund completed",
      );
    } catch (err) {
      // Status stays at 'cancelling' so the caller (or an admin) can retry.
      // Stripe idempotency keys mean a retry won't double-charge anyone.
      logger.error({ err, bookingId: booking.id }, "Cancellation Stripe leg failed");
      res.status(502).json({
        error: "Refund failed at payment provider",
        code: "CANCEL_STRIPE_FAILED",
      });
      return;
    }
  } else if (isUnpaid) {
    logger.info(
      { bookingId: booking.id, status: booking.status, hasPaymentIntent: !!booking.stripePaymentIntentId },
      "Cancellation: unpaid booking — skipping Stripe entirely",
    );
  }

  // ─── Finalise: cancelling → cancelled with refund details ────────────────
  // refundAmount reflects what ACTUALLY moved through Stripe, not the
  // policy-computed amount. An unpaid bypass or null-charge bypass records
  // 0.00 so the booking history is honest about whether money moved.
  const [cancelled] = await db
    .update(bookingsTable)
    .set({
      status: "cancelled",
      refundAmount: (actualRefundCents / 100).toFixed(2),
      ...(stripeRefundId ? { stripeRefundId } : {}),
    })
    .where(and(eq(bookingsTable.id, params.data.id), eq(bookingsTable.status, "cancelling")))
    .returning();

  if (!cancelled) {
    // Defensive: someone else finalised first. Return current state.
    const [current] = await db.select().from(bookingsTable).where(eq(bookingsTable.id, params.data.id));
    res.json(CancelBookingResponse.parse(formatBooking(current!)));
    return;
  }

  const totalPriceEur = Number(booking.totalPrice);
  // Emails + notifications quote the ACTUAL amount the player is receiving,
  // not the policy-computed total. For unpaid bypasses this is 0 — the
  // message correctly omits the refund line.
  const tier = { refundAmount: actualRefundCents / 100 };

  // ─── Notifications (fire-and-forget; never block the response) ───────────
  const displayCourtName = courtName ?? "Kortas";
  const dateStr = typeof booking.date === "string" ? booking.date : String(booking.date);

  // Dedupe in-app notifications: if owner and booker are the same user, only send once.
  // The "booker" view (refund details + /bookings link) takes priority since it's more relevant
  // to the human reading it. Owner-only recipients still get the owner-flavored copy.
  const notifiedUserIds = new Set<string>();

  if (booking.bookerUserId && booking.bookerUserId !== userId) {
    notifiedUserIds.add(booking.bookerUserId);
    sendNotification(
      booking.bookerUserId,
      "booking_cancelled",
      `Rezervacija atšaukta — ${displayCourtName}`,
      tier.refundAmount > 0
        ? `Jūsų rezervacija ${dateStr} ${booking.startTime}–${booking.endTime} atšaukta. Grąžinta: ${tier.refundAmount.toFixed(2)} €.`
        : `Jūsų rezervacija ${dateStr} ${booking.startTime}–${booking.endTime} atšaukta.`,
      "/bookings",
    ).catch((err) => logger.error({ err, bookingId: booking.id }, "booker cancel notification failed"));
  }

  if (facilityOwnerUserId && facilityOwnerUserId !== userId && !notifiedUserIds.has(facilityOwnerUserId)) {
    sendNotification(
      facilityOwnerUserId,
      "booking_cancelled",
      `Atšaukta rezervacija — ${displayCourtName}`,
      `${booking.customerName} atšaukė ${dateStr} ${booking.startTime}–${booking.endTime}.${
        tier.refundAmount > 0 ? ` Grąžinta klientui: ${tier.refundAmount.toFixed(2)} €.` : ""
      }`,
      "/owner",
    ).catch((err) => logger.error({ err, bookingId: booking.id }, "owner cancel notification failed"));
  }

  // Email the customer with refund details
  if (booking.customerEmail) {
    sendCustomerCancellationEmail({
      customerName: booking.customerName,
      customerEmail: booking.customerEmail,
      courtName: displayCourtName,
      date: booking.date,
      startTime: booking.startTime,
      endTime: booking.endTime,
      totalPrice: totalPriceEur,
      refundAmount: tier.refundAmount,
      bookingId: booking.id,
    }).catch((err) => logger.error({ err, bookingId: booking.id }, "sendCustomerCancellationEmail failed"));
  }

  // Email the court owner so they know the slot freed up
  if (ownerEmail) {
    sendOwnerCancellationEmail({
      ownerName: ownerName ?? "Savininkas",
      ownerEmail,
      customerName: booking.customerName,
      courtName: displayCourtName,
      date: booking.date,
      startTime: booking.startTime,
      endTime: booking.endTime,
      totalPrice: totalPriceEur,
      refundAmount: tier.refundAmount,
      bookingId: booking.id,
    }).catch((err) => logger.error({ err, bookingId: booking.id }, "sendOwnerCancellationEmail failed"));
  }

  // Notify waitlist subscribers that this slot just freed up (fire-and-forget).
  // Waitlists only exist for platform courts, so skip when courtId is null.
  if (booking.courtId != null) {
    const courtId = booking.courtId;
    db.select()
      .from(waitlistsTable)
      .where(
        and(
          eq(waitlistsTable.courtId, courtId),
          eq(waitlistsTable.date, String(booking.date).slice(0, 10)),
          eq(waitlistsTable.startTime, booking.startTime),
          eq(waitlistsTable.endTime, booking.endTime),
        ),
      )
      .then((entries) => {
        for (const entry of entries) {
          sendWaitlistNotificationEmail({
            email: entry.email,
            name: entry.name ?? undefined,
            courtName: displayCourtName,
            date: booking.date,
            startTime: booking.startTime,
            endTime: booking.endTime,
            courtId,
          }).catch((err) => logger.error({ err, waitlistId: entry.id }, "sendWaitlistNotificationEmail failed"));
        }
      })
      .catch((err) => logger.error({ err }, "Waitlist query on cancellation failed"));
  }

  res.json(CancelBookingResponse.parse(formatBooking(cancelled)));
});

// ─── Refund preview (modal calls this before confirming cancellation) ────────
router.get("/bookings/:id/refund-preview", requireAuth, async (req, res): Promise<void> => {
  const id = parseInt(String(req.params.id));
  if (isNaN(id)) { res.status(400).json({ error: "Invalid id" }); return; }

  const userId = getCurrentUserId(req)!;

  const rows = await db
    .select({
      booking: bookingsTable,
      facilityOwnerUserId: facilitiesTable.ownerUserId,
      cancellationPolicy: facilitiesTable.cancellationPolicy,
      coachCancellationPolicy: coachesTable.cancellationPolicy,
    })
    .from(bookingsTable)
    .leftJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .leftJoin(coachesTable, eq(bookingsTable.coachId, coachesTable.userId))
    .where(eq(bookingsTable.id, id));

  if (!rows[0]) { res.status(404).json({ error: "Booking not found" }); return; }

  const { booking, facilityOwnerUserId, cancellationPolicy: previewPolicy, coachCancellationPolicy } = rows[0];
  const role = await getUserRole(userId);
  const isBooker = booking.bookerUserId === userId;
  const isCourtOwner = facilityOwnerUserId === userId;

  if (role !== "admin" && !isBooker && !isCourtOwner) {
    res.status(403).json({ error: "Forbidden" });
    return;
  }

  const totalPriceEur = Number(booking.totalPrice);
  const totalCents = Math.round(totalPriceEur * 100);
  const coachAttachedCents = booking.coachAmountCents ?? 0;
  const courtCents = totalCents - coachAttachedCents;
  const hours = hoursBeforeStart(booking.date, booking.startTime);
  const courtPolicy: CourtCancellationPolicy = previewPolicy === "strict" ? "strict" : "standard";
  const coachPolicy: CoachCancellationPolicy = coachCancellationPolicy === "flexible"
    ? "flexible"
    : coachCancellationPolicy === "strict"
      ? "strict"
      : "standard";

  const courtRefundCents = computeCourtRefundCents(courtCents, hours, courtPolicy);
  const coachRefundCents = booking.coachId
    ? computeCoachRefundCents(coachAttachedCents, hours, coachPolicy)
    : 0;
  const totalRefundCents = courtRefundCents + coachRefundCents;

  // Cancellation only allowed before start time (policy applies to all roles).
  const canCancel = booking.status !== "cancelled" && hours > 0;
  let reason: string | undefined;
  if (booking.status === "cancelled") reason = "Booking is already cancelled.";
  else if (hours <= 0) reason = "Booking has already started or ended.";

  res.json({
    bookingId: booking.id,
    totalPrice: totalPriceEur,
    hoursBeforeStart: Math.round(hours * 10) / 10,
    // Backwards-compatible top-level fields (existing modal reads these).
    refundPercent: totalCents > 0 ? Math.round((totalRefundCents / totalCents) * 100) : 0,
    refundAmount: totalRefundCents / 100,
    refundable: totalRefundCents > 0,
    cancellationPolicy: courtPolicy,
    canCancel,
    // Strike 3: expose the decoupled split so the UI can render both lines.
    courtRefundCents,
    coachRefundCents,
    totalRefundCents,
    courtCancellationPolicy: courtPolicy,
    coachCancellationPolicy: booking.coachId ? coachPolicy : null,
    hasCoach: !!booking.coachId,
    ...(reason ? { reason } : {}),
  });
});

router.get("/bookings/:id/ics", requireAuth, async (req, res): Promise<void> => {
  const id = Number(req.params.id);
  if (isNaN(id)) {
    res.status(400).send("Invalid booking id");
    return;
  }

  const userId = getCurrentUserId(req)!;

  const rows = await db
    .select({
      booking: bookingsTable,
      courtName: courtsTable.name,
      courtSport: courtsTable.type,
      courtId: courtsTable.id,
      courtAddress: facilitiesTable.address,
      courtCity: facilitiesTable.city,
      facilityName: facilitiesTable.name,
      facilityOwnerUserId: facilitiesTable.ownerUserId,
    })
    .from(bookingsTable)
    .leftJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .where(eq(bookingsTable.id, id));

  if (!rows[0]) {
    res.status(404).send("Booking not found");
    return;
  }

  const { booking, courtName, courtSport, courtId, courtAddress, courtCity, facilityName, facilityOwnerUserId } = rows[0];
  const role = await getUserRole(userId);
  const isBooker = booking.bookerUserId === userId;
  const isCourtOwner = facilityOwnerUserId === userId;

  if (role !== "admin" && !isBooker && !isCourtOwner) {
    res.status(403).send("Forbidden");
    return;
  }

  const siteUrl = process.env.SITE_URL || "https://korts.lt";

  function icsDateTime(date: string, time: string): string {
    return date.replace(/-/g, "") + "T" + time.slice(0, 5).replace(":", "") + "00";
  }

  const now = new Date();
  const dtstamp = now.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");

  const courtLabel = courtName ?? "Kortas";
  const summary = facilityName
    ? `${courtSport ?? "Sportas"} – ${courtLabel}, ${facilityName}`
    : `${courtSport ?? "Sportas"} – ${courtLabel}`;
  const locationParts = [courtAddress, courtCity, "Lietuva"].filter(Boolean);
  const description = [
    `Rezervacija #${booking.id} per korts.lt`,
    `Aikštelė: ${courtLabel}`,
    facilityName ? `Objektas: ${facilityName}` : null,
    courtSport ? `Sportas: ${courtSport}` : null,
    `Kaina: ${Number(booking.totalPrice).toFixed(2)} €`,
    `Nuoroda: ${siteUrl}/bookings/${booking.id}`,
  ].filter(Boolean).join("\\n");

  const ics = [
    "BEGIN:VCALENDAR",
    "VERSION:2.0",
    "PRODID:-//korts.lt//Court Booking//LT",
    "CALSCALE:GREGORIAN",
    "METHOD:PUBLISH",
    "BEGIN:VEVENT",
    `UID:booking-${booking.id}@korts.lt`,
    `DTSTAMP:${dtstamp}`,
    `DTSTART;TZID=Europe/Vilnius:${icsDateTime(booking.date, booking.startTime)}`,
    `DTEND;TZID=Europe/Vilnius:${icsDateTime(booking.date, booking.endTime)}`,
    `SUMMARY:${summary}`,
    `DESCRIPTION:${description}`,
    `LOCATION:${locationParts.join(", ")}`,
    `URL:${siteUrl}/bookings/${booking.id}`,
    "END:VEVENT",
    "END:VCALENDAR",
  ].join("\r\n");

  res.setHeader("Content-Type", "text/calendar; charset=utf-8");
  res.setHeader("Content-Disposition", `attachment; filename="booking-${booking.id}.ics"`);
  res.send(ics);
});

// ─── Owner: block a court time slot ──────────────────────────────────────────
const BlockBookingBody = z.object({
  courtId: z.number().int(),
  date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
  startTime: z.string().regex(/^\d{2}:\d{2}$/),
  endTime: z.string().regex(/^\d{2}:\d{2}$/),
  notes: z.string().optional(),
});

router.post("/owner/bookings/block", requireAuth, async (req, res): Promise<void> => {
  const parsed = BlockBookingBody.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: "Invalid body", details: parsed.error.flatten() }); return; }

  const { courtId, date, startTime, endTime, notes } = parsed.data;
  const ownerId = getCurrentUserId(req)!;

  const [court] = await db.select().from(courtsTable).where(eq(courtsTable.id, courtId));
  if (!court) { res.status(404).json({ error: "Court not found" }); return; }
  const [blockFacility] = await db.select({ ownerUserId: facilitiesTable.ownerUserId })
    .from(facilitiesTable).where(eq(facilitiesTable.id, court.facilityId));
  if (!(await isOwner(req, blockFacility?.ownerUserId ?? null))) {
    res.status(403).json({ error: "Forbidden" }); return;
  }

  const reqStartMin = toMin(startTime);
  const reqEndMin = toMin(endTime);

  const existing = await db
    .select({ startTime: bookingsTable.startTime, endTime: bookingsTable.endTime, status: bookingsTable.status })
    .from(bookingsTable)
    .where(and(
      eq(bookingsTable.courtId, courtId),
      eq(bookingsTable.date, date),
      or(
        eq(bookingsTable.status, "confirmed"),
        and(
          eq(bookingsTable.status, "pending"),
          sql`${bookingsTable.createdAt} > NOW() - INTERVAL '15 minutes'`
        )
      )
    ));

  for (const b of existing) {
    const bStart = toMin(b.startTime);
    const bEnd = toMin(b.endTime);
    if (reqStartMin < bEnd && reqEndMin > bStart) {
      if (b.status === "confirmed") {
        res.status(409).json({ error: "Šiuo laiku yra patvirtinta rezervacija.", code: "CONFIRMED_EXISTS" });
        return;
      }
      if (b.status === "pending") {
        res.status(409).json({ error: "Šiuo metu klientas atlieka mokėjimą. Palaukite ir bandykite vėliau.", code: "PENDING_EXISTS" });
        return;
      }
    }
  }

  const [booking] = await db.insert(bookingsTable).values({
    courtId,
    bookerUserId: ownerId,
    customerName: "Savininkas (blokas)",
    customerEmail: `owner-block-${Date.now()}@korts.lt`,
    date,
    startTime,
    endTime,
    totalPrice: "0",
    status: "blocked",
    notes: notes ?? null,
  }).returning();

  res.status(201).json(booking);
});

// ─── Owner: create manual (free) booking ──────────────────────────────────────
const ManualBookingBody = z.object({
  courtId: z.number().int(),
  customerName: z.string().min(1),
  customerEmail: z.string().email().optional().or(z.literal("")).transform(v => v || ""),
  customerPhone: z.string().optional(),
  date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
  startTime: z.string().regex(/^\d{2}:\d{2}$/),
  endTime: z.string().regex(/^\d{2}:\d{2}$/),
  note: z.string().optional(),
});

router.post("/owner/bookings/manual", requireAuth, async (req, res): Promise<void> => {
  const parsed = ManualBookingBody.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: "Invalid body", details: parsed.error.flatten() }); return; }

  const { courtId, customerName, customerEmail, customerPhone, date, startTime, endTime, note } = parsed.data;

  const [court] = await db.select().from(courtsTable).where(eq(courtsTable.id, courtId));
  if (!court) { res.status(404).json({ error: "Court not found" }); return; }
  const [manualFacility] = await db.select({ ownerUserId: facilitiesTable.ownerUserId })
    .from(facilitiesTable).where(eq(facilitiesTable.id, court.facilityId));
  if (!(await isOwner(req, manualFacility?.ownerUserId ?? null))) {
    res.status(403).json({ error: "Forbidden" }); return;
  }

  const [booking] = await db.insert(bookingsTable).values({
    courtId,
    bookerUserId: null,
    customerName,
    customerEmail,
    customerPhone: customerPhone ?? null,
    date,
    startTime,
    endTime,
    totalPrice: "0",
    status: "confirmed",
    rentedItems: note ? `Pastaba: ${note}` : null,
  }).returning();

  res.status(201).json(formatBooking(booking, court.name));
});

// ─── Sweeper (called from cron) ──────────────────────────────────────────────
// Cancels single-payer bookings that have been stuck in `pending` for > 15 min.
// These rows are created by POST /bookings but never reach `confirmed` because
// the user abandoned the Stripe checkout (or never even started it). Split
// bookings transition out of `pending` via /payments/confirm-split — those are
// covered by sweepStalePendingGames in routes/games.ts, so we exclude them here.
export async function sweepAbandonedPendingBookings(): Promise<number> {
  const cancelled = await db
    .update(bookingsTable)
    .set({ status: "cancelled" })
    .where(and(
      eq(bookingsTable.status, "pending"),
      eq(bookingsTable.isSplit, false),
      sql`${bookingsTable.createdAt} < NOW() - INTERVAL '15 minutes'`,
    ))
    .returning({ id: bookingsTable.id });
  return cancelled.length;
}

export default router;
