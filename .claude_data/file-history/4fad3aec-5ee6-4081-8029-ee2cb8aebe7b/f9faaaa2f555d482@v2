import { useState, useEffect, type FormEvent } from "react";
import { useLocation } from "wouter";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { CoachLayout } from "@/components/coach-layout";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Switch } from "@/components/ui/switch";
import { Skeleton } from "@/components/ui/skeleton";
import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { useToast } from "@/hooks/use-toast";
import { customFetch } from "@workspace/api-client-react";
import { centsToEuroString } from "@/lib/money";
import { useViewAsCoach, withCoachViewAs } from "@/lib/view-as-coach";
import { CoachAffiliations } from "@/components/coach-affiliations";
import { PromoteButton } from "@/components/promote-button";
import { CoachProfileForm } from "@/components/coach-profile-form";
import { CoachWeeklyHours } from "@/components/coach-weekly-hours";
import { CoachBlockedSlots } from "@/components/coach-blocked-slots";
import { AlertTriangle, ExternalLink, Images, Upload, X, ChevronLeft, ChevronRight, Trash2, Loader2 } from "lucide-react";
import { useAuth } from "@clerk/react";

const VALID_TABS = ["profile", "general", "hours", "blocks", "gallery"] as const;
type SettingsTab = (typeof VALID_TABS)[number];

function readTabFromUrl(): SettingsTab {
  if (typeof window === "undefined") return "profile";
  const raw = new URLSearchParams(window.location.search).get("tab");
  return (VALID_TABS as readonly string[]).includes(raw ?? "")
    ? (raw as SettingsTab)
    : "profile";
}

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const API = `${BASE}/api`;

type TravelPolicy = "any_court" | "affiliated_only";
type CourtPaymentModel = "student_pays_court" | "coach_pays_court";
type CoachCancellationPolicy = "flexible" | "standard" | "strict";

interface MyCoachProfile {
  id: number;
  userId: string;
  name: string;
  email: string;
  bio?: string | null;
  phone?: string | null;
  pricePerHour?: number | null;
  isAcceptingStudents?: boolean;
  experienceYears?: number | null;
  qualifications?: string[];
  sports?: string[];
  // Legacy free-text working-hours blurb, no longer edited but still rendered
  // on public pages — passed through in the save body so it isn't wiped.
  availabilityDescription?: string | null;
  travelPolicy?: TravelPolicy;
  courtPaymentModel?: CourtPaymentModel;
  cancellationPolicy?: CoachCancellationPolicy;
  promotedUntil?: string | null;
}

interface FormState {
  isAcceptingStudents: boolean;
  travelPolicy: TravelPolicy;
  courtPaymentModel: CourtPaymentModel;
  cancellationPolicy: CoachCancellationPolicy;
}

const EMPTY_FORM: FormState = {
  isAcceptingStudents: true,
  travelPolicy: "affiliated_only",
  courtPaymentModel: "student_pays_court",
  cancellationPolicy: "standard",
};

export default function CoachSettings() {
  const { toast } = useToast();
  const qc = useQueryClient();

  const { asCoachId } = useViewAsCoach();
  const isViewingAs = asCoachId != null;
  const { data: profile, isLoading } = useQuery<MyCoachProfile>({
    queryKey: ["coach-me-profile", asCoachId],
    queryFn: () => customFetch<MyCoachProfile>(withCoachViewAs(`${API}/coaches/me`)),
    staleTime: 60_000,
  });

  type StripeStatusValue = "not_connected" | "pending" | "active";
  const { data: stripeStatus } = useQuery<{
    status: StripeStatusValue;
    accountId: string | null;
    disabledReason?: string | null;
  }>({
    queryKey: ["stripe-connect-status"],
    queryFn: () => customFetch(`${API}/stripe/connect/status`),
  });
  const isHiddenFromMarketplace =
    stripeStatus != null && stripeStatus.status !== "active";

  useEffect(() => {
    const onFocus = () => {
      qc.invalidateQueries({ queryKey: ["stripe-connect-status"] });
    };
    window.addEventListener("focus", onFocus);
    return () => window.removeEventListener("focus", onFocus);
  }, [qc]);

  const [stripeOpening, setStripeOpening] = useState(false);
  const openStripeConnect = async () => {
    setStripeOpening(true);
    try {
      const r = await customFetch<{ url: string }>(`${API}/stripe/connect`, {
        method: "POST",
      });
      window.open(r.url, "_blank", "noopener,noreferrer");
    } catch (err) {
      toast({
        title: "Klaida atidarant Stripe",
        description: (err as Error).message,
        variant: "destructive",
      });
    } finally {
      setStripeOpening(false);
    }
  };

  const [form, setForm] = useState<FormState>(EMPTY_FORM);

  // Seed the form from the server response once it arrives.
  useEffect(() => {
    if (!profile) return;
    setForm({
      isAcceptingStudents: profile.isAcceptingStudents ?? true,
      travelPolicy: profile.travelPolicy ?? "affiliated_only",
      courtPaymentModel: profile.courtPaymentModel ?? "student_pays_court",
      cancellationPolicy: profile.cancellationPolicy ?? "standard",
    });
  }, [profile]);

  const save = useMutation({
    mutationFn: async () => {
      // /coaches/me PUT expects the full upsert body — name/email/bio/sports/
      // photo/etc are owned by /coach/profile, so we resend them unchanged
      // from the server-known profile to avoid wiping them.
      if (!profile) throw new Error("Profilis dar nepasiruošė");
      return customFetch<MyCoachProfile>(`${API}/coaches/me`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: profile.name,
          email: profile.email,
          bio: profile.bio ?? null,
          phone: profile.phone ?? null,
          sports: profile.sports ?? [],
          availabilityDescription: profile.availabilityDescription ?? null,
          experienceYears: profile.experienceYears ?? null,
          qualifications: profile.qualifications ?? [],
          isAcceptingStudents: form.isAcceptingStudents,
          travelPolicy: form.travelPolicy,
          courtPaymentModel: form.courtPaymentModel,
          cancellationPolicy: form.cancellationPolicy,
        }),
      });
    },
    onSuccess: () => {
      toast({ title: "Nustatymai išsaugoti" });
      qc.invalidateQueries({ queryKey: ["coach-me-profile"] });
      qc.invalidateQueries({ queryKey: ["coach"] });
      qc.invalidateQueries({ queryKey: ["coaches"] });
    },
    onError: (e: Error) => {
      toast({ title: "Klaida", description: e.message, variant: "destructive" });
    },
  });

  function onSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (save.isPending) return;
    save.mutate();
  }

  const { getToken } = useAuth();

  type GalleryPhoto = { id: number; url: string; caption: string | null; displayOrder: number };
  const galleryQ = useQuery<GalleryPhoto[]>({
    queryKey: ["coach-gallery", profile?.id],
    queryFn: () => fetch(`${API}/coaches/${profile!.id}/gallery`).then(r => r.json()),
    enabled: !!profile?.id,
  });
  const [lightboxIdx, setLightboxIdx] = useState<number | null>(null);
  const [uploading, setUploading] = useState(false);
  const [deletingId, setDeletingId] = useState<number | null>(null);

  const uploadGalleryPhoto = async (file: File) => {
    if (!profile?.id || isViewingAs) return;
    setUploading(true);
    try {
      const token = await getToken();
      const fd = new FormData();
      fd.append("image", file);
      const res = await fetch(`${API}/coaches/${profile.id}/photos`, {
        method: "POST",
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        body: fd,
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error ?? "Upload failed");
      qc.invalidateQueries({ queryKey: ["coach-gallery", profile.id] });
      toast({ title: "Nuotrauka įkelta" });
    } catch (e: unknown) {
      toast({ title: "Klaida", description: e instanceof Error ? e.message : "Bandykite dar kartą.", variant: "destructive" });
    } finally {
      setUploading(false);
    }
  };

  const deleteGalleryPhoto = async (photoId: number) => {
    if (!profile?.id || isViewingAs) return;
    setDeletingId(photoId);
    try {
      const token = await getToken();
      const res = await fetch(`${API}/coaches/${profile.id}/photos/${photoId}`, {
        method: "DELETE",
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (!res.ok) throw new Error("Delete failed");
      qc.invalidateQueries({ queryKey: ["coach-gallery", profile.id] });
      if (lightboxIdx !== null) setLightboxIdx(null);
    } catch {
      toast({ title: "Nepavyko ištrinti", variant: "destructive" });
    } finally {
      setDeletingId(null);
    }
  };

  // URL-driven tab state. `?tab=profile|general|hours|blocks` survives reloads
  // and lets other parts of the app deep-link to a specific section. We
  // initialize from the URL once and use replaceState on changes so back/forward
  // history isn't littered with every tab click.
  const [, navigate] = useLocation();
  const [tab, setTab] = useState<SettingsTab>(readTabFromUrl);
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const current = params.get("tab");
    if (current === tab) return;
    if (tab === "profile" && (current == null || current === "")) return;
    params.set("tab", tab);
    navigate(`/coach/settings?${params.toString()}`, { replace: true });
  }, [tab, navigate]);

  return (
    <CoachLayout title="Nustatymai">
      <div className="px-4 md:px-6 py-6 max-w-3xl space-y-6">
        <header className="flex flex-col gap-1">
          <h1 className="text-2xl font-semibold tracking-tight">Nustatymai</h1>
          <p className="text-sm text-muted-foreground">
            Veiklos politika, mokėjimai ir darbo valandos.
          </p>
        </header>

        {isHiddenFromMarketplace && (
          <div
            role="alert"
            className="rounded-2xl border-2 border-destructive/40 bg-destructive/10 p-4 flex items-start gap-3"
          >
            <AlertTriangle className="w-5 h-5 text-destructive shrink-0 mt-0.5" />
            <div className="flex-1 min-w-0 space-y-2">
              <p className="text-sm font-semibold text-destructive">
                ⚠️ Jūsų profilis yra paslėptas nuo žaidėjų
              </p>
              <p className="text-sm text-destructive/90">
                Prijunkite arba atnaujinkite banko sąskaitos informaciją, kad galėtumėte priimti užsakymus.
                Paslaugų katalogą galite ruošti ir dabar — jis taps matomas iškart, kai Stripe sąskaita bus aktyvuota.
              </p>
              {stripeStatus?.disabledReason && (
                <p className="text-xs text-destructive/80">
                  Stripe priežastis: <code className="font-mono">{stripeStatus.disabledReason}</code>
                </p>
              )}
              <Button
                size="sm"
                variant="destructive"
                onClick={openStripeConnect}
                disabled={stripeOpening}
              >
                {stripeStatus?.status === "pending"
                  ? "Užbaigti Stripe sąskaitos patvirtinimą"
                  : "Prijungti banko sąskaitą"}
                <ExternalLink className="w-3.5 h-3.5 ml-1.5" />
              </Button>
            </div>
          </div>
        )}

        {isLoading || !profile ? (
          <div className="space-y-4">
            <Skeleton className="h-10" />
            <Skeleton className="h-24" />
            <Skeleton className="h-10" />
            <Skeleton className="h-10" />
          </div>
        ) : (
          <Tabs value={tab} onValueChange={(v) => setTab(v as SettingsTab)} className="space-y-6">
            <TabsList>
              <TabsTrigger value="profile">Profilis</TabsTrigger>
              <TabsTrigger value="general">Bendra</TabsTrigger>
              <TabsTrigger value="hours">Darbo valandos</TabsTrigger>
              <TabsTrigger value="blocks">Blokai</TabsTrigger>
              <TabsTrigger value="gallery">Galerija</TabsTrigger>
            </TabsList>

            <TabsContent value="profile" className="space-y-4">
              <CoachProfileForm />
            </TabsContent>

            <TabsContent value="general" className="space-y-6">
              <div className="rounded-2xl border bg-card px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                  <h2 className="text-sm font-semibold">Iškelti paieškoje</h2>
                  <p className="text-xs text-muted-foreground mt-0.5">
                    Jūsų profilis 7 dienas bus rodomas pirmiausia trenerių sąraše.
                  </p>
                </div>
                <PromoteButton
                  targetType="coach"
                  targetId={profile.id}
                  promotedUntil={profile.promotedUntil}
                  size="sm"
                />
              </div>

              <div className="rounded-lg border bg-muted/30 px-3 py-2.5">
                <div className="text-[10px] uppercase tracking-widest text-muted-foreground font-semibold">
                  Bazinė valandinė kaina paieškoje
                </div>
                <div className="text-base font-semibold">
                  {profile.pricePerHour != null && profile.pricePerHour > 0
                    ? `${centsToEuroString(profile.pricePerHour)} €/val.`
                    : "—"}
                </div>
                <p className="text-[11px] text-muted-foreground mt-0.5">
                  Apskaičiuojama automatiškai pagal pigiausią aktyvią jūsų paslaugą.
                  Kainas keiskite kortelėje „Paslaugos".
                </p>
              </div>

              <form onSubmit={onSubmit} className="space-y-5">
                <div className="flex items-center justify-between rounded-2xl border bg-card px-4 py-3">
                  <div>
                    <Label htmlFor="accepting" className="text-sm font-medium">
                      Priimu naujus mokinius
                    </Label>
                    <p className="text-xs text-muted-foreground mt-0.5">
                      Kai išjungta, jūsų profilis lieka matomas, bet nepriimsite naujų užklausų.
                    </p>
                  </div>
                  <Switch
                    id="accepting"
                    checked={form.isAcceptingStudents}
                    onCheckedChange={(checked) =>
                      setForm((f) => ({ ...f, isAcceptingStudents: checked }))
                    }
                  />
                </div>

                <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                  <legend className="text-sm font-medium px-1">Kelionių politika</legend>
                  <p className="text-xs text-muted-foreground -mt-0.5">
                    Pasirinkite, kur galite vesti treniruotes.
                  </p>
                  <RadioGroup
                    value={form.travelPolicy}
                    onValueChange={(v) =>
                      setForm((f) => ({ ...f, travelPolicy: v as TravelPolicy }))
                    }
                    className="space-y-2 pt-1"
                  >
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="affiliated_only" id="travel-affiliated" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Tik pasirinktose aikštelėse</div>
                        <div className="text-xs text-muted-foreground">
                          Treniruotės vyksta tik su jumis partneriaujančiose aikštelėse.
                        </div>
                      </div>
                    </label>
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="any_court" id="travel-any" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Galiu atvykti į bet kurią aikštelę</div>
                        <div className="text-xs text-muted-foreground">
                          Mokiniai gali užsisakyti treniruotę bet kokioje aikštelėje, ne tik partnerinėse.
                        </div>
                      </div>
                    </label>
                  </RadioGroup>
                </fieldset>

                <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                  <legend className="text-sm font-medium px-1">Aikštelės apmokėjimas</legend>
                  <p className="text-xs text-muted-foreground -mt-0.5">
                    Kas apmoka aikštelės nuomą už pamoką?
                  </p>
                  <RadioGroup
                    value={form.courtPaymentModel}
                    onValueChange={(v) =>
                      setForm((f) => ({ ...f, courtPaymentModel: v as CourtPaymentModel }))
                    }
                    className="space-y-2 pt-1"
                  >
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="student_pays_court" id="pay-student" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Mokinys moka už aikštelę</div>
                        <div className="text-xs text-muted-foreground">
                          Mokinys rezervuoja ir apmoka aikštelę atskirai. Jūs gaunate tik pamokos mokestį.
                        </div>
                      </div>
                    </label>
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="coach_pays_court" id="pay-coach" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Aš pats moku už aikštelę</div>
                        <div className="text-xs text-muted-foreground">
                          Jūs surenkate visą sumą ir pats atsiskaitote su aikštele iš savo dalies.
                        </div>
                      </div>
                    </label>
                  </RadioGroup>
                </fieldset>

                <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                  <legend className="text-sm font-medium px-1">Atšaukimo taisyklės</legend>
                  <p className="text-xs text-muted-foreground -mt-0.5">
                    Kiek grąžinama mokiniui, jei jis atšaukia pamoką. Aikštelės politika taikoma atskirai jos savininko.
                  </p>
                  <RadioGroup
                    value={form.cancellationPolicy}
                    onValueChange={(v) =>
                      setForm((f) => ({ ...f, cancellationPolicy: v as CoachCancellationPolicy }))
                    }
                    className="space-y-2 pt-1"
                  >
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="flexible" id="cancel-flexible" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Lankstu</div>
                        <div className="text-xs text-muted-foreground">
                          100% grąžinama, jei atšaukiama ne vėliau kaip 24 val. iki pamokos.
                        </div>
                      </div>
                    </label>
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="standard" id="cancel-standard" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Standartinis</div>
                        <div className="text-xs text-muted-foreground">
                          80% grąžinama anksčiau nei 48 val., 50% — anksčiau nei 24 val., 0% — vėliau.
                        </div>
                      </div>
                    </label>
                    <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                      <RadioGroupItem value="strict" id="cancel-strict" className="mt-0.5" />
                      <div className="flex-1 min-w-0">
                        <div className="text-sm font-medium">Griežtas</div>
                        <div className="text-xs text-muted-foreground">
                          Apmokėjimas negrąžinamas, jei pamoka atšaukiama bet kokiu laiku.
                        </div>
                      </div>
                    </label>
                  </RadioGroup>
                </fieldset>

                <div className="flex justify-end pt-2">
                  <Button
                    type="submit"
                    disabled={save.isPending || isViewingAs}
                    title={isViewingAs ? "Žiūrite kaip kitas treneris — keisti negalima" : undefined}
                  >
                    {save.isPending ? "Saugoma..." : "Išsaugoti"}
                  </Button>
                </div>
              </form>

              <CoachAffiliations />
            </TabsContent>

            <TabsContent value="hours" className="space-y-4">
              <CoachWeeklyHours />
            </TabsContent>

            <TabsContent value="blocks" className="space-y-4">
              <CoachBlockedSlots />
            </TabsContent>

            <TabsContent value="gallery" className="space-y-4">
              <div className="bg-card border rounded-2xl p-6 shadow-sm">
                <div className="flex items-center justify-between gap-3 mb-2">
                  <h2 className="text-base font-semibold flex items-center gap-2">
                    <Images className="w-4 h-4 text-primary" />
                    Nuotraukų galerija
                  </h2>
                  {!isViewingAs && (
                    <>
                      <input
                        id="settings-gallery-upload"
                        type="file"
                        accept="image/*"
                        className="sr-only"
                        disabled={uploading}
                        onChange={e => {
                          const file = e.target.files?.[0];
                          if (file) uploadGalleryPhoto(file);
                          e.target.value = "";
                        }}
                      />
                      <label htmlFor="settings-gallery-upload" className="cursor-pointer">
                        <Button size="sm" variant="outline" disabled={uploading} asChild>
                          <span>
                            {uploading
                              ? <Loader2 className="w-3.5 h-3.5 mr-1.5 animate-spin" />
                              : <Upload className="w-3.5 h-3.5 mr-1.5" />}
                            {uploading ? "Įkeliama..." : "Pridėti nuotrauką"}
                          </span>
                        </Button>
                      </label>
                    </>
                  )}
                </div>
                <p className="text-xs text-muted-foreground mb-4">
                  Nuotraukos rodomos jūsų viešame profilyje. Rekomenduojamas dydis — bent 800×600 px.
                </p>

                {galleryQ.isLoading ? (
                  <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    {Array.from({ length: 3 }).map((_, i) => (
                      <Skeleton key={i} className="aspect-[4/3] rounded-xl" />
                    ))}
                  </div>
                ) : (galleryQ.data?.length ?? 0) === 0 ? (
                  <div className="text-sm text-muted-foreground py-8 text-center bg-muted/30 rounded-lg border border-dashed">
                    Dar nėra nuotraukų. Pridėkite pirmą treniruotės akimirką.
                  </div>
                ) : (
                  <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    {galleryQ.data!.map((photo, idx) => (
                      <div key={photo.id} className="relative aspect-[4/3] rounded-xl overflow-hidden group">
                        <button
                          type="button"
                          onClick={() => setLightboxIdx(idx)}
                          className="absolute inset-0 w-full h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          <img
                            src={photo.url}
                            alt={photo.caption ?? `Nuotrauka ${idx + 1}`}
                            className="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                          />
                          {photo.caption && (
                            <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                              <p className="text-white text-[11px] truncate">{photo.caption}</p>
                            </div>
                          )}
                        </button>
                        {!isViewingAs && (
                          <button
                            type="button"
                            onClick={e => { e.stopPropagation(); deleteGalleryPhoto(photo.id); }}
                            disabled={deletingId === photo.id}
                            className="absolute top-1.5 right-1.5 z-10 p-1 rounded-full bg-black/50 hover:bg-red-600/80 text-white transition-colors opacity-0 group-hover:opacity-100 focus-visible:opacity-100"
                          >
                            {deletingId === photo.id
                              ? <Loader2 className="w-3.5 h-3.5 animate-spin" />
                              : <X className="w-3.5 h-3.5" />}
                          </button>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </TabsContent>
          </Tabs>
        )}
      </div>

      {lightboxIdx !== null && galleryQ.data && (
        <div
          className="fixed inset-0 z-[200] bg-black/90 flex items-center justify-center p-4"
          onClick={() => setLightboxIdx(null)}
        >
          <button
            type="button"
            className="absolute top-4 right-4 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
            onClick={() => setLightboxIdx(null)}
          >
            <X className="w-5 h-5" />
          </button>
          {!isViewingAs && galleryQ.data[lightboxIdx] && (
            <button
              type="button"
              disabled={deletingId === galleryQ.data[lightboxIdx].id}
              onClick={e => { e.stopPropagation(); deleteGalleryPhoto(galleryQ.data![lightboxIdx].id); }}
              className="absolute top-4 right-16 text-white/80 hover:text-red-400 p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
            >
              {deletingId === galleryQ.data[lightboxIdx].id
                ? <Loader2 className="w-5 h-5 animate-spin" />
                : <Trash2 className="w-5 h-5" />}
            </button>
          )}
          {lightboxIdx > 0 && (
            <button
              type="button"
              className="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
              onClick={e => { e.stopPropagation(); setLightboxIdx(lightboxIdx - 1); }}
            >
              <ChevronLeft className="w-6 h-6" />
            </button>
          )}
          {lightboxIdx < galleryQ.data.length - 1 && (
            <button
              type="button"
              className="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-2 rounded-full bg-black/30 hover:bg-black/60 transition-colors"
              onClick={e => { e.stopPropagation(); setLightboxIdx(lightboxIdx + 1); }}
            >
              <ChevronRight className="w-6 h-6" />
            </button>
          )}
          <div className="max-w-4xl max-h-full flex flex-col items-center gap-3" onClick={e => e.stopPropagation()}>
            <img
              src={galleryQ.data[lightboxIdx].url}
              alt={galleryQ.data[lightboxIdx].caption ?? `Nuotrauka ${lightboxIdx + 1}`}
              className="max-h-[80vh] max-w-full rounded-xl object-contain shadow-2xl"
            />
            {galleryQ.data[lightboxIdx].caption && (
              <p className="text-white/80 text-sm text-center">{galleryQ.data[lightboxIdx].caption}</p>
            )}
            <p className="text-white/40 text-xs">{lightboxIdx + 1} / {galleryQ.data.length}</p>
          </div>
        </div>
      )}
    </CoachLayout>
  );
}
