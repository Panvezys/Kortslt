import { useState } from "react";
import { useUser } from "@clerk/react";
import { useLocation } from "wouter";
import { useRole } from "@/lib/useRole";
import { useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
import { Checkbox } from "@/components/ui/checkbox";
import { useToast } from "@/hooks/use-toast";
import { validateEmail, validatePhone } from "@/lib/validators";
import { euroStringToCents } from "@/lib/money";
import { AvatarUpload } from "@/components/avatar-upload";
import { Link } from "wouter";
import {
  ArrowLeft, ArrowRight, CheckCircle2, Trophy, Loader2, Banknote,
} from "lucide-react";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const API = `${BASE}/api`;

const SPORT_OPTIONS = [
  { key: "tennis", label: "Tenisas" },
  { key: "basketball", label: "Krepšinis" },
  { key: "padel", label: "Padelis" },
  { key: "football", label: "Futbolas" },
  { key: "badminton", label: "Badmintonas" },
  { key: "squash", label: "Skvošas" },
  { key: "table_tennis", label: "Stalo tenisas" },
  { key: "golf", label: "Golfas" },
  { key: "volleyball", label: "Tinklinis" },
  { key: "swimming", label: "Plaukimas" },
];

const SPORT_LABEL = new Map(SPORT_OPTIONS.map((s) => [s.key, s.label]));

const AUDIENCE_OPTIONS = [
  { key: "kids", label: "Vaikai" },
  { key: "beginners", label: "Pradedantieji" },
  { key: "advanced", label: "Pažengę" },
  { key: "pros", label: "Profesionalai" },
] as const;

type AudienceKey = (typeof AUDIENCE_OPTIONS)[number]["key"];
type TravelPolicy = "any_court" | "affiliated_only";
type CancellationPolicy = "flexible" | "standard" | "strict";
type Step = 1 | 2 | 3 | 4;

interface FormData {
  name: string;
  email: string;
  phone: string;
  bio: string;
  photoUrl: string | null;
  // Per-sport audiences. Sport keys present here are the selected sports;
  // the array is the audience checkboxes for that sport.
  sportsAudiences: Record<string, AudienceKey[]>;
  experience: string;
  certifications: string;
  pricePerHour: string;
  travelPolicy: TravelPolicy;
  cancellationPolicy: CancellationPolicy;
}

const STEPS = ["Apie jus", "Sportas", "Kainodara", "Sąlygos"] as const;

export default function BecomeCoachPage() {
  const { user } = useUser();
  const [, setLocation] = useLocation();
  const { isPending, isCoach } = useRole();
  const { toast } = useToast();
  const qc = useQueryClient();

  const [step, setStep] = useState<Step>(1);
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);
  const [stripeStarting, setStripeStarting] = useState(false);

  const [form, setForm] = useState<FormData>({
    name: user?.fullName ?? "",
    email: user?.primaryEmailAddress?.emailAddress ?? "",
    phone: "",
    bio: "",
    photoUrl: null,
    sportsAudiences: {},
    experience: "",
    certifications: "",
    pricePerHour: "",
    travelPolicy: "affiliated_only",
    cancellationPolicy: "standard",
  });

  const set = <K extends keyof FormData>(field: K, value: FormData[K]) =>
    setForm((prev) => ({ ...prev, [field]: value }));

  const selectedSports = Object.keys(form.sportsAudiences);

  function toggleSport(key: string) {
    setForm((f) => {
      const next = { ...f.sportsAudiences };
      if (next[key]) delete next[key];
      else next[key] = [];
      return { ...f, sportsAudiences: next };
    });
  }

  function toggleAudience(sport: string, audience: AudienceKey) {
    setForm((f) => {
      const current = f.sportsAudiences[sport] ?? [];
      const next = current.includes(audience)
        ? current.filter((a) => a !== audience)
        : [...current, audience];
      return { ...f, sportsAudiences: { ...f.sportsAudiences, [sport]: next } };
    });
  }

  const emailError = validateEmail(form.email);
  const phoneError = validatePhone(form.phone, { required: false });
  const canNext1 =
    form.name.trim().length > 1 &&
    form.bio.trim().length > 20 &&
    !emailError &&
    !phoneError;
  // Step 2 valid: at least one sport AND every selected sport has at least
  // one audience checked. Avoids submitting "I teach tennis but I haven't said
  // to whom" — the marketplace filter would silently exclude this coach.
  const canNext2 =
    selectedSports.length > 0 &&
    selectedSports.every((s) => (form.sportsAudiences[s]?.length ?? 0) > 0);
  const canNext3 = form.pricePerHour.trim().length > 0;
  const canSubmit = canNext3 && !emailError && !phoneError;

  async function submit() {
    if (emailError) {
      toast({ title: "Klaida", description: emailError, variant: "destructive" });
      return;
    }
    if (phoneError) {
      toast({ title: "Klaida", description: phoneError, variant: "destructive" });
      return;
    }
    setSubmitting(true);
    try {
      const sportsAudiences = Object.entries(form.sportsAudiences).map(([sport, audiences]) => ({
        sport,
        audiences,
      }));
      const r = await fetch(`${API}/me/request-role`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          pendingRole: "coach",
          requestData: {
            name: form.name,
            email: form.email,
            phone: form.phone,
            bio: form.bio,
            photoUrl: form.photoUrl,
            sports: sportsAudiences.map((s) => s.sport),
            sportsAudiences,
            experience: form.experience,
            certifications: form.certifications,
            pricePerHour: euroStringToCents(form.pricePerHour),
            travelPolicy: form.travelPolicy,
            cancellationPolicy: form.cancellationPolicy,
          },
        }),
      });
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        throw new Error(err.error ?? "Klaida");
      }
      await qc.invalidateQueries({ queryKey: ["me-role"] });
      setDone(true);
    } catch (e: any) {
      toast({ title: "Klaida", description: e.message, variant: "destructive" });
    } finally {
      setSubmitting(false);
    }
  }

  async function startStripeOnboarding() {
    setStripeStarting(true);
    try {
      const r = await fetch(`${API}/coaches/stripe/onboard`, {
        method: "POST",
        credentials: "include",
      });
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        throw new Error(err.error ?? "Nepavyko pradėti Stripe registracijos");
      }
      const data = await r.json();
      window.location.href = data.url;
    } catch (e: any) {
      // The /coaches/stripe/onboard route is gated by requireCoach — when the
      // role is still pending it returns 403. In that case we redirect home
      // and let them complete onboarding later.
      toast({
        title: "Stripe registraciją užbaigsite vėliau",
        description:
          "Banko sąskaitą galėsite prijungti trenerio skydelyje, kai administratorius patvirtins jūsų prašymą.",
      });
      setStripeStarting(false);
    }
  }

  if (done) {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center px-4">
        <div className="max-w-md w-full text-center">
          <div className="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <CheckCircle2 className="w-8 h-8 text-primary" />
          </div>
          <h1 className="text-2xl font-extrabold text-foreground mb-3">Prašymas gautas!</h1>
          <p className="text-muted-foreground text-sm mb-6">
            Kol administratorius peržiūri jūsų anketą, prijunkite savo banko sąskaitą mokėjimams gauti — tai pagreitins
            jūsų pirmąją užklausą po patvirtinimo.
          </p>
          <Button
            onClick={startStripeOnboarding}
            disabled={stripeStarting}
            size="lg"
            className="w-full mb-3 h-14 text-base font-semibold"
          >
            {stripeStarting ? (
              <Loader2 className="w-5 h-5 mr-2 animate-spin" />
            ) : (
              <Banknote className="w-5 h-5 mr-2" />
            )}
            Prijungti banko sąskaitą
          </Button>
          <Button variant="outline" onClick={() => setLocation("/")} className="w-full">
            Grįžti į pagrindinį puslapį
          </Button>
        </div>
      </div>
    );
  }

  if (isPending || isCoach) {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center px-4">
        <div className="max-w-sm w-full text-center">
          <Trophy className="w-12 h-12 text-primary mx-auto mb-4" />
          <h2 className="text-xl font-bold mb-2">
            {isCoach ? "Jūs jau esate treneris!" : "Prašymas jau pateiktas"}
          </h2>
          <p className="text-muted-foreground text-sm mb-5">
            {isCoach
              ? "Valdykite savo profilį trenerio skydelyje."
              : "Jūsų trenerio prašymas šiuo metu peržiūrimas. Palaukite administratoriaus patvirtinimo."}
          </p>
          <Button onClick={() => setLocation(isCoach ? "/coach/dashboard" : "/")} className="w-full">
            {isCoach ? "Trenerio skydelis" : "Grįžti į pagrindinį"}
          </Button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      <div className="max-w-xl mx-auto px-4 py-12">
        <Link href="/welcome" className="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground mb-8 transition-colors">
          <ArrowLeft className="w-4 h-4" />
          Atgal
        </Link>

        <div className="mb-8">
          <div className="inline-flex items-center gap-2 bg-blue-500/10 text-blue-400 px-3 py-1.5 rounded-full text-xs font-semibold mb-4">
            <Trophy className="w-3.5 h-3.5" />
            Trenerio registracija
          </div>
          <h1 className="text-2xl font-extrabold text-foreground">Tapkite treneriu korts.lt</h1>
          <p className="text-muted-foreground text-sm mt-1.5">
            Užpildykite formą — administratorius peržiūrės per 24 val.
          </p>
        </div>

        {/* Step indicator */}
        <div className="flex items-center gap-2 mb-8">
          {STEPS.map((label, i) => {
            const idx = i + 1;
            const active = idx === step;
            const isDone = idx < step;
            return (
              <div key={label} className="flex items-center gap-2">
                <div
                  className={`flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors ${
                    active
                      ? "bg-primary text-primary-foreground"
                      : isDone
                      ? "bg-primary/20 text-primary"
                      : "bg-muted text-muted-foreground"
                  }`}
                >
                  <span className="w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold">
                    {isDone ? <CheckCircle2 className="w-3.5 h-3.5" /> : idx}
                  </span>
                  <span className="hidden sm:inline">{label}</span>
                </div>
                {i < STEPS.length - 1 && (
                  <div className={`h-px flex-1 w-6 transition-colors ${isDone ? "bg-primary/40" : "bg-border"}`} />
                )}
              </div>
            );
          })}
        </div>

        {/* Step 1: About */}
        {step === 1 && (
          <div className="space-y-5">
            <div className="rounded-2xl border bg-card p-4">
              <AvatarUpload
                value={form.photoUrl}
                onChange={(p) => set("photoUrl", p)}
                onClear={() => set("photoUrl", null)}
              />
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">Vardas ir pavardė *</label>
              <Input
                value={form.name}
                onChange={(e) => set("name", e.target.value)}
                placeholder="Jonas Jonaitis"
              />
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">El. paštas *</label>
              <Input
                type="email"
                value={form.email}
                onChange={(e) => set("email", e.target.value)}
                placeholder="jonas@example.lt"
              />
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">Telefono numeris</label>
              <Input
                type="tel"
                value={form.phone}
                onChange={(e) => set("phone", e.target.value)}
                placeholder="+370 600 00000"
              />
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">
                Apie jus *
                <span className="text-muted-foreground font-normal ml-1 text-xs">(min. 20 simbolių)</span>
              </label>
              <Textarea
                value={form.bio}
                onChange={(e) => set("bio", e.target.value)}
                placeholder="Esu sertifikuotas teniso treneris su 10 metų patirtimi..."
                rows={5}
              />
              <p className="text-xs text-muted-foreground mt-1">
                Patarimas: Paminėkite savo treniravimo stilių ir su kokio lygio žaidėjais dirbate (pradedantieji, pažengę).
              </p>
              <p className="text-[11px] text-muted-foreground mt-0.5">{form.bio.length} / 500 simbolių</p>
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">Patirtis (metai)</label>
              <Input
                type="number"
                min="0"
                max="50"
                value={form.experience}
                onChange={(e) => set("experience", e.target.value)}
                placeholder="pvz.: 5"
              />
            </div>

            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">Sertifikatai / kvalifikacija</label>
              <Input
                value={form.certifications}
                onChange={(e) => set("certifications", e.target.value)}
                placeholder="pvz.: LTF A lygio treneris, UEFA C licencija"
              />
            </div>

            <Button className="w-full" disabled={!canNext1} onClick={() => setStep(2)}>
              Toliau
              <ArrowRight className="w-4 h-4 ml-1.5" />
            </Button>
          </div>
        )}

        {/* Step 2: Sports + per-sport audiences */}
        {step === 2 && (
          <div className="space-y-5">
            <div>
              <label className="text-sm font-medium text-foreground block mb-3">
                Kurį sportą treniruojate? *
                <span className="text-muted-foreground font-normal ml-1 text-xs">
                  (pasirinkite bent vieną ir nurodykite kokio lygio žaidėjus)
                </span>
              </label>
              <div className="space-y-3">
                {SPORT_OPTIONS.map((s) => {
                  const sel = selectedSports.includes(s.key);
                  const audiences = form.sportsAudiences[s.key] ?? [];
                  return (
                    <div
                      key={s.key}
                      className={`rounded-xl border transition-colors ${
                        sel ? "border-primary bg-primary/5" : "border-border"
                      }`}
                    >
                      <button
                        type="button"
                        onClick={() => toggleSport(s.key)}
                        className="w-full flex items-center gap-2 px-4 py-3 text-sm font-medium text-left"
                      >
                        {sel ? (
                          <CheckCircle2 className="w-4 h-4 text-primary shrink-0" />
                        ) : (
                          <span className="w-4 h-4 rounded-full border border-muted-foreground/40 shrink-0" />
                        )}
                        {s.label}
                      </button>
                      {sel && (
                        <div className="border-t border-primary/20 px-4 py-3 bg-background/40">
                          <p className="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-2">
                            Tikslinė auditorija
                          </p>
                          <div className="grid grid-cols-2 gap-2">
                            {AUDIENCE_OPTIONS.map((a) => {
                              const checked = audiences.includes(a.key);
                              return (
                                <label
                                  key={a.key}
                                  className="flex items-center gap-2 text-sm cursor-pointer hover:opacity-80"
                                >
                                  <Checkbox
                                    checked={checked}
                                    onCheckedChange={() => toggleAudience(s.key, a.key)}
                                  />
                                  {a.label}
                                </label>
                              );
                            })}
                          </div>
                          {audiences.length === 0 && (
                            <p className="text-[11px] text-amber-600 dark:text-amber-400 mt-2">
                              Pasirinkite bent vieną auditoriją šiam sportui.
                            </p>
                          )}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
            <div className="flex gap-3">
              <Button variant="outline" className="flex-1" onClick={() => setStep(1)}>
                <ArrowLeft className="w-4 h-4 mr-1.5" />
                Atgal
              </Button>
              <Button className="flex-1" disabled={!canNext2} onClick={() => setStep(3)}>
                Toliau
                <ArrowRight className="w-4 h-4 ml-1.5" />
              </Button>
            </div>
          </div>
        )}

        {/* Step 3: Pricing */}
        {step === 3 && (
          <div className="space-y-5">
            <div>
              <label className="text-sm font-medium text-foreground block mb-1.5">
                Valandinis įkainis (€) *
              </label>
              <div className="relative">
                <span className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">€</span>
                <Input
                  type="number"
                  min="1"
                  max="500"
                  step="0.5"
                  className="pl-8"
                  value={form.pricePerHour}
                  onChange={(e) => set("pricePerHour", e.target.value)}
                  placeholder="30"
                />
              </div>
              <p className="text-xs text-muted-foreground mt-1">Įveskite eurais — sistema saugo centais.</p>
            </div>

            <div className="rounded-xl border border-primary/30 bg-primary/5 p-4">
              <p className="text-sm font-medium mb-1">Tvarkaraštis</p>
              <p className="text-xs text-muted-foreground">
                Tikslų savo tvarkaraštį galėsite nustatyti savo trenerio skydelyje po registracijos patvirtinimo —
                ten pamatysite kalendoriaus formą su savaitės valandomis ir vienkartinėmis pertraukomis.
              </p>
            </div>

            <div className="flex gap-3">
              <Button variant="outline" className="flex-1" onClick={() => setStep(2)}>
                <ArrowLeft className="w-4 h-4 mr-1.5" />
                Atgal
              </Button>
              <Button className="flex-1" disabled={!canNext3} onClick={() => setStep(4)}>
                Toliau
                <ArrowRight className="w-4 h-4 ml-1.5" />
              </Button>
            </div>
          </div>
        )}

        {/* Step 4: Policies */}
        {step === 4 && (
          <div className="space-y-5">
            <fieldset className="rounded-2xl border bg-card p-4 space-y-2">
              <legend className="text-sm font-medium px-1">Kelionių politika</legend>
              <p className="text-xs text-muted-foreground -mt-0.5">Kur galite vesti treniruotes?</p>
              <RadioGroup
                value={form.travelPolicy}
                onValueChange={(v) => set("travelPolicy", v as TravelPolicy)}
                className="space-y-2 pt-1"
              >
                <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                  <RadioGroupItem value="affiliated_only" id="travel-affiliated" className="mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-medium">Treniruoju tik savo pasirinktose aikštelėse</div>
                    <div className="text-xs text-muted-foreground">
                      Vėliau galėsite išsiųsti partnerystės užklausas aikštelių savininkams.
                    </div>
                  </div>
                </label>
                <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                  <RadioGroupItem value="any_court" id="travel-any" className="mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-medium">Galiu atvykti į bet kurią aikštelę</div>
                    <div className="text-xs text-muted-foreground">
                      Mokiniai galės jus pridėti rezervacijai bet kokioje aikštelėje.
                    </div>
                  </div>
                </label>
              </RadioGroup>
            </fieldset>

            <fieldset className="rounded-2xl border bg-card p-4 space-y-2">
              <legend className="text-sm font-medium px-1">Atšaukimo taisyklės</legend>
              <p className="text-xs text-muted-foreground -mt-0.5">
                Kiek mokinio sumos grąžinama, jei jis atšaukia pamoką?
              </p>
              <RadioGroup
                value={form.cancellationPolicy}
                onValueChange={(v) => set("cancellationPolicy", v as CancellationPolicy)}
                className="space-y-2 pt-1"
              >
                <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                  <RadioGroupItem value="flexible" id="cancel-flexible" className="mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-medium">Lanksti</div>
                    <div className="text-xs text-muted-foreground">100% grąžinama iki 24 val. iki pamokos.</div>
                  </div>
                </label>
                <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                  <RadioGroupItem value="standard" id="cancel-standard" className="mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-medium">Standartinė</div>
                    <div className="text-xs text-muted-foreground">
                      80% anksčiau nei 48 val., 50% anksčiau nei 24 val., 0% vėliau.
                    </div>
                  </div>
                </label>
                <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                  <RadioGroupItem value="strict" id="cancel-strict" className="mt-0.5" />
                  <div className="flex-1 min-w-0">
                    <div className="text-sm font-medium">Griežta</div>
                    <div className="text-xs text-muted-foreground">Apmokėjimas negrąžinamas.</div>
                  </div>
                </label>
              </RadioGroup>
            </fieldset>

            {/* Summary */}
            <div className="bg-muted/50 border border-border rounded-xl p-4 space-y-1.5">
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1">Santrauka</p>
              <p className="text-sm">
                <span className="text-muted-foreground">Vardas:</span>{" "}
                <span className="font-medium">{form.name}</span>
              </p>
              <p className="text-sm">
                <span className="text-muted-foreground">Sportas:</span>{" "}
                <span className="font-medium">
                  {selectedSports.map((s) => SPORT_LABEL.get(s) ?? s).join(", ")}
                </span>
              </p>
              {form.pricePerHour && (
                <p className="text-sm">
                  <span className="text-muted-foreground">Kaina:</span>{" "}
                  <span className="font-medium">€{form.pricePerHour}/val.</span>
                </p>
              )}
            </div>

            <div className="flex gap-3">
              <Button variant="outline" className="flex-1" onClick={() => setStep(3)}>
                <ArrowLeft className="w-4 h-4 mr-1.5" />
                Atgal
              </Button>
              <Button className="flex-1" disabled={!canSubmit || submitting} onClick={submit}>
                {submitting ? (
                  <Loader2 className="w-4 h-4 mr-1.5 animate-spin" />
                ) : (
                  <CheckCircle2 className="w-4 h-4 mr-1.5" />
                )}
                Pateikti prašymą
              </Button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
