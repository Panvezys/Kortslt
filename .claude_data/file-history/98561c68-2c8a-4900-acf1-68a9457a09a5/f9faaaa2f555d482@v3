import { useState, useEffect, type FormEvent } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { CoachLayout } from "@/components/coach-layout";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Switch } from "@/components/ui/switch";
import { Skeleton } from "@/components/ui/skeleton";
import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
import { useToast } from "@/hooks/use-toast";
import { customFetch } from "@workspace/api-client-react";
import { centsToEuroString } from "@/lib/money";
import { useViewAsCoach, withCoachViewAs } from "@/lib/view-as-coach";
import { CoachAffiliations } from "@/components/coach-affiliations";
import { PromoteButton } from "@/components/promote-button";
import { Plus, X, AlertTriangle, ExternalLink } from "lucide-react";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const API = `${BASE}/api`;

type TravelPolicy = "any_court" | "affiliated_only";
type CourtPaymentModel = "student_pays_court" | "coach_pays_court";
type CoachCancellationPolicy = "flexible" | "standard" | "strict";

interface MyCoachProfile {
  id: number;
  userId: string;
  name: string;
  email: string;
  bio?: string | null;
  phone?: string | null;
  pricePerHour?: number | null;
  isAcceptingStudents?: boolean;
  experienceYears?: number | null;
  qualifications?: string[];
  sports?: string[];
  travelPolicy?: TravelPolicy;
  courtPaymentModel?: CourtPaymentModel;
  cancellationPolicy?: CoachCancellationPolicy;
  promotedUntil?: string | null;
}

interface FormState {
  bio: string;
  experienceYears: string;
  qualifications: string[];
  isAcceptingStudents: boolean;
  travelPolicy: TravelPolicy;
  courtPaymentModel: CourtPaymentModel;
  cancellationPolicy: CoachCancellationPolicy;
}

const EMPTY_FORM: FormState = {
  bio: "",
  experienceYears: "",
  qualifications: [],
  isAcceptingStudents: true,
  travelPolicy: "affiliated_only",
  courtPaymentModel: "student_pays_court",
  cancellationPolicy: "standard",
};

const MAX_QUALIFICATIONS = 20;
const MAX_QUALIFICATION_LENGTH = 200;

export default function CoachSettings() {
  const { toast } = useToast();
  const qc = useQueryClient();

  const { asCoachId } = useViewAsCoach();
  const isViewingAs = asCoachId != null;
  const { data: profile, isLoading } = useQuery<MyCoachProfile>({
    queryKey: ["coach-me-profile", asCoachId],
    queryFn: () => customFetch<MyCoachProfile>(withCoachViewAs(`${API}/coaches/me`)),
    staleTime: 60_000,
  });

  // Live Stripe Connect status. The endpoint performs a live retrieve against
  // Stripe and reconciles user_profiles.stripeAccountStatus, so just loading
  // this page is enough to pull the coach out of the marketplace shadow as
  // soon as Stripe flips them back to "active".
  type StripeStatusValue = "not_connected" | "pending" | "active";
  const { data: stripeStatus } = useQuery<{
    status: StripeStatusValue;
    accountId: string | null;
    disabledReason?: string | null;
  }>({
    queryKey: ["stripe-connect-status"],
    queryFn: () => customFetch(`${API}/stripe/connect/status`),
  });
  const isHiddenFromMarketplace =
    stripeStatus != null && stripeStatus.status !== "active";

  // Re-check Stripe state whenever the tab regains focus (e.g. after the
  // coach completes onboarding in a Stripe popup). Same pattern owner-facilities
  // uses so the banner clears without a manual reload.
  useEffect(() => {
    const onFocus = () => {
      qc.invalidateQueries({ queryKey: ["stripe-connect-status"] });
    };
    window.addEventListener("focus", onFocus);
    return () => window.removeEventListener("focus", onFocus);
  }, [qc]);

  const [stripeOpening, setStripeOpening] = useState(false);
  const openStripeConnect = async () => {
    setStripeOpening(true);
    try {
      const r = await customFetch<{ url: string }>(`${API}/stripe/connect`, {
        method: "POST",
      });
      window.open(r.url, "_blank", "noopener,noreferrer");
    } catch (err) {
      toast({
        title: "Klaida atidarant Stripe",
        description: (err as Error).message,
        variant: "destructive",
      });
    } finally {
      setStripeOpening(false);
    }
  };

  const [form, setForm] = useState<FormState>(EMPTY_FORM);

  // Seed the form from the server response once it arrives. We render an
  // empty form before profile loads — Inputs need string values, not null.
  useEffect(() => {
    if (!profile) return;
    setForm({
      bio: profile.bio ?? "",
      experienceYears:
        profile.experienceYears != null ? String(profile.experienceYears) : "",
      qualifications: profile.qualifications ?? [],
      isAcceptingStudents: profile.isAcceptingStudents ?? true,
      travelPolicy: profile.travelPolicy ?? "affiliated_only",
      courtPaymentModel: profile.courtPaymentModel ?? "student_pays_court",
      cancellationPolicy: profile.cancellationPolicy ?? "standard",
    });
  }, [profile]);

  const save = useMutation({
    mutationFn: async () => {
      // The /coaches/me PUT endpoint expects the full upsert body — name and
      // email are required by the zod schema, so we include them unchanged
      // from the server-known profile.
      if (!profile) throw new Error("Profilis dar nepasiruošė");
      return customFetch<MyCoachProfile>(`${API}/coaches/me`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: profile.name,
          email: profile.email,
          bio: form.bio || null,
          // pricePerHour intentionally not sent — server derives it from
          // active coach_services. See lib/coach-pricing.ts.
          experienceYears:
            form.experienceYears && Number.isFinite(Number(form.experienceYears))
              ? Math.max(0, Math.round(Number(form.experienceYears)))
              : null,
          qualifications: form.qualifications
            .map((q) => q.trim())
            .filter((q) => q.length > 0)
            .slice(0, MAX_QUALIFICATIONS),
          isAcceptingStudents: form.isAcceptingStudents,
          travelPolicy: form.travelPolicy,
          courtPaymentModel: form.courtPaymentModel,
          cancellationPolicy: form.cancellationPolicy,
        }),
      });
    },
    onSuccess: () => {
      toast({ title: "Profilis išsaugotas" });
      qc.invalidateQueries({ queryKey: ["coach-me-profile"] });
      qc.invalidateQueries({ queryKey: ["coach"] });
      qc.invalidateQueries({ queryKey: ["coaches"] });
    },
    onError: (e: Error) => {
      toast({ title: "Klaida", description: e.message, variant: "destructive" });
    },
  });

  function onSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (save.isPending) return;
    save.mutate();
  }

  return (
    <CoachLayout title="Nustatymai">
      <div className="px-4 md:px-6 py-6 max-w-2xl space-y-8">
        <header className="flex flex-col gap-1">
          <h1 className="text-2xl font-semibold tracking-tight">Nustatymai</h1>
          <p className="text-sm text-muted-foreground">
            Atnaujinkite savo trenerio profilio detales, valandinę kainą ir prieinamumą.
          </p>
        </header>

        {isHiddenFromMarketplace && (
          <div
            role="alert"
            className="rounded-2xl border-2 border-destructive/40 bg-destructive/10 p-4 flex items-start gap-3"
          >
            <AlertTriangle className="w-5 h-5 text-destructive shrink-0 mt-0.5" />
            <div className="flex-1 min-w-0 space-y-2">
              <p className="text-sm font-semibold text-destructive">
                ⚠️ Jūsų profilis yra paslėptas nuo žaidėjų
              </p>
              <p className="text-sm text-destructive/90">
                Prijunkite arba atnaujinkite banko sąskaitos informaciją, kad galėtumėte priimti užsakymus.
                Paslaugų katalogą galite ruošti ir dabar — jis taps matomas iškart, kai Stripe sąskaita bus aktyvuota.
              </p>
              {stripeStatus?.disabledReason && (
                <p className="text-xs text-destructive/80">
                  Stripe priežastis: <code className="font-mono">{stripeStatus.disabledReason}</code>
                </p>
              )}
              <Button
                size="sm"
                variant="destructive"
                onClick={openStripeConnect}
                disabled={stripeOpening}
              >
                {stripeStatus?.status === "pending"
                  ? "Užbaigti Stripe sąskaitos patvirtinimą"
                  : "Prijungti banko sąskaitą"}
                <ExternalLink className="w-3.5 h-3.5 ml-1.5" />
              </Button>
            </div>
          </div>
        )}

        {isLoading ? (
          <div className="space-y-4">
            <Skeleton className="h-10" />
            <Skeleton className="h-24" />
            <Skeleton className="h-10" />
            <Skeleton className="h-10" />
          </div>
        ) : !profile ? (
          <div className="rounded-2xl border bg-card px-6 py-10 text-center text-sm text-muted-foreground">
            Trenerio profilio dar nėra.
          </div>
        ) : (
          <>
            <div className="rounded-2xl border bg-card px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <h2 className="text-sm font-semibold">Iškelti paieškoje</h2>
                <p className="text-xs text-muted-foreground mt-0.5">
                  Jūsų profilis 7 dienas bus rodomas pirmiausia trenerių sąraše.
                </p>
              </div>
              <PromoteButton
                targetType="coach"
                targetId={profile.id}
                promotedUntil={profile.promotedUntil}
                size="sm"
              />
            </div>

            <form onSubmit={onSubmit} className="space-y-5">
              <div className="space-y-1.5">
                <Label htmlFor="bio">Apie mane</Label>
                <Textarea
                  id="bio"
                  rows={4}
                  value={form.bio}
                  onChange={(e) => setForm((f) => ({ ...f, bio: e.target.value }))}
                  placeholder="Trumpa biografija, treniravimo stilius, pasiekimai..."
                />
              </div>

              <div className="rounded-lg border bg-muted/30 px-3 py-2.5 flex items-start gap-3">
                <div className="flex-1 min-w-0">
                  <div className="text-[10px] uppercase tracking-widest text-muted-foreground font-semibold">
                    Bazinė valandinė kaina paieškoje
                  </div>
                  <div className="text-base font-semibold">
                    {profile?.pricePerHour != null && profile.pricePerHour > 0
                      ? `${centsToEuroString(profile.pricePerHour)} €/val.`
                      : "—"}
                  </div>
                  <p className="text-[11px] text-muted-foreground mt-0.5">
                    Apskaičiuojama automatiškai pagal pigiausią aktyvią jūsų paslaugą.
                    Kainas keiskite profilio puslapyje skiltyje „Mano paslaugos".
                  </p>
                </div>
              </div>

              <div className="space-y-1.5">
                <Label htmlFor="experience">Patirtis (metais)</Label>
                <Input
                  id="experience"
                  type="number"
                  min={0}
                  step={1}
                  value={form.experienceYears}
                  onChange={(e) =>
                    setForm((f) => ({ ...f, experienceYears: e.target.value }))
                  }
                  placeholder="5"
                />
              </div>

              <div className="space-y-2">
                <Label>Kvalifikacijos</Label>
                <p className="text-[11px] text-muted-foreground -mt-1">
                  Sertifikatai, licencijos, diplomai. Vienas įrašas — viena eilutė.
                </p>
                <div className="space-y-2">
                  {form.qualifications.map((q, idx) => (
                    <div key={idx} className="flex gap-2">
                      <Input
                        value={q}
                        maxLength={MAX_QUALIFICATION_LENGTH}
                        onChange={(e) =>
                          setForm((f) => {
                            const next = [...f.qualifications];
                            next[idx] = e.target.value;
                            return { ...f, qualifications: next };
                          })
                        }
                        placeholder="pvz. Lietuvos padelio federacijos treneris"
                      />
                      <Button
                        type="button"
                        size="icon"
                        variant="ghost"
                        onClick={() =>
                          setForm((f) => ({
                            ...f,
                            qualifications: f.qualifications.filter((_, i) => i !== idx),
                          }))
                        }
                        aria-label="Pašalinti kvalifikaciją"
                      >
                        <X className="w-4 h-4" />
                      </Button>
                    </div>
                  ))}
                </div>
                <Button
                  type="button"
                  variant="outline"
                  size="sm"
                  disabled={form.qualifications.length >= MAX_QUALIFICATIONS}
                  onClick={() =>
                    setForm((f) => ({
                      ...f,
                      qualifications: [...f.qualifications, ""],
                    }))
                  }
                >
                  <Plus className="w-4 h-4 mr-1.5" />
                  Pridėti kvalifikaciją
                </Button>
              </div>

              <div className="flex items-center justify-between rounded-2xl border bg-card px-4 py-3">
                <div>
                  <Label htmlFor="accepting" className="text-sm font-medium">
                    Priimu naujus mokinius
                  </Label>
                  <p className="text-xs text-muted-foreground mt-0.5">
                    Kai išjungta, jūsų profilis lieka matomas, bet nepriimsite naujų užklausų.
                  </p>
                </div>
                <Switch
                  id="accepting"
                  checked={form.isAcceptingStudents}
                  onCheckedChange={(checked) =>
                    setForm((f) => ({ ...f, isAcceptingStudents: checked }))
                  }
                />
              </div>

              <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                <legend className="text-sm font-medium px-1">Kelionių politika</legend>
                <p className="text-xs text-muted-foreground -mt-0.5">
                  Pasirinkite, kur galite vesti treniruotes.
                </p>
                <RadioGroup
                  value={form.travelPolicy}
                  onValueChange={(v) =>
                    setForm((f) => ({ ...f, travelPolicy: v as TravelPolicy }))
                  }
                  className="space-y-2 pt-1"
                >
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="affiliated_only" id="travel-affiliated" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Tik pasirinktose aikštelėse</div>
                      <div className="text-xs text-muted-foreground">
                        Treniruotės vyksta tik su jumis partneriaujančiose aikštelėse.
                      </div>
                    </div>
                  </label>
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="any_court" id="travel-any" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Galiu atvykti į bet kurią aikštelę</div>
                      <div className="text-xs text-muted-foreground">
                        Mokiniai gali užsisakyti treniruotę bet kokioje aikštelėje, ne tik partnerinėse.
                      </div>
                    </div>
                  </label>
                </RadioGroup>
              </fieldset>

              <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                <legend className="text-sm font-medium px-1">Aikštelės apmokėjimas</legend>
                <p className="text-xs text-muted-foreground -mt-0.5">
                  Kas apmoka aikštelės nuomą už pamoką?
                </p>
                <RadioGroup
                  value={form.courtPaymentModel}
                  onValueChange={(v) =>
                    setForm((f) => ({ ...f, courtPaymentModel: v as CourtPaymentModel }))
                  }
                  className="space-y-2 pt-1"
                >
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="student_pays_court" id="pay-student" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Mokinys moka už aikštelę</div>
                      <div className="text-xs text-muted-foreground">
                        Mokinys rezervuoja ir apmoka aikštelę atskirai. Jūs gaunate tik pamokos mokestį.
                      </div>
                    </div>
                  </label>
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="coach_pays_court" id="pay-coach" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Aš pats moku už aikštelę</div>
                      <div className="text-xs text-muted-foreground">
                        Jūs surenkate visą sumą ir pats atsiskaitote su aikštele iš savo dalies.
                      </div>
                    </div>
                  </label>
                </RadioGroup>
              </fieldset>

              <fieldset className="space-y-2 rounded-2xl border bg-card p-4">
                <legend className="text-sm font-medium px-1">Atšaukimo taisyklės</legend>
                <p className="text-xs text-muted-foreground -mt-0.5">
                  Kiek grąžinama mokiniui, jei jis atšaukia pamoką. Aikštelės politika taikoma atskirai jos savininko.
                </p>
                <RadioGroup
                  value={form.cancellationPolicy}
                  onValueChange={(v) =>
                    setForm((f) => ({ ...f, cancellationPolicy: v as CoachCancellationPolicy }))
                  }
                  className="space-y-2 pt-1"
                >
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="flexible" id="cancel-flexible" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Lankstu</div>
                      <div className="text-xs text-muted-foreground">
                        100% grąžinama, jei atšaukiama ne vėliau kaip 24 val. iki pamokos.
                      </div>
                    </div>
                  </label>
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="standard" id="cancel-standard" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Standartinis</div>
                      <div className="text-xs text-muted-foreground">
                        80% grąžinama anksčiau nei 48 val., 50% — anksčiau nei 24 val., 0% — vėliau.
                      </div>
                    </div>
                  </label>
                  <label className="flex items-start gap-3 rounded-lg border p-3 cursor-pointer hover:bg-muted/40 transition-colors">
                    <RadioGroupItem value="strict" id="cancel-strict" className="mt-0.5" />
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium">Griežtas</div>
                      <div className="text-xs text-muted-foreground">
                        Apmokėjimas negrąžinamas, jei pamoka atšaukiama bet kokiu laiku.
                      </div>
                    </div>
                  </label>
                </RadioGroup>
              </fieldset>

              <div className="flex justify-end pt-2">
                <Button type="submit" disabled={save.isPending || isViewingAs} title={isViewingAs ? "Žiūrite kaip kitas treneris — keisti negalima" : undefined}>
                  {save.isPending ? "Saugoma..." : "Išsaugoti"}
                </Button>
              </div>
            </form>

            <CoachAffiliations />
          </>
        )}
      </div>
    </CoachLayout>
  );
}
