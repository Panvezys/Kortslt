async function seedFacilities(): Promise<Map<string, { facilityId: number; courts: Array<{ id: number; type: string }> }>> {
  const result = new Map<string, { facilityId: number; courts: Array<{ id: number; type: string }> }>();

  for (const f of FACILITIES) {
    const ownerUserId = `${DEMO_PREFIX}owner-${f.key}`;

    // Upsert facility — keyed on owner_user_id + name so re-runs don't dupe.
    const existing = await db
      .select({ id: facilitiesTable.id })
      .from(facilitiesTable)
      .where(and(eq(facilitiesTable.ownerUserId, ownerUserId), eq(facilitiesTable.name, f.name)));

    let facilityId: number;
    if (existing.length > 0) {
      facilityId = existing[0].id;
      await db
        .update(facilitiesTable)
        .set({
          city: f.city,
          address: f.address,
          postcode: f.postcode,
          latitude: f.latitude,
          longitude: f.longitude,
          description: f.description,
          verificationStatus: "active",
          adminVerified: true,
        })
        .where(eq(facilitiesTable.id, facilityId));
      console.log(`  ↻ Facility "${f.name}" — id=${facilityId}`);
    } else {
      const [row] = await db
        .insert(facilitiesTable)
        .values({
          name: f.name,
          ownerUserId,
          city: f.city,
          address: f.address,
          postcode: f.postcode,
          latitude: f.latitude,
          longitude: f.longitude,
          description: f.description,
          verificationStatus: "active",
          adminVerified: true,
        })
        .returning({ id: facilitiesTable.id });
      facilityId = row.id;
      console.log(`  ✓ Facility "${f.name}" — id=${facilityId}`);
    }

    // Insert courts (upsert by facility+name)
    const courts: Array<{ id: number; type: string }> = [];
    for (const c of f.courts) {
      const existingCourt = await db
        .select({ id: courtsTable.id })
        .from(courtsTable)
        .where(and(eq(courtsTable.facilityId, facilityId), eq(courtsTable.name, c.name)));

      let courtId: number;
      if (existingCourt.length > 0) {
        courtId = existingCourt[0].id;
        await db
          .update(courtsTable)
          .set({
            type: c.type,
            pricePerHour: String(c.pricePerHour),
            isIndoor: c.isIndoor,
            surface: c.surface,
            status: "approved",
          })
          .where(eq(courtsTable.id, courtId));
      } else {
        const [row] = await db
          .insert(courtsTable)
          .values({
            name: c.name,
            type: c.type,
            facilityId,
            pricePerHour: String(c.pricePerHour),
            isIndoor: c.isIndoor,
            surface: c.surface,
            status: "approved",
            description: `${c.name} · ${f.city}`,
          })
          .returning({ id: courtsTable.id });
        courtId = row.id;
      }
      courts.push({ id: courtId, type: c.type });
    }
    console.log(`    └─ ${courts.length} courts ready`);
    result.set(f.key, { facilityId, courts });
  }

  return result;
}

async function seedCoaches(
  facilityMap: Map<string, { facilityId: number; courts: Array<{ id: number; type: string }> }>,
) {
  // Weekly availability — every coach gets the same generic schedule
  // (Mon-Fri 09:00-21:00, Sat 10:00-18:00). The marketplace's availability
  // filter exercises this when a player picks date+time+duration.
  const WEEKLY: Array<{ dayOfWeek: number; startTime: string; endTime: string }> = [
    { dayOfWeek: 1, startTime: "09:00", endTime: "21:00" },
    { dayOfWeek: 2, startTime: "09:00", endTime: "21:00" },
    { dayOfWeek: 3, startTime: "09:00", endTime: "21:00" },
    { dayOfWeek: 4, startTime: "09:00", endTime: "21:00" },
    { dayOfWeek: 5, startTime: "09:00", endTime: "21:00" },
    { dayOfWeek: 6, startTime: "10:00", endTime: "18:00" },
  ];

  for (const c of COACHES) {
    const userId = `${DEMO_PREFIX}coach-${c.key}`;
    const sports = c.sportsAudiences.map((s) => s.sport);

    // Upsert coach by userId (which has a unique constraint).
    const existing = await db.select({ id: coachesTable.id })
      .from(coachesTable).where(eq(coachesTable.userId, userId));

    let coachId: number;
    if (existing.length > 0) {
      coachId = existing[0].id;
      await db.update(coachesTable).set({
        name: c.name,
        email: c.email,
        bio: c.bio,
        photoUrl: c.photoUrl ?? null,
        pricePerHour: c.pricePerHour * 100, // integer cents
        sports,
        experienceYears: c.experienceYears,
        travelPolicy: c.travelPolicy,
        cancellationPolicy: c.cancellationPolicy,
        status: "approved",
        isAcceptingStudents: true,
      }).where(eq(coachesTable.id, coachId));
    } else {
      const [row] = await db.insert(coachesTable).values({
        userId,
        name: c.name,
        email: c.email,
        bio: c.bio,
        photoUrl: c.photoUrl ?? null,
        pricePerHour: c.pricePerHour * 100,
        sports,
        experienceYears: c.experienceYears,
        travelPolicy: c.travelPolicy,
        cancellationPolicy: c.cancellationPolicy,
        status: "approved",
        isAcceptingStudents: true,
      }).returning({ id: coachesTable.id });
      coachId = row.id;
    }
    console.log(`  ✓ Coach "${c.name}" — id=${coachId} (${c.travelPolicy}, ${c.cancellationPolicy})`);

    // Replace-all sync of coach_sports junction.
    await db.delete(coachSportsTable).where(eq(coachSportsTable.coachId, coachId));
    if (c.sportsAudiences.length > 0) {
      await db.insert(coachSportsTable).values(
        c.sportsAudiences.map((s) => ({
          coachId,
          sport: s.sport,
          audiences: s.audiences,
        })),
      );
    }

    // Wire court_coaches: link the coach to every court at their affiliated
    // facilities whose sport matches one the coach teaches.
    await db.delete(courtCoachesTable).where(eq(courtCoachesTable.coachId, coachId));
    const links: Array<{ coachId: number; courtId: number }> = [];
    for (const facilityKey of c.facilityKeys) {
      const facility = facilityMap.get(facilityKey);
      if (!facility) continue;
      for (const court of facility.courts) {
        if (sports.includes(court.type)) {
          links.push({ coachId, courtId: court.id });
        }
      }
    }
    if (links.length > 0) {
      await db.insert(courtCoachesTable).values(links).onConflictDoNothing();
    }
    console.log(`    └─ ${links.length} court affiliations`);

    // Refresh weekly availability — clear and rebuild so the coach has slots
    // the marketplace availability filter can match against.
    await db.delete(coachAvailabilitiesTable).where(eq(coachAvailabilitiesTable.coachId, coachId));
    await db.insert(coachAvailabilitiesTable).values(
      WEEKLY.map((w) => ({ coachId, ...w })),
    );
  }
}

async function main() {
  console.log("→ Seeding demo facilities…");
  const facilityMap = await seedFacilities();
  console.log("\n→ Seeding demo coaches…");
  await seedCoaches(facilityMap);
  console.log("\n✓ Done. Run `pnpm run cleanup-demo-coaches` to wipe.");
  process.exit(0);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
