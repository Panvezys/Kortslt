import { Link, useLocation } from "wouter";
import { ArrowLeft } from "lucide-react";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";

type BackButtonProps = {
  label: string;
  className?: string;
} & (
  | { to: string; historyBack?: false; fallbackTo?: never }
  | { to?: never; historyBack: true; fallbackTo?: string }
);

export function BackButton({ label, className, ...rest }: BackButtonProps) {
  const [, navigate] = useLocation();

  const sharedClass = cn("mb-4 -ml-2 text-muted-foreground hover:text-foreground", className);

  if ("historyBack" in rest && rest.historyBack) {
    const fallback = rest.fallbackTo ?? "/courts";
    function handleBack() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        navigate(fallback);
      }
    }
    return (
      <Button variant="ghost" size="sm" className={sharedClass} onClick={handleBack}>
        <ArrowLeft className="mr-2 h-4 w-4" />
        {label}
      </Button>
    );
  }

  return (
    <Button asChild variant="ghost" size="sm" className={sharedClass}>
      <Link href={(rest as { to: string }).to}>
        <ArrowLeft className="mr-2 h-4 w-4" />
        {label}
      </Link>
    </Button>
  );
}
