import { chromium } from "playwright";

const browser = await chromium.launch({
  executablePath: process.env.CHROMIUM_PATH,
  headless: true,
  args: ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage", "--disable-gpu", "--lang=lt-LT"],
});
const context = await browser.newContext({
  viewport: { width: 1280, height: 1100 },
  locale: "lt-LT",
});
const page = await context.newPage();

async function probe(label) {
  // Walk the sport filter buttons in the sidebar. Active ones don't have
  // "opacity-40" in their className.
  const result = await page.evaluate(() => {
    const sidebar = document.querySelector("aside");
    if (!sidebar) return { error: "no sidebar" };
    const sportButtons = Array.from(sidebar.querySelectorAll("button"))
      .filter((b) => b.querySelector("svg") && b.textContent && b.textContent.length < 30 && !b.textContent.includes("Atstatyti"));
    const sports = sportButtons.slice(0, 12).map((b) => {
      const txt = b.textContent?.trim() ?? "";
      const active = !b.className.includes("opacity-40");
      return `${active ? "✓" : "·"} ${txt}`;
    });
    // Count visible "kortelės" (cards) on the page
    const cards = document.querySelectorAll("[data-card='coach'], .grid > article, h3");
    return { sports: sports.slice(0, 11), cardCount: cards.length };
  });
  console.log(`[${label}] sports: ${result.sports?.join(" | ")}`);
  console.log(`[${label}] cards visible: ${result.cardCount}`);
}

console.log("=== Coaches page ===");
await page.goto("http://localhost:5173/coaches", { waitUntil: "networkidle" });
await page.waitForTimeout(2500);
await probe("INITIAL");
await page.screenshot({ path: "/tmp/screenshots/coaches-sport-initial.png", fullPage: false, clip: { x: 0, y: 280, width: 320, height: 600 } });

// Find Tenisas button in sidebar and click
const clicked = await page.evaluate(() => {
  const sidebar = document.querySelector("aside");
  if (!sidebar) return false;
  const buttons = Array.from(sidebar.querySelectorAll("button"));
  const target = buttons.find((b) => (b.textContent ?? "").trim().startsWith("Tenisas"));
  if (target) { target.click(); return true; }
  return false;
});
console.log("Clicked Tenisas:", clicked);
await page.waitForTimeout(800);
await probe("AFTER 1ST TENISAS CLICK");
await page.screenshot({ path: "/tmp/screenshots/coaches-sport-after-tennis.png", fullPage: false, clip: { x: 0, y: 280, width: 320, height: 600 } });

// Click Tenisas again
await page.evaluate(() => {
  const sidebar = document.querySelector("aside");
  const target = Array.from(sidebar.querySelectorAll("button")).find((b) => (b.textContent ?? "").trim().startsWith("Tenisas"));
  if (target) target.click();
});
await page.waitForTimeout(800);
await probe("AFTER 2ND TENISAS CLICK");

console.log("\n=== Courts page ===");
await page.goto("http://localhost:5173/courts", { waitUntil: "networkidle" });
await page.waitForTimeout(2500);
await probe("INITIAL");

await page.evaluate(() => {
