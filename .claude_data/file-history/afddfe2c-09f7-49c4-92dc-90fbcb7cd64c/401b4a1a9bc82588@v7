function formatDate(dateStr: string): string {
  const d = new Date(dateStr + (dateStr.length === 10 ? "T12:00:00" : ""));
  return d.toLocaleDateString("lt-LT", { weekday: "short", month: "short", day: "numeric" });
}

function formatDateTime(iso: string) {
  const d = new Date(iso);
  return d.toLocaleString("lt-LT", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
}

function SkillBadge({ min, max, level }: { min?: number | null; max?: number | null; level?: string | null }) {
  if (level && level !== "any") {
    return (
      <span className="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-400/20">
        <Star className="w-3 h-3" />{SKILL_LABELS[level] ?? level}
      </span>
    );
  }
  if (min == null && max == null) return null;
  const label = min != null && max != null
    ? `${min.toFixed(1)}–${max.toFixed(1)}`
    : min != null ? `≥${min.toFixed(1)}`
    : `≤${max!.toFixed(1)}`;
  return (
    <span className="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-400/20">
      <Star className="w-3 h-3" />{label}
    </span>
  );
}

function SlotDots({ filled, total, full }: { filled: number; total: number; full: boolean }) {
  const visible = Math.min(total, 8);
  const filledDots = full ? visible : Math.min(Math.round((filled / Math.max(total, 1)) * visible), visible);
  return (
    <div className="flex items-center gap-[3px]">
      {Array.from({ length: visible }).map((_, i) => (
        <div
          key={i}
          className={`w-2 h-2 rounded-full transition-colors ${
            full
              ? "bg-emerald-500"
              : i < filledDots
              ? "bg-primary"
              : "bg-muted-foreground/20 border border-muted-foreground/20"
          }`}
        />
      ))}
      {total > 8 && (
        <span className="text-[10px] text-muted-foreground ml-0.5">{filled}/{total}</span>
      )}
    </div>
  );
}

