            )}
            {timeLabel && (
              <div className="flex items-center gap-1.5">
                <Clock className="w-3 h-3 shrink-0" />
                <span>{timeLabel}</span>
              </div>
            )}
            {locationLabel && (
              <div className="flex items-center gap-1.5">
                <MapPin className="w-3 h-3 shrink-0" />
