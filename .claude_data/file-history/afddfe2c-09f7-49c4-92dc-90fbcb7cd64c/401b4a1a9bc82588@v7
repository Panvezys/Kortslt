function MatchCard({ m, isOwn }: { m: FeedItem; isOwn?: boolean }) {
  const isCasual = m.kind === "casual";
  const isRated = m.matchType === "rated";
  const full = m.slotsLeft === 0;
  const [profileOpen, setProfileOpen] = useState(false);
  const [, navigate] = useLocation();
  const openProfile = useCallback((e: React.MouseEvent) => { e.preventDefault(); e.stopPropagation(); setProfileOpen(true); }, []);
  const openCourt = useCallback((e: React.MouseEvent) => { e.preventDefault(); e.stopPropagation(); navigate(`/courts/${m.courtId}`); }, [m.courtId, navigate]);

  const joined = isCasual ? (m.joinedCount ?? 0) : (m.paidSlots ?? 0);
  const total = isCasual ? (m.playersNeeded ?? 2) : (m.totalSlots ?? 1);

  // Left border accent: purple=rated, emerald=casual, blue=booked
  const accentClass = isRated
    ? "border-l-purple-500"
    : isCasual
    ? "border-l-emerald-500"
    : "border-l-blue-500";

  // Date/time strings
  let dateLabel: string | null = null;
  let timeLabel: string | null = null;
  let locationLabel: string | null = null;

  if (isCasual) {
    const d = new Date(m.datetime);
    dateLabel = d.toLocaleDateString("lt-LT", { weekday: "short", month: "2-digit", day: "2-digit" });
    const start = d.toLocaleTimeString("lt-LT", { hour: "2-digit", minute: "2-digit" });
    if (m.durationMinutes) {
      const end = new Date(d.getTime() + m.durationMinutes * 60_000)
        .toLocaleTimeString("lt-LT", { hour: "2-digit", minute: "2-digit" });
      timeLabel = `${start} – ${end} (${m.durationMinutes} min)`;
    } else {
      timeLabel = start;
    }
    locationLabel = [m.city, m.placeName].filter(Boolean).join(", ");
  } else {
    if (m.date) {
      const d = new Date(m.date + "T12:00:00");
      dateLabel = d.toLocaleDateString("lt-LT", { weekday: "short", month: "2-digit", day: "2-digit" });
    }
    if (m.startTime && m.endTime) timeLabel = `${m.startTime} – ${m.endTime}`;
    locationLabel = [m.facilityCity, m.facilityName].filter(Boolean).join(", ");
  }

  return (
    <Link href={`/matches/${m.gameId}`}>
      <div className={`group relative flex flex-col rounded-xl border border-border border-l-4 ${accentClass} bg-card hover:shadow-lg hover:bg-accent/30 transition-all cursor-pointer overflow-hidden ${full ? "opacity-70" : ""} ${isOwn ? "ring-1 ring-amber-400/40" : ""}`}>

        {/* "Mano" ribbon */}
        {isOwn && (
          <div className="absolute top-0 right-0 z-10 overflow-hidden w-14 h-14 pointer-events-none">
            <div className="absolute top-3 -right-4 rotate-45 bg-amber-500 text-white text-[8px] font-black tracking-widest px-5 py-px shadow">
              MANO
            </div>
          </div>
        )}

        <div className="p-4 flex flex-col gap-3 flex-1">

          {/* ── Row 1: badges ── */}
          <div className="flex items-center gap-1.5 flex-wrap pr-8">
            <SportPill sport={m.sport} variant="subtle" size="sm" />
            {isRated && (
              <span className="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-purple-500/15 text-purple-400 border border-purple-400/20">
                <Swords className="w-3 h-3" />Reitinginis
              </span>
            )}
            {isCasual && (
              <span className="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-400/20">
                Nemokama
              </span>
            )}
            <SkillBadge min={m.minSkillLevel} max={m.maxSkillLevel} level={m.skillLevel} />
          </div>

          {/* ── Row 2: main content ── */}
          {isCasual ? (
            <div className="flex items-start justify-between gap-2">
              <div className="min-w-0 flex-1">
                <p className="font-bold text-base leading-snug truncate group-hover:text-primary transition-colors">
                  {(SPORT_GENITIVE[m.sport] ?? (SPORT_LABELS as Record<string, string>)[m.sport] ?? m.sport) + " mačas"}
                </p>
                {m.description && (
                  <p className="text-xs text-muted-foreground mt-1 line-clamp-2">{m.description}</p>
                )}
              </div>
            </div>
          ) : (
            <div className="flex items-start justify-between gap-2">
              <div className="min-w-0 flex-1">
                <p className="font-bold text-base leading-snug truncate group-hover:text-primary transition-colors">
                  {m.facilityName || m.courtName}
                </p>
                {m.facilityName && m.courtName && (
                  <p className="text-xs text-muted-foreground truncate">{m.courtName}</p>
                )}
                {m.description && (
                  <p className="text-xs text-muted-foreground mt-0.5 line-clamp-1">{m.description}</p>
                )}
              </div>
              {m.pricePerSlot != null && (
                <div className="shrink-0 text-right">
                  <p className="text-xl font-extrabold text-primary leading-none">
                    {m.pricePerSlot.toFixed(2)}<span className="text-sm font-semibold"> €</span>
                  </p>
                  <p className="text-[10px] text-muted-foreground">/ žaid.</p>
                </div>
              )}
            </div>
          )}

          {/* ── Row 3: metadata ── */}
          <div className="space-y-1 text-xs text-muted-foreground">
            {dateLabel && (
              <div className="flex items-center gap-1.5">
                <Calendar className="w-3 h-3 shrink-0" />
                <span>{dateLabel}</span>
