import { createContext, useContext, useState, useEffect } from "react";
import type { ReactNode } from "react";
import { useAuth } from "@clerk/react";

export const SafeAuthContext = createContext<{ isLoaded: boolean; isSignedIn: boolean }>({
  isLoaded: true,
  isSignedIn: false,
});

// Dev-only E2E escape hatch. When the page sets `window.__E2E_FAKE_SIGNIN`
// to `true` before any React code runs (Playwright's addInitScript fires
// before document scripts), SafeAuthBridge reports the session as
// signed-in without actually waiting on Clerk. Used by tooling/scripts to
// drive coach + owner pages headless; AGENT_BYPASS_KEY on the backend
// supplies the actual principal so authorized API calls still resolve.
//
// Gated on import.meta.env.DEV so it tree-shakes out of production
// bundles. Reading window.__E2E_FAKE_SIGNIN in prod code is harmless even
// if the gate is somehow defeated — the flag is never written by app code.
function readE2EFakeSignin(): boolean {
  if (!import.meta.env.DEV) return false;
  if (typeof window === "undefined") return false;
  return (window as unknown as { __E2E_FAKE_SIGNIN?: boolean }).__E2E_FAKE_SIGNIN === true;
}

// Publishes Clerk auth state to SafeAuthContext.
// If Clerk hasn't loaded after 3 seconds (e.g. dev instance on replit.dev),
// treats the user as signed-out so Show/SafeShow components render normally.
export function SafeAuthBridge({ children }: { children: ReactNode }) {
  const { isLoaded, isSignedIn } = useAuth();
  const [timedOut, setTimedOut] = useState(false);
  const e2eFakeSignin = readE2EFakeSignin();

  useEffect(() => {
    if (isLoaded) return;
    const t = setTimeout(() => setTimedOut(true), 3000);
    return () => clearTimeout(t);
  }, [isLoaded]);

  const effectiveLoaded = isLoaded || timedOut || e2eFakeSignin;
  const effectiveSignedIn = e2eFakeSignin || (effectiveLoaded ? !!isSignedIn : false);

  return (
    <SafeAuthContext.Provider
      value={{ isLoaded: effectiveLoaded, isSignedIn: effectiveSignedIn }}
    >
      {children}
    </SafeAuthContext.Provider>
  );
}

export function useSafeAuth() {
  return useContext(SafeAuthContext);
}

// Drop-in replacement for Clerk's <Show> — works even when Clerk is stuck loading.
export function SafeShow({
  when,
  children,
}: {
  when: "signed-in" | "signed-out";
  children: ReactNode;
}) {
  const { isLoaded, isSignedIn } = useSafeAuth();
  if (!isLoaded) return null;
  if (when === "signed-in" && isSignedIn) return <>{children}</>;
  if (when === "signed-out" && !isSignedIn) return <>{children}</>;
  return null;
}
