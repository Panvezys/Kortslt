// GET /owner/court-reviews — review feed across all courts the signed-in
// user owns (via facility ownership). Used by the owner-dashboard reviews
// page so they can reply.
router.get("/owner/court-reviews", requireAuth, async (req, res): Promise<void> => {
  const userId = getCurrentUserId(req)!;
  // First resolve every court id owned by the signed-in user, via facility.
  const owned = await db
    .select({ id: courtsTable.id, name: courtsTable.name })
    .from(courtsTable)
    .innerJoin(facilitiesTable, eq(courtsTable.facilityId, facilitiesTable.id))
    .where(eq(facilitiesTable.ownerUserId, userId));
  if (owned.length === 0) {
    res.json({ items: [], limit: 50, offset: 0, hasMore: false });
    return;
  }
  const courtIds = owned.map((c) => c.id);
  const courtNameById = new Map(owned.map((c) => [c.id, c.name]));

  const rawLimit = Number(req.query.limit ?? 50);
  const limit = Number.isFinite(rawLimit) ? Math.min(Math.max(Math.trunc(rawLimit), 1), 100) : 50;
  const rawPage = Number(req.query.page);
  let offset: number;
  if (Number.isFinite(rawPage) && rawPage >= 1) {
    offset = (Math.trunc(rawPage) - 1) * limit;
  } else {
    const rawOffset = Number(req.query.offset ?? 0);
    offset = Number.isFinite(rawOffset) ? Math.max(Math.trunc(rawOffset), 0) : 0;
  }

  const rowsPlusOne = await db
    .select({
      id: reviewsTable.id,
      courtId: reviewsTable.courtId,
      reviewerUserId: reviewsTable.reviewerUserId,
      rating: reviewsTable.rating,
      comment: reviewsTable.comment,
      status: reviewsTable.status,
      ownerReplyText: reviewsTable.ownerReplyText,
      ownerReplyCreatedAt: reviewsTable.ownerReplyCreatedAt,
      createdAt: reviewsTable.createdAt,
    })
    .from(reviewsTable)
    .where(inArray(reviewsTable.courtId, courtIds))
    .orderBy(desc(reviewsTable.createdAt))
    .limit(limit + 1)
    .offset(offset);

  const hasMore = rowsPlusOne.length > limit;
  const rows = hasMore ? rowsPlusOne.slice(0, limit) : rowsPlusOne;

  const userIds = Array.from(new Set(rows.map((r) => r.reviewerUserId)));
  const nameByUserId = new Map<string, string>();
  if (userIds.length > 0) {
    try {
      const list = await clerkClient.users.getUserList({ userId: userIds, limit: userIds.length });
      for (const u of list.data) {
        const first = (u.firstName ?? "").trim();
        const last = (u.lastName ?? "").trim();
        const initial = last ? `${last[0]}.` : "";
        const display = [first, initial].filter(Boolean).join(" ");
        nameByUserId.set(u.id, display || "Vartotojas");
      }
    } catch {
      /* fall back */
    }
  }

  res.json({
    items: rows.map((r) => ({
      id: r.id,
      courtId: r.courtId,
      courtName: courtNameById.get(r.courtId) ?? "—",
      rating: r.rating,
      comment: r.comment ?? null,
      reviewerName: nameByUserId.get(r.reviewerUserId) ?? "Vartotojas",
      status: r.status,
      ownerReplyText: r.ownerReplyText ?? null,
      ownerReplyCreatedAt: r.ownerReplyCreatedAt ? r.ownerReplyCreatedAt.toISOString() : null,
      createdAt: r.createdAt.toISOString(),
    })),
    limit,
    offset,
    hasMore,
  });
});

/**
 * Compute "yesterday" in Europe/Vilnius local time as a YYYY-MM-DD string.
 * Mirrors the helper in coach-reviews.ts — DST-correct via Intl.
 */
function vilniusYesterdayDateStr(): string {
  const fmt = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Vilnius",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
  const todayStr = fmt.format(new Date());
  const [y, m, d] = todayStr.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d - 1));
  return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth() + 1).padStart(2, "0")}-${String(dt.getUTCDate()).padStart(2, "0")}`;
}

/**
 * Daily sweep: find court-only bookings (no coach attached) that ended
 * yesterday and aren't yet reviewed, then send the "Kaip patiko aikštelė?"
 * reminder. Bookings with a coach are skipped — those go through the coach
 * reminder so a player isn't double-pinged for a single lesson.
 */
export async function sweepCourtReviewReminders(): Promise<number> {
  const yesterdayStr = vilniusYesterdayDateStr();

  const rows = await db
    .select({
      bookingId: bookingsTable.id,
      customerName: bookingsTable.customerName,
      customerEmail: bookingsTable.customerEmail,
      date: bookingsTable.date,
      courtName: courtsTable.name,
      reviewId: reviewsTable.id,
    })
    .from(bookingsTable)
    .innerJoin(courtsTable, eq(bookingsTable.courtId, courtsTable.id))
    .leftJoin(reviewsTable, eq(reviewsTable.bookingId, bookingsTable.id))
    .where(
      and(
        eq(bookingsTable.date, yesterdayStr),
        eq(bookingsTable.status, "confirmed"),
        isNotNull(bookingsTable.bookerUserId),
        isNull(bookingsTable.coachId),
        isNull(reviewsTable.id),
      ),
    );

  if (rows.length === 0) return 0;

  let sent = 0;
  for (const r of rows) {
    try {
      await sendCourtReviewReminderEmail({
        toEmail: r.customerEmail,
        toName: r.customerName,
        courtName: r.courtName,
        bookingDate: r.date,
        bookingId: r.bookingId,
      });
      sent++;
    } catch (err) {
      logger.error({ err, bookingId: r.bookingId }, "court review reminder failed");
    }
  }
  return sent;
}

